{
  "name": "@vitehub/devtools",
  "version": "0.0.0",
  "description": "Private ViteHub DevTools integration contract and hosted shell helpers.",
  "author": "onmax <maximogarciamtnez@gmail.com>",
  "license": "Apache-2.0",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./chat-shared": "./src/chat-shared.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "pnpm build:code",
    "build:chat": "nuxi generate devtools/chat",
    "build:code": "tsdown --tsconfig tsconfig.json",
    "dev:chat": "nuxi dev devtools/chat --port 3300",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p ./tsconfig.json"
  },
  "dependencies": {
    "@vitejs/devtools-kit": "catalog:",
    "pathe": "catalog:"
  },
  "devDependencies": {
    "@comark/vue": "catalog:",
    "@iconify-json/lucide": "catalog:",
    "@nuxt/ui": "^4.6.1",
    "@types/node": "catalog:",
    "nuxt": "catalog:",
    "tailwindcss": "^4.1.18",
    "tsdown": "^0.21.8",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "vue-tsc": "catalog:"
  }
}
