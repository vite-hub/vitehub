{
  "name": "@vitehub/devtools",
  "version": "0.0.0",
  "description": "ViteHub DevTools integration contract and hosted shell helpers.",
  "author": "onmax <maximogarciamtnez@gmail.com>",
  "license": "Apache-2.0",
  "homepage": "https://github.com/vite-hub/vitehub#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vite-hub/vitehub.git",
    "directory": "packages/devtools"
  },
  "bugs": "https://github.com/vite-hub/vitehub/issues",
  "keywords": [
    "vitehub",
    "vite",
    "devtools"
  ],
  "sideEffects": false,
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./chat-shared": "./dist/chat-shared.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "package.json"
  ],
  "scripts": {
    "build": "pnpm build:code",
    "build:chat": "nuxi generate devtools/chat",
    "build:code": "tsdown --tsconfig tsconfig.json",
    "dev:chat": "nuxi dev devtools/chat --port 3300",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p ./tsconfig.json"
  },
  "dependencies": {
    "pathe": "catalog:"
  },
  "peerDependencies": {
    "@vitejs/devtools-kit": ">=0.1.19"
  },
  "devDependencies": {
    "@comark/vue": "catalog:",
    "@iconify-json/lucide": "catalog:",
    "@nuxt/ui": "^4.6.1",
    "@types/node": "catalog:",
    "@vitejs/devtools-kit": "catalog:",
    "nuxt": "catalog:",
    "tailwindcss": "^4.1.18",
    "tsdown": "^0.21.8",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vue-tsc": "catalog:"
  }
}
