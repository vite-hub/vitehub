{
  "name": "@vite-hub/workspace",
  "version": "0.1.0",
  "description": "Agent-oriented filesystem state and Vite integration for ViteHub.",
  "keywords": [
    "ai-agents",
    "cloudflare",
    "filesystem",
    "nuxt",
    "typescript",
    "vercel",
    "vite",
    "vitehub",
    "workspace"
  ],
  "homepage": "https://vitehub.dev",
  "bugs": "https://github.com/vite-hub/vitehub/issues",
  "license": "Apache-2.0",
  "author": "onmax <maximogarciamtnez@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vite-hub/vitehub.git",
    "directory": "packages/workspace"
  },
  "files": [
    "dist",
    "package.json"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "imports": {
    "#vitehub-workspace-assets-registry": {
      "types": "./dist/runtime/empty-assets-registry.d.ts",
      "default": "./dist/runtime/empty-assets-registry.js"
    },
    "#vitehub-workspace-registry": {
      "types": "./dist/runtime/empty-registry.d.ts",
      "default": "./dist/runtime/empty-registry.js"
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./blob-database": {
      "types": "./dist/blob-database.d.ts",
      "import": "./dist/blob-database.js",
      "default": "./dist/blob-database.js"
    },
    "./checkout": {
      "types": "./dist/checkout.d.ts",
      "import": "./dist/checkout.js",
      "default": "./dist/checkout.js"
    },
    "./cloudflare": {
      "types": "./dist/cloudflare.d.ts",
      "import": "./dist/cloudflare.js",
      "default": "./dist/cloudflare.js"
    },
    "./files": {
      "types": "./dist/files.d.ts",
      "import": "./dist/files.js",
      "default": "./dist/files.js"
    },
    "./internal/path": {
      "types": "./dist/internal/path.d.ts",
      "import": "./dist/internal/path.js",
      "default": "./dist/internal/path.js"
    },
    "./lineage": {
      "types": "./dist/lineage.d.ts",
      "import": "./dist/lineage.js",
      "default": "./dist/lineage.js"
    },
    "./loader": {
      "types": "./dist/loader.d.ts",
      "import": "./dist/loader.js",
      "default": "./dist/loader.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js",
      "default": "./dist/runtime.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "default": "./dist/server.js"
    },
    "./source-metadata": {
      "types": "./dist/source-metadata.d.ts",
      "import": "./dist/source-metadata.js",
      "default": "./dist/source-metadata.js"
    },
    "./test": {
      "types": "./dist/test.d.ts",
      "import": "./dist/test.js",
      "default": "./dist/test.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js",
      "default": "./dist/vite.js"
    },
    "./package.json": "./package.json",
    "./internal/runtime/assets": {
      "types": "./dist/runtime/assets.d.ts",
      "import": "./dist/runtime/assets.js",
      "default": "./dist/runtime/assets.js"
    },
    "./internal/runtime/hosted": {
      "types": "./dist/hosted.d.ts",
      "import": "./dist/hosted.js",
      "default": "./dist/hosted.js"
    },
    "./internal/runtime/hosted-vercel-blob": {
      "types": "./dist/hosted-vercel-blob.d.ts",
      "import": "./dist/hosted-vercel-blob.js",
      "default": "./dist/hosted-vercel-blob.js"
    },
    "./internal/runtime/workspace": {
      "types": "./dist/runtime/workspace.d.ts",
      "import": "./dist/runtime/workspace.js",
      "default": "./dist/runtime/workspace.js"
    },
    "./internal/stores/github": {
      "types": "./dist/providers/github/store.d.ts",
      "import": "./dist/providers/github/store.js",
      "default": "./dist/providers/github/store.js"
    }
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "typecheck": "vp run --cache -t @vite-hub/workspace#build && node ../../test/package-typecheck.mjs --noEmit -p ./tsconfig.json",
    "test": "vp run --cache -t @vite-hub/workspace#build && vp test"
  },
  "dependencies": {
    "@valibot/to-json-schema": "catalog:runtime",
    "@vercel/nft": "catalog:vercel",
    "@vite-hub/forge": "workspace:*",
    "@vite-hub/runtime": "workspace:*",
    "@vite-hub/source": "workspace:*",
    "birpc": "catalog:runtime",
    "defu": "catalog:unjs",
    "esbuild": "catalog:tooling",
    "exsolve": "catalog:unjs",
    "isomorphic-git": "catalog:workspace",
    "jiti": "catalog:unjs",
    "minimatch": "catalog:workspace",
    "mrmime": "catalog:workspace",
    "nostics": "catalog:runtime",
    "ofetch": "catalog:unjs",
    "valibot": "catalog:runtime",
    "yaml": "catalog:tooling",
    "@vite-hub/markdown-template": "workspace:*",
    "@vite-hub/blob": "workspace:*",
    "@vite-hub/database": "workspace:*",
    "@vite-hub/sandbox": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:tooling",
    "@vercel/blob": "catalog:storage",
    "@vite-hub/env": "workspace:*",
    "@vite-hub/internal": "workspace:*",
    "@vite-hub/shell": "workspace:*",
    "ai": "catalog:ai",
    "publint": "catalog:tooling",
    "typescript": "catalog:tooling",
    "vite": "catalog:vite",
    "vite-plus": "catalog:tooling",
    "vitest": "catalog:tooling",
    "drizzle-orm": "catalog:database",
    "miniflare": "4.20260730.0",
    "@libsql/client": "catalog:database"
  },
  "peerDependencies": {
    "@vite-hub/shell": "workspace:*",
    "ai": "catalog:ai-compat",
    "vite": "catalog:vite-compat",
    "drizzle-orm": ">=1.0.0-rc.5 <2.0.0"
  },
  "peerDependenciesMeta": {
    "@vite-hub/shell": {
      "optional": true
    },
    "vite": {
      "optional": true
    },
    "drizzle-orm": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
