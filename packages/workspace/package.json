{
  "name": "@vite-hub/workspace",
  "version": "0.0.1",
  "description": "Agent-oriented filesystem state and Vite integration for ViteHub.",
  "keywords": [
    "cloudflare",
    "vercel",
    "vite",
    "vitehub",
    "workspace"
  ],
  "homepage": "https://github.com/vite-hub/vitehub#readme",
  "bugs": "https://github.com/vite-hub/vitehub/issues",
  "license": "Apache-2.0",
  "author": "onmax <maximogarciamtnez@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vite-hub/vitehub.git",
    "directory": "packages/workspace"
  },
  "files": [
    "dist",
    "package.json"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "imports": {
    "#vitehub-workspace-assets-registry": {
      "types": "./dist/runtime/empty-assets-registry.d.ts",
      "default": "./dist/runtime/empty-assets-registry.js"
    },
    "#vitehub-workspace-registry": {
      "types": "./dist/runtime/empty-registry.d.ts",
      "default": "./dist/runtime/empty-registry.js"
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./ai": {
      "types": "./dist/ai.d.ts",
      "import": "./dist/ai.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js"
    },
    "./cloudflare": {
      "types": "./dist/cloudflare.d.ts",
      "import": "./dist/cloudflare.js"
    },
    "./loader": {
      "types": "./dist/loader.d.ts",
      "import": "./dist/loader.js"
    },
    "./nitro": {
      "types": "./dist/nitro.d.ts",
      "import": "./dist/nitro.js"
    },
    "./nuxt": {
      "types": "./dist/nuxt.d.ts",
      "import": "./dist/nuxt.js"
    },
    "./publish": {
      "types": "./dist/publish.d.ts",
      "import": "./dist/publish.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./test": {
      "types": "./dist/test.d.ts",
      "import": "./dist/test.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    },
    "./package.json": "./package.json",
    "./internal/runtime/assets": {
      "types": "./dist/runtime/assets.d.ts",
      "import": "./dist/runtime/assets.js"
    },
    "./internal/runtime/empty-assets-registry": {
      "types": "./dist/runtime/empty-assets-registry.d.ts",
      "import": "./dist/runtime/empty-assets-registry.js"
    },
    "./internal/runtime/empty-registry": {
      "types": "./dist/runtime/empty-registry.d.ts",
      "import": "./dist/runtime/empty-registry.js"
    },
    "./internal/runtime/hosted": {
      "types": "./dist/hosted.d.ts",
      "import": "./dist/hosted.js"
    },
    "./internal/runtime/state": {
      "types": "./dist/runtime/state.d.ts",
      "import": "./dist/runtime/state.js"
    },
    "./internal/stores/cloudflare-artifacts": {
      "types": "./dist/providers/cloudflare/artifacts-store.d.ts",
      "import": "./dist/providers/cloudflare/artifacts-store.js"
    },
    "./internal/stores/github": {
      "types": "./dist/providers/github/store.d.ts",
      "import": "./dist/providers/github/store.js"
    },
    "./internal/stores/vercel-blob": {
      "types": "./dist/providers/vercel/blob-store.d.ts",
      "import": "./dist/providers/vercel/blob-store.js"
    }
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "typecheck": "tsc --noEmit -p ./tsconfig.json",
    "test": "vp run -t @vite-hub/workspace#build && vp test"
  },
  "dependencies": {
    "@vercel/nft": "catalog:vercel",
    "@vite-hub/source": "workspace:*",
    "defu": "catalog:unjs",
    "exsolve": "catalog:unjs",
    "files-sdk": "catalog:storage",
    "h3": "catalog:unjs",
    "isomorphic-git": "catalog:workspace",
    "jiti": "catalog:unjs",
    "minimatch": "catalog:workspace",
    "mrmime": "catalog:workspace"
  },
  "devDependencies": {
    "@types/node": "catalog:tooling",
    "@vite-hub/env": "workspace:*",
    "@vite-hub/internal": "workspace:*",
    "@vite-hub/sandbox": "workspace:*",
    "@vite-hub/shell": "workspace:*",
    "ai": "catalog:ai",
    "ocache": "catalog:unjs",
    "ofetch": "catalog:unjs",
    "publint": "catalog:tooling",
    "typescript": "catalog:tooling",
    "vite": "catalog:vite",
    "vite-plus": "catalog:tooling",
    "vitest": "catalog:tooling"
  },
  "peerDependencies": {
    "ai": "catalog:ai-compat",
    "vite": "catalog:vite-compat"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
