{
  "name": "@vite-hub/workspace",
  "version": "0.0.1",
  "description": "Agent-oriented filesystem state and Vite integration for ViteHub.",
  "keywords": [
    "cloudflare",
    "vercel",
    "vite",
    "vitehub",
    "workspace"
  ],
  "homepage": "https://github.com/vite-hub/vitehub#readme",
  "bugs": "https://github.com/vite-hub/vitehub/issues",
  "license": "Apache-2.0",
  "author": "onmax <maximogarciamtnez@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vite-hub/vitehub.git",
    "directory": "packages/workspace"
  },
  "files": [
    "dist",
    "package.json"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "imports": {
    "#vitehub-workspace-assets-registry": {
      "types": "./dist/runtime/empty-assets-registry.d.ts",
      "default": "./dist/runtime/empty-assets-registry.js"
    },
    "#vitehub-workspace-registry": {
      "types": "./dist/runtime/empty-registry.d.ts",
      "default": "./dist/runtime/empty-registry.js"
    }
  },
  "exports": {
    ".": "./dist/index.js",
    "./ai": "./dist/ai.js",
    "./cloudflare": "./dist/cloudflare.js",
    "./loader": "./dist/loader.js",
    "./publish": "./dist/publish.js",
    "./runtime": "./dist/runtime.js",
    "./server": "./dist/server.js",
    "./test": "./dist/test.js",
    "./vite": "./dist/vite.js",
    "./package.json": "./package.json",
    "./internal/runtime/assets": "./dist/runtime/assets.js",
    "./internal/runtime/empty-assets-registry": "./dist/runtime/empty-assets-registry.js",
    "./internal/runtime/empty-registry": "./dist/runtime/empty-registry.js",
    "./internal/runtime/state": "./dist/runtime/state.js",
    "./internal/stores/cloudflare-artifacts": "./dist/providers/cloudflare/artifacts-store.js",
    "./internal/stores/github": "./dist/providers/github/store.js",
    "./internal/stores/vercel-blob": "./dist/providers/vercel/blob-store.js"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "typecheck": "tsc --noEmit -p ./tsconfig.json",
    "test": "vp run -t @vite-hub/workspace#build && vp test"
  },
  "dependencies": {
    "@vercel/nft": "catalog:vercel",
    "@vite-hub/source": "workspace:*",
    "defu": "catalog:unjs",
    "exsolve": "catalog:unjs",
    "isomorphic-git": "catalog:workspace",
    "jiti": "catalog:unjs",
    "minimatch": "catalog:workspace",
    "mrmime": "catalog:workspace"
  },
  "devDependencies": {
    "@types/node": "catalog:tooling",
    "@vite-hub/internal": "workspace:*",
    "@vite-hub/sandbox": "workspace:*",
    "@vite-hub/shell": "workspace:*",
    "ai": "catalog:ai",
    "files-sdk": "catalog:storage",
    "h3": "catalog:unjs",
    "ocache": "catalog:unjs",
    "ofetch": "catalog:unjs",
    "publint": "catalog:tooling",
    "typescript": "catalog:tooling",
    "vite": "catalog:vite",
    "vite-plus": "catalog:tooling",
    "vitest": "catalog:tooling"
  },
  "peerDependencies": {
    "@vite-hub/sandbox": "workspace:*",
    "@vite-hub/shell": "workspace:*",
    "ai": "catalog:ai-compat",
    "files-sdk": "catalog:storage",
    "h3": "catalog:unjs",
    "vite": "catalog:vite-compat"
  },
  "peerDependenciesMeta": {
    "@vite-hub/sandbox": {
      "optional": true
    },
    "@vite-hub/shell": {
      "optional": true
    },
    "files-sdk": {
      "optional": true
    },
    "h3": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
