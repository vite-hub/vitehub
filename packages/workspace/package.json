{
  "name": "@vitehub/workspace",
  "version": "0.0.0",
  "description": "Agent-oriented filesystem state and Vite/Nitro integration for ViteHub.",
  "author": "onmax <maximogarciamtnez@gmail.com>",
  "license": "Apache-2.0",
  "homepage": "https://github.com/vite-hub/vitehub#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vite-hub/vitehub.git",
    "directory": "packages/workspace"
  },
  "bugs": "https://github.com/vite-hub/vitehub/issues",
  "keywords": [
    "vitehub",
    "vite",
    "nitro",
    "workspace",
    "cloudflare",
    "vercel"
  ],
  "sideEffects": false,
  "type": "module",
  "types": "./dist/index.d.ts",
  "imports": {
    "#vitehub-workspace-assets-registry": {
      "types": "./dist/runtime/empty-assets-registry.d.ts",
      "default": "./dist/runtime/empty-assets-registry.js"
    },
    "#vitehub-workspace-registry": {
      "types": "./dist/runtime/empty-registry.d.ts",
      "default": "./dist/runtime/empty-registry.js"
    }
  },
  "exports": {
    ".": "./dist/index.js",
    "./ai": "./dist/ai.js",
    "./nitro": "./dist/nitro.js",
    "./runtime/assets": "./dist/runtime/assets.js",
    "./runtime/empty-assets-registry": "./dist/runtime/empty-assets-registry.js",
    "./runtime/empty-registry": "./dist/runtime/empty-registry.js",
    "./runtime/nitro-plugin": "./dist/runtime/nitro-plugin.js",
    "./runtime/state": "./dist/runtime/state.js",
    "./source": "./dist/source.js",
    "./stores/cloudflare-artifacts": "./dist/stores/cloudflare-artifacts.js",
    "./stores/vercel-blob": "./dist/stores/vercel-blob.js",
    "./vite": "./dist/vite.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "package.json"
  ],
  "scripts": {
    "build": "tsdown --tsconfig tsconfig.build.json",
    "dev": "tsdown --watch",
    "test:e2e": "tsx ./test/e2e.ts",
    "typecheck": "tsc --noEmit -p ./tsconfig.json",
    "test": "pnpm --filter @vitehub/workspace... build && vitest run"
  },
  "dependencies": {
    "@vitehub/unsource": "workspace:*",
    "defu": "^6.1.4",
    "exsolve": "^1.0.8",
    "isomorphic-git": "^1.37.6",
    "jiti": "^2.6.1",
    "minimatch": "^10.1.1"
  },
  "peerDependencies": {
    "@vitehub/sandbox": "workspace:*",
    "@vercel/blob": "^2.3.3",
    "ai": "^6.0.0",
    "nitro": "^3.0.0-0",
    "vite": ">=8.0.0"
  },
  "peerDependenciesMeta": {
    "@vitehub/sandbox": {
      "optional": true
    },
    "@vercel/blob": {
      "optional": true
    },
    "nitro": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@vercel/blob": "^2.3.3",
    "@vitehub/internal": "workspace:*",
    "@vitehub/sandbox": "workspace:*",
    "@vitehub/unshell": "workspace:*",
    "ai": "^6.0.172",
    "nitro": "3.0.260311-beta",
    "ocache": "^0.1.4",
    "ofetch": "^1.5.1",
    "publint": "^0.3.15",
    "tsdown": "^0.21.8",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.8",
    "vitest": "^4.1.4"
  }
}
