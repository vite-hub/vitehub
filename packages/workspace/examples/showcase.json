{
  "label": "Workspace",
  "docsPath": "workspace",
  "icon": "i-lucide-folder-git-2",
  "order": 4,
  "defaultPhase": "define",
  "providers": [
    {
      "id": "cloudflare-artifacts",
      "label": "Cloudflare",
      "icon": "i-simple-icons-cloudflare",
      "configOverride": "  workspace: {\n    store: {\n      provider: 'cloudflare-artifacts',\n      binding: 'WORKSPACE_ARTIFACTS',\n      namespace: 'vitehub',\n    },\n  },"
    },
    {
      "id": "vercel-runtime",
      "label": "Vercel",
      "icon": "i-simple-icons-vercel",
      "darkInvert": true,
      "configOverride": "  workspace: {},"
    }
  ],
  "frameworks": {
    "vite": {
      "modes": {
        "dev": {
          "phases": {
            "configure": "vite.config.ts",
            "define": "src/docs.workspace.ts",
            "run": "src/server.ts"
          },
          "supplementalFiles": [
            "package.json"
          ]
        },
        "build": {
          "phases": {
            "configure": "vite.config.ts",
            "define": "src/docs.workspace.ts",
            "run": "src/server.ts"
          },
          "supplementalFiles": [
            "package.json"
          ]
        }
      }
    }
  }
}
