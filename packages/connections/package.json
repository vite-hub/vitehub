{
  "name": "@vite-hub/connections",
  "version": "0.1.0",
  "description": "Provider OAuth and API key connections with typed, governed, and audited calls for ViteHub.",
  "keywords": [
    "connections",
    "oauth",
    "api-key",
    "gmail",
    "vite",
    "vitehub"
  ],
  "homepage": "https://github.com/vite-hub/vitehub#readme",
  "bugs": "https://github.com/vite-hub/vitehub/issues",
  "license": "Apache-2.0",
  "author": "onmax <maximogarciamtnez@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vite-hub/vitehub.git",
    "directory": "packages/connections"
  },
  "files": [
    "dist",
    "package.json"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "imports": {
    "#vitehub/connections/registry": {
      "types": "./dist/runtime/empty-registry.d.ts",
      "default": "./dist/runtime/empty-registry.js"
    }
  },
  "exports": {
    ".": "./dist/index.js",
    "./agent": "./dist/agent.js",
    "./google": "./dist/google.js",
    "./http": "./dist/http.js",
    "./server": "./dist/server.js",
    "./vite": "./dist/vite.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "generate": "node scripts/generate-google.ts gmail v1",
    "typecheck": "tsc --noEmit -p ./tsconfig.json",
    "test": "vp run -t vite-hub#build && vp run -t @vite-hub/connections#build && vp test"
  },
  "dependencies": {
    "@vite-hub/env": "workspace:*",
    "@vite-hub/runtime": "workspace:*",
    "nostics": "catalog:runtime",
    "pathe": "catalog:unjs",
    "valibot": "catalog:runtime"
  },
  "devDependencies": {
    "@libsql/client": "catalog:database",
    "@types/node": "catalog:tooling",
    "@vite-hub/internal": "workspace:*",
    "drizzle-orm": "catalog:database",
    "miniflare": "4.20260730.0",
    "publint": "catalog:tooling",
    "typescript": "catalog:tooling",
    "vite": "catalog:vite",
    "vite-plus": "catalog:tooling",
    "vitest": "catalog:tooling"
  },
  "peerDependencies": {
    "drizzle-orm": "catalog:database",
    "vite": "catalog:vite-compat"
  },
  "peerDependenciesMeta": {
    "drizzle-orm": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
