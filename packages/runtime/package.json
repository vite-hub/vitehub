{
  "name": "@vite-hub/runtime",
  "version": "0.1.0",
  "description": "Shared runtime context, capability, policy, approval, and tracing primitives for ViteHub.",
  "keywords": [
    "approvals",
    "capabilities",
    "policy",
    "runtime",
    "typescript",
    "vitehub"
  ],
  "homepage": "https://vitehub.dev",
  "bugs": "https://github.com/vite-hub/vitehub/issues",
  "license": "Apache-2.0",
  "author": "onmax <maximogarciamtnez@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vite-hub/vitehub.git",
    "directory": "packages/runtime"
  },
  "files": [
    "dist",
    "package.json"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./durability": {
      "types": "./dist/durability.d.ts",
      "import": "./dist/durability.js",
      "default": "./dist/durability.js"
    },
    "./internal/drain": {
      "types": "./dist/internal/drain.d.ts",
      "import": "./dist/internal/drain.js",
      "default": "./dist/internal/drain.js"
    },
    "./internal/execution-budget": {
      "types": "./dist/internal/execution-budget.d.ts",
      "import": "./dist/internal/execution-budget.js",
      "default": "./dist/internal/execution-budget.js"
    },
    "./internal/grant": {
      "types": "./dist/internal/grant.d.ts",
      "import": "./dist/internal/grant.js",
      "default": "./dist/internal/grant.js"
    },
    "./internal/h3": {
      "types": "./dist/internal/h3.d.ts",
      "import": "./dist/internal/h3.js",
      "default": "./dist/internal/h3.js"
    },
    "./internal/node": {
      "types": "./dist/internal/node.d.ts",
      "import": "./dist/internal/node.js",
      "default": "./dist/internal/node.js"
    },
    "./internal/public-url": {
      "types": "./dist/internal/public-url.d.ts",
      "import": "./dist/internal/public-url.js",
      "default": "./dist/internal/public-url.js"
    },
    "./internal/runtime-type": {
      "types": "./dist/internal/runtime-type.d.ts",
      "import": "./dist/internal/runtime-type.js",
      "default": "./dist/internal/runtime-type.js"
    },
    "./internal/shutdown": {
      "types": "./dist/internal/shutdown.d.ts",
      "import": "./dist/internal/shutdown.js",
      "default": "./dist/internal/shutdown.js"
    },
    "./internal/test-mode": {
      "types": "./dist/internal/test-mode.d.ts",
      "import": "./dist/internal/test-mode.js",
      "default": "./dist/internal/test-mode.js"
    },
    "./internal/test-mode-setup": {
      "types": "./dist/internal/test-mode-setup.d.ts",
      "import": "./dist/internal/test-mode-setup.js",
      "default": "./dist/internal/test-mode-setup.js"
    },
    "./operations": {
      "types": "./dist/operations.d.ts",
      "import": "./dist/operations.js",
      "default": "./dist/operations.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "typecheck": "vp run --cache -t @vite-hub/runtime#build && node ../../test/package-typecheck.mjs --noEmit -p ./tsconfig.json",
    "test": "vp run --cache -t @vite-hub/runtime#build && vp test"
  },
  "dependencies": {
    "@standard-schema/spec": "catalog:runtime",
    "@valibot/to-json-schema": "catalog:runtime",
    "h3": "catalog:unjs",
    "nostics": "catalog:runtime",
    "standard-context": "catalog:runtime",
    "valibot": "catalog:runtime"
  },
  "devDependencies": {
    "@libsql/client": "catalog:database",
    "@types/node": "catalog:tooling",
    "@vite-hub/internal": "workspace:*",
    "postgres": "catalog:database",
    "publint": "catalog:tooling",
    "typescript": "catalog:tooling",
    "vite-plus": "catalog:tooling",
    "vitest": "catalog:tooling"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
