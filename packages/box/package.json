{
  "name": "@vite-hub/box",
  "version": "0.0.1",
  "description": "Portable execution environments for ViteHub agents.",
  "keywords": [
    "agent",
    "runtime",
    "vitehub"
  ],
  "homepage": "https://github.com/vite-hub/vitehub#readme",
  "bugs": "https://github.com/vite-hub/vitehub/issues",
  "license": "Apache-2.0",
  "author": "onmax <maximogarciamtnez@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vite-hub/vitehub.git",
    "directory": "packages/box"
  },
  "files": [
    "dist",
    "package.json"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./_internal/cloudflare": "./dist/internal/cloudflare.js",
    "./_internal/vercel": "./dist/internal/vercel.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "typecheck": "tsc --noEmit -p ./tsconfig.json",
    "test": "vp run -t @vite-hub/box#build && vp test"
  },
  "dependencies": {
    "@vite-hub/runtime": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/sandbox": "catalog:sandbox",
    "@types/node": "catalog:tooling",
    "@vercel/sandbox": "catalog:sandbox",
    "publint": "catalog:tooling",
    "typescript": "catalog:tooling",
    "vite-plus": "catalog:tooling",
    "vitest": "catalog:tooling"
  },
  "peerDependencies": {
    "@cloudflare/sandbox": "catalog:sandbox",
    "@vercel/sandbox": "catalog:sandbox"
  },
  "peerDependenciesMeta": {
    "@cloudflare/sandbox": {
      "optional": true
    },
    "@vercel/sandbox": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
