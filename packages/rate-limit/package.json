{
  "name": "@vite-hub/rate-limit",
  "version": "0.0.4",
  "description": "Provider-neutral Rate Limit primitives and Vite deployment integration for ViteHub.",
  "keywords": [
    "cloudflare",
    "h3",
    "rate-limit",
    "vite",
    "vitehub"
  ],
  "homepage": "https://github.com/vite-hub/vitehub#readme",
  "bugs": "https://github.com/vite-hub/vitehub/issues",
  "license": "Apache-2.0",
  "author": "onmax <maximogarciamtnez@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vite-hub/vitehub.git",
    "directory": "packages/rate-limit"
  },
  "files": [
    "dist",
    "package.json"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js",
      "require": "./dist/cli.js",
      "default": "./dist/cli.js"
    },
    "./drivers/cloudflare": {
      "types": "./dist/drivers/cloudflare.d.ts",
      "import": "./dist/drivers/cloudflare.js",
      "require": "./dist/drivers/cloudflare.js",
      "default": "./dist/drivers/cloudflare.js"
    },
    "./drivers/memory": {
      "types": "./dist/drivers/memory.d.ts",
      "import": "./dist/drivers/memory.js",
      "require": "./dist/drivers/memory.js",
      "default": "./dist/drivers/memory.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js",
      "require": "./dist/runtime.js",
      "default": "./dist/runtime.js"
    },
    "./runtime/console": {
      "types": "./dist/runtime/console.d.ts",
      "import": "./dist/runtime/console.js",
      "require": "./dist/runtime/console.js",
      "default": "./dist/runtime/console.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js",
      "require": "./dist/vite.js",
      "default": "./dist/vite.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "typecheck": "tsc --noEmit -p ./tsconfig.json",
    "test": "vp run -t @vite-hub/rate-limit#build && vp test"
  },
  "dependencies": {
    "h3": "catalog:unjs",
    "nostics": "catalog:runtime",
    "valibot": "catalog:runtime"
  },
  "devDependencies": {
    "@types/node": "catalog:tooling",
    "@vite-hub/internal": "workspace:*",
    "publint": "catalog:tooling",
    "typescript": "catalog:tooling",
    "vite": "catalog:vite",
    "vite-plus": "catalog:tooling",
    "vitest": "catalog:tooling"
  },
  "peerDependencies": {
    "vite": "catalog:vite-compat"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
