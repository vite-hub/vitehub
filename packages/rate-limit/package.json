{
  "name": "@vite-hub/rate-limit",
  "version": "0.1.0",
  "description": "Provider-neutral Rate Limit primitives and Vite deployment integration for ViteHub.",
  "keywords": [
    "cloudflare",
    "h3",
    "rate-limit",
    "rate-limiting",
    "typescript",
    "vite",
    "vitehub"
  ],
  "homepage": "https://vitehub.dev",
  "bugs": "https://github.com/vite-hub/vitehub/issues",
  "license": "Apache-2.0",
  "author": "onmax <maximogarciamtnez@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vite-hub/vitehub.git",
    "directory": "packages/rate-limit"
  },
  "files": [
    "dist",
    "package.json"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./drivers/cloudflare": {
      "types": "./dist/drivers/cloudflare.d.ts",
      "import": "./dist/drivers/cloudflare.js",
      "default": "./dist/drivers/cloudflare.js"
    },
    "./drivers/kv": {
      "types": "./dist/drivers/kv.d.ts",
      "import": "./dist/drivers/kv.js",
      "default": "./dist/drivers/kv.js"
    },
    "./drivers/memory": {
      "types": "./dist/drivers/memory.d.ts",
      "import": "./dist/drivers/memory.js",
      "default": "./dist/drivers/memory.js"
    },
    "./durability": {
      "types": "./dist/durability.d.ts",
      "import": "./dist/durability.js",
      "default": "./dist/durability.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js",
      "default": "./dist/runtime.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js",
      "default": "./dist/vite.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "typecheck": "vp run --cache -t @vite-hub/rate-limit#build && node ../../test/package-typecheck.mjs --noEmit -p ./tsconfig.json",
    "test": "vp run --cache -t @vite-hub/rate-limit#build && vp test"
  },
  "dependencies": {
    "@valibot/to-json-schema": "catalog:runtime",
    "@vite-hub/runtime": "workspace:*",
    "birpc": "catalog:runtime",
    "h3": "catalog:unjs",
    "nostics": "catalog:runtime",
    "valibot": "catalog:runtime"
  },
  "devDependencies": {
    "@types/node": "catalog:tooling",
    "@vite-hub/internal": "workspace:*",
    "publint": "catalog:tooling",
    "typescript": "catalog:tooling",
    "vite": "catalog:vite",
    "vite-plus": "catalog:tooling",
    "vitest": "catalog:tooling"
  },
  "peerDependencies": {
    "vite": "catalog:vite-compat"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
