{
  "name": "@vite-hub/comments",
  "version": "0.0.4",
  "description": "Figma-style comments for your own running app: anchors, a client, and the types that the server and the UI share.",
  "keywords": [
    "anchors",
    "comments",
    "review",
    "vitehub"
  ],
  "homepage": "https://vitehub.dev/docs/ui/comments",
  "bugs": "https://github.com/vite-hub/vitehub/issues",
  "license": "Apache-2.0",
  "author": "onmax <maximogarciamtnez@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vite-hub/vitehub.git",
    "directory": "packages/comments"
  },
  "files": [
    "dist",
    "package.json"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "require": "./dist/client.js",
      "default": "./dist/client.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "typecheck": "vp run --cache -t @vite-hub/comments#build && tsc --noEmit -p ./tsconfig.json",
    "test": "vp run -t @vite-hub/comments#build && vp test"
  },
  "dependencies": {
    "nostics": "catalog:runtime"
  },
  "devDependencies": {
    "@types/node": "catalog:tooling",
    "@vite-hub/internal": "workspace:*",
    "happy-dom": "21.0.3",
    "publint": "catalog:tooling",
    "typescript": "catalog:tooling",
    "vite-plus": "catalog:tooling",
    "vitest": "catalog:tooling"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
