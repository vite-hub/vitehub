{
  "name": "@vite-hub/comments",
  "version": "0.0.4",
  "description": "Figma-style comments for your own running app: anchors, a client, the server tables and operations, and the types that they share.",
  "keywords": [
    "anchors",
    "comments",
    "review",
    "vitehub"
  ],
  "homepage": "https://vitehub.dev/docs/ui/comments",
  "bugs": "https://github.com/vite-hub/vitehub/issues",
  "license": "Apache-2.0",
  "author": "onmax <maximogarciamtnez@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vite-hub/vitehub.git",
    "directory": "packages/comments"
  },
  "files": [
    "dist",
    "package.json"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "require": "./dist/client.js",
      "default": "./dist/client.js"
    },
    "./database": {
      "types": "./dist/database.d.ts",
      "import": "./dist/database.js",
      "require": "./dist/database.js",
      "default": "./dist/database.js"
    },
    "./database/postgres": {
      "types": "./dist/database/postgres.d.ts",
      "import": "./dist/database/postgres.js",
      "require": "./dist/database/postgres.js",
      "default": "./dist/database/postgres.js"
    },
    "./operations": {
      "types": "./dist/operations.d.ts",
      "import": "./dist/operations.js",
      "require": "./dist/operations.js",
      "default": "./dist/operations.js"
    },
    "./rpc": {
      "types": "./dist/rpc.d.ts",
      "import": "./dist/rpc.js",
      "require": "./dist/rpc.js",
      "default": "./dist/rpc.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "require": "./dist/server.js",
      "default": "./dist/server.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "require": "./dist/testing.js",
      "default": "./dist/testing.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js",
      "require": "./dist/vite.js",
      "default": "./dist/vite.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "typecheck": "vp run --cache -t @vite-hub/comments#build && tsc --noEmit -p ./tsconfig.json",
    "test": "vp run -t @vite-hub/comments#build && vp test"
  },
  "dependencies": {
    "@standard-schema/spec": "catalog:runtime",
    "@valibot/to-json-schema": "catalog:runtime",
    "nostics": "catalog:runtime",
    "valibot": "catalog:runtime"
  },
  "devDependencies": {
    "@libsql/client": "catalog:database",
    "@types/node": "catalog:tooling",
    "@vite-hub/database": "workspace:*",
    "@vite-hub/internal": "workspace:*",
    "drizzle-orm": "catalog:database",
    "happy-dom": "21.0.3",
    "publint": "catalog:tooling",
    "typescript": "catalog:tooling",
    "vite": "catalog:vite",
    "vite-plus": "catalog:tooling",
    "vitest": "catalog:tooling"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "peerDependencies": {
    "@vite-hub/database": "workspace:*",
    "drizzle-orm": "catalog:database",
    "vite": "catalog:vite-compat"
  },
  "peerDependenciesMeta": {
    "@vite-hub/database": {
      "optional": true
    },
    "drizzle-orm": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  }
}
