{
  "name": "@vite-hub/comments",
  "version": "0.0.4",
  "description": "Comments and in-place edits on live ViteHub sites, with presence and Content drafts.",
  "keywords": [
    "annotations",
    "collaboration",
    "comments",
    "h3",
    "typescript",
    "vite",
    "vitehub",
    "website-feedback"
  ],
  "homepage": "https://vitehub.dev",
  "bugs": "https://github.com/vite-hub/vitehub/issues",
  "license": "Apache-2.0",
  "author": "onmax <maximogarciamtnez@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vite-hub/vitehub.git",
    "directory": "packages/comments"
  },
  "files": [
    "dist",
    "package.json"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./anchor": {
      "types": "./dist/anchor.d.ts",
      "import": "./dist/anchor.js",
      "require": "./dist/anchor.js",
      "default": "./dist/anchor.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "require": "./dist/client.js",
      "default": "./dist/client.js"
    },
    "./database": {
      "types": "./dist/database.d.ts",
      "import": "./dist/database.js",
      "require": "./dist/database.js",
      "default": "./dist/database.js"
    },
    "./database/postgres": {
      "types": "./dist/database/postgres.d.ts",
      "import": "./dist/database/postgres.js",
      "require": "./dist/database/postgres.js",
      "default": "./dist/database/postgres.js"
    },
    "./operations": {
      "types": "./dist/operations.d.ts",
      "import": "./dist/operations.js",
      "require": "./dist/operations.js",
      "default": "./dist/operations.js"
