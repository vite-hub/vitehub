      "require": "./dist/rpc.js",
      "default": "./dist/rpc.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "import": "./dist/runtime/index.js",
      "require": "./dist/runtime/index.js",
      "default": "./dist/runtime/index.js"
    },
    "./runtime/auth": {
      "types": "./dist/runtime/auth.d.ts",
      "import": "./dist/runtime/auth.js",
      "require": "./dist/runtime/auth.js",
      "default": "./dist/runtime/auth.js"
    },
    "./runtime/connect": {
      "types": "./dist/runtime/connect.d.ts",
      "import": "./dist/runtime/connect.js",
      "require": "./dist/runtime/connect.js",
      "default": "./dist/runtime/connect.js"
