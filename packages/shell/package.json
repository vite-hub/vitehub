{
  "name": "@vite-hub/shell",
  "version": "0.0.1",
  "description": "Unified shell runtimes for ViteHub.",
  "author": "onmax <maximogarciamtnez@gmail.com>",
  "license": "Apache-2.0",
  "homepage": "https://github.com/vite-hub/vitehub#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vite-hub/vitehub.git",
    "directory": "packages/shell"
  },
  "bugs": "https://github.com/vite-hub/vitehub/issues",
  "keywords": [
    "vitehub",
    "shell",
    "just-bash",
    "cloudflare"
  ],
  "sideEffects": false,
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./providers/cloudflare": "./dist/providers/cloudflare.js",
    "./providers/just-bash": "./dist/providers/just-bash.js",
    "./workspace": "./dist/workspace.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "package.json"
  ],
  "scripts": {
    "build": "tsdown --tsconfig tsconfig.build.json",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit -p ./tsconfig.json",
    "test": "pnpm --filter @vite-hub/shell build && vitest run"
  },
  "dependencies": {
    "just-bash": "catalog:shell",
    "sh-syntax": "catalog:shell"
  },
  "devDependencies": {
    "@types/node": "catalog:tooling",
    "publint": "catalog:tooling",
    "tsdown": "catalog:tooling",
    "typescript": "catalog:tooling",
    "vitest": "catalog:tooling"
  }
}
