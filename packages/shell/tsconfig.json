{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "forceConsistentCasingInFileNames": true,
    "baseUrl": "../..",
    "paths": {
      "@vite-hub/shell": [
        "packages/shell/src/index.ts"
      ],
      "@vite-hub/shell/providers/cloudflare": [
        "packages/shell/src/providers/cloudflare.ts"
      ],
      "@vite-hub/shell/providers/just-bash": [
        "packages/shell/src/providers/just-bash.ts"
      ],
      "@vite-hub/shell/workspace": [
        "packages/shell/src/workspace/index.ts"
      ]
    },
    "rootDir": ".."
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ]
}
