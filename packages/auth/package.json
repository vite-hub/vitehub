{
  "name": "@vite-hub/auth",
  "version": "0.0.4",
  "description": "Better Auth-powered authentication primitives and Vite integration for ViteHub.",
  "keywords": [
    "auth",
    "authentication",
    "better-auth",
    "vite",
    "vitehub"
  ],
  "homepage": "https://github.com/vite-hub/vitehub#readme",
  "bugs": "https://github.com/vite-hub/vitehub/issues",
  "license": "Apache-2.0",
  "author": "onmax <maximogarciamtnez@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vite-hub/vitehub.git",
    "directory": "packages/auth"
  },
  "files": [
    "dist",
    "package.json"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "imports": {
    "#vitehub/auth/definition": {
      "types": "./dist/runtime/empty-definition.d.ts",
      "default": "./dist/runtime/empty-definition.js"
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./agent": {
      "types": "./dist/agent.d.ts",
      "import": "./dist/agent.js",
      "require": "./dist/agent.js",
      "default": "./dist/agent.js"
    },
    "./nuxt": {
      "types": "./dist/nuxt.d.ts",
      "import": "./dist/nuxt.js",
      "require": "./dist/nuxt.js",
      "default": "./dist/nuxt.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "require": "./dist/server.js",
      "default": "./dist/server.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js",
      "require": "./dist/vite.js",
      "default": "./dist/vite.js"
    },
    "./vue": {
      "types": "./dist/vue.d.ts",
      "import": "./dist/vue.js",
      "require": "./dist/vue.js",
      "default": "./dist/vue.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "typecheck": "tsc --noEmit -p ./tsconfig.json",
    "test": "vp run -t @vite-hub/auth#build && vp test"
  },
  "dependencies": {
    "@cloudflare/workers-types": "^5.20261016.1",
    "@types/node": "catalog:tooling",
    "@vite-hub/env": "workspace:*",
    "@vite-hub/runtime": "workspace:*",
    "better-auth": "catalog:auth",
    "bun-types": "^1.4.3",
    "nostics": "catalog:runtime"
  },
  "devDependencies": {
    "@types/json-schema": "catalog:ai",
    "@types/mdast": "catalog:markdown",
    "@vite-hub/agent": "workspace:*",
    "@types/node": "catalog:tooling",
    "@vite-hub/internal": "workspace:*",
    "publint": "catalog:tooling",
    "typescript": "catalog:tooling",
    "undici": "8.12.2",
    "vite": "catalog:vite",
    "vite-plus": "catalog:tooling",
    "vitest": "catalog:tooling",
    "vue": "catalog:ui"
  },
  "peerDependencies": {
    "@types/json-schema": "catalog:ai",
    "@types/mdast": "catalog:markdown",
    "@vite-hub/agent": "workspace:*",
    "vite": "catalog:vite-compat",
    "vue": "catalog:ui"
  },
  "peerDependenciesMeta": {
    "@vite-hub/agent": {
      "optional": true
    },
    "vite": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
