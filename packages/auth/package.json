{
  "name": "@vite-hub/auth",
  "version": "0.1.0",
  "description": "Better Auth-powered authentication primitives and Vite integration for ViteHub.",
  "keywords": [
    "auth",
    "authentication",
    "better-auth",
    "nuxt",
    "nuxt-module",
    "session",
    "typescript",
    "vite",
    "vitehub"
  ],
  "homepage": "https://vitehub.dev",
  "bugs": "https://github.com/vite-hub/vitehub/issues",
  "license": "Apache-2.0",
  "author": "onmax <maximogarciamtnez@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vite-hub/vitehub.git",
    "directory": "packages/auth"
  },
  "files": [
    "dist",
    "package.json"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "imports": {
    "#vitehub/auth/abilities": {
      "types": "./dist/runtime/empty-abilities.d.ts",
      "default": "./dist/runtime/empty-abilities.js"
    },
    "#vitehub/auth/client": {
      "types": "./dist/runtime/empty-client.d.ts",
      "default": "./dist/runtime/empty-client.js"
    },
    "#vitehub/auth/definition": {
      "types": "./dist/runtime/empty-definition.d.ts",
      "default": "./dist/runtime/empty-definition.js"
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./abilities": {
      "types": "./dist/abilities.d.ts",
      "import": "./dist/abilities.js",
      "default": "./dist/abilities.js"
    },
    "./agent": {
      "types": "./dist/agent.d.ts",
      "import": "./dist/agent.js",
      "default": "./dist/agent.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js",
      "default": "./dist/cli.js"
    },
    "./console": {
      "types": "./dist/console.d.ts",
      "import": "./dist/console.js",
      "default": "./dist/console.js"
    },
    "./console-runtime": {
      "types": "./dist/console-runtime.d.ts",
      "import": "./dist/console-runtime.js",
      "default": "./dist/console-runtime.js"
    },
    "./database": {
      "types": "./dist/database.d.ts",
      "import": "./dist/database.js",
      "default": "./dist/database.js"
    },
    "./forward": {
      "types": "./dist/forward.d.ts",
      "import": "./dist/forward.js",
      "default": "./dist/forward.js"
    },
    "./internal/server": {
      "types": "./dist/internal/server.d.ts",
      "import": "./dist/internal/server.js",
      "default": "./dist/internal/server.js"
    },
    "./mcp": {
      "types": "./dist/mcp.d.ts",
      "import": "./dist/mcp.js",
      "default": "./dist/mcp.js"
    },
    "./nuxt": {
      "types": "./dist/nuxt.d.ts",
      "import": "./dist/nuxt.js",
      "default": "./dist/nuxt.js"
    },
    "./presets": {
      "types": "./dist/presets.d.ts",
      "import": "./dist/presets.js",
      "default": "./dist/presets.js"
    },
    "./runtime/console": {
      "types": "./dist/runtime/console.d.ts",
      "import": "./dist/runtime/console.js",
      "default": "./dist/runtime/console.js"
    },
    "./runtime/server": {
      "types": "./dist/runtime/server.d.ts",
      "import": "./dist/runtime/server.js",
      "default": "./dist/runtime/server.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js",
      "default": "./dist/schema.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "default": "./dist/server.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js",
      "default": "./dist/vite.js"
    },
    "./vue": {
      "types": "./dist/vue.d.ts",
      "import": "./dist/vue.js",
      "default": "./dist/vue.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "typecheck": "vp run --cache -t @vite-hub/auth#build && node ../../test/package-typecheck.mjs --noEmit -p ./tsconfig.json",
    "test": "vp run --cache -t @vite-hub/auth#build && vp test"
  },
  "dependencies": {
    "@noble/hashes": "catalog:auth",
    "@types/node": "catalog:tooling",
    "@vite-hub/env": "workspace:*",
    "@vite-hub/runtime": "workspace:*",
    "@vite-hub/web-container": "workspace:*",
    "better-auth": "catalog:auth",
    "h3": "catalog:unjs",
    "nostics": "catalog:runtime",
    "rou3": "^1.0.0",
    "valibot": "catalog:runtime"
  },
  "devDependencies": {
    "@better-auth/oauth-provider": "catalog:auth",
    "@better-auth/passkey": "catalog:auth",
    "@cloudflare/workers-types": "^5.20261016.1",
    "@types/json-schema": "catalog:ai",
    "@types/mdast": "catalog:markdown",
    "@types/node": "catalog:tooling",
    "@vite-hub/agent": "workspace:*",
    "@vite-hub/database": "workspace:*",
    "@vite-hub/internal": "workspace:*",
    "bun-types": "^1.4.3",
    "happy-dom": "20.14.5",
    "miniflare": "4.20260730.0",
    "publint": "catalog:tooling",
    "typescript": "catalog:tooling",
    "undici": "8.12.2",
    "vite": "catalog:vite",
    "vite-plus": "catalog:tooling",
    "vitest": "catalog:tooling",
    "vue": "catalog:ui",
    "drizzle-orm": "catalog:database"
  },
  "peerDependencies": {
    "@better-auth/oauth-provider": "catalog:auth",
    "@types/json-schema": "catalog:ai",
    "@types/mdast": "catalog:markdown",
    "@vite-hub/agent": "workspace:*",
    "@vite-hub/database": "workspace:*",
    "vite": "catalog:vite-compat",
    "vue": "catalog:vue-compat",
    "drizzle-orm": "1.0.0-rc.5 || ^1.0.0"
  },
  "peerDependenciesMeta": {
    "@better-auth/oauth-provider": {
      "optional": true
    },
    "@vite-hub/agent": {
      "optional": true
    },
    "@vite-hub/database": {
      "optional": true
    },
    "vite": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
