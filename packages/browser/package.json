{
  "name": "@vite-hub/browser",
  "version": "0.0.4",
  "description": "Browser Definitions and provider-backed sessions for ViteHub.",
  "keywords": [
    "browser",
    "cloudflare",
    "playwright",
    "vite",
    "vitehub"
  ],
  "homepage": "https://github.com/vite-hub/vitehub#readme",
  "bugs": "https://github.com/vite-hub/vitehub/issues",
  "license": "Apache-2.0",
  "author": "onmax <maximogarciamtnez@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vite-hub/vitehub.git",
    "directory": "packages/browser"
  },
  "files": [
    "dist",
    "package.json"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "imports": {
    "#vitehub/browser/registry": {
      "types": "./dist/internal/runtime/empty-registry.d.ts",
      "default": "./dist/internal/runtime/empty-registry.js"
    },
    "#vitehub/browser/runtime": {
      "types": "./dist/internal/runtime/unconfigured.d.ts",
      "default": "./dist/internal/runtime/unconfigured.js"
    },
    "#vitehub/browser/chromium": {
      "types": "./dist/internal/chromium.d.ts",
      "workerd": "./dist/internal/chromium.workerd.js",
      "default": "./dist/internal/chromium.js"
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./actions": {
      "types": "./dist/actions.d.ts",
      "import": "./dist/actions.js"
    },
    "./controllers/cdp": {
      "types": "./dist/controllers/cdp.d.ts",
      "import": "./dist/controllers/cdp.js"
    },
    "./controllers/playwright": {
      "types": "./dist/controllers/playwright.d.ts",
      "import": "./dist/controllers/playwright.js"
    },
    "./internal/chromium": {
      "types": "./dist/internal/chromium.d.ts",
      "import": "./dist/internal/chromium.js"
    },
    "./internal/chromium.workerd": {
      "types": "./dist/internal/chromium.workerd.d.ts",
      "import": "./dist/internal/chromium.workerd.js"
    },
    "./internal/runtime/empty-registry": {
      "types": "./dist/internal/runtime/empty-registry.d.ts",
      "import": "./dist/internal/runtime/empty-registry.js"
    },
    "./internal/runtime/unconfigured": {
      "types": "./dist/internal/runtime/unconfigured.d.ts",
      "import": "./dist/internal/runtime/unconfigured.js"
    },
    "./providers/cloudflare": {
      "types": "./dist/providers/cloudflare.d.ts",
      "import": "./dist/providers/cloudflare.js"
    },
    "./providers/local": {
      "types": "./dist/providers/local.d.ts",
      "import": "./dist/providers/local.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "typecheck": "tsc --noEmit -p ./tsconfig.json",
    "test": "vp run -t @vite-hub/browser#build && vp test"
  },
  "dependencies": {
    "@vite-hub/runtime": "workspace:*",
    "esbuild": "catalog:esbuild-v27",
    "nostics": "catalog:runtime"
  },
  "devDependencies": {
    "@types/node": "catalog:tooling",
    "@vite-hub/internal": "workspace:*",
    "playwright-core": "catalog:browser",
    "publint": "catalog:tooling",
    "typescript": "catalog:tooling",
    "vite": "catalog:vite",
    "vite-plus": "catalog:tooling",
    "vitest": "catalog:tooling"
  },
  "peerDependencies": {
    "@cloudflare/playwright": "catalog:browser",
    "playwright-core": "catalog:browser",
    "vite": "catalog:vite-compat"
  },
  "peerDependenciesMeta": {
    "@cloudflare/playwright": {
      "optional": true
    },
    "playwright-core": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24.15.0"
  }
}
