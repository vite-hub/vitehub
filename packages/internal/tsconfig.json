{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "forceConsistentCasingInFileNames": true,
    "rootDir": ".."
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts",
    "test/**/*.test-d.ts"
  ],
  "exclude": [
    "dist",
    "node_modules",
    // Browser code: tsconfig.browser.json checks it with the DOM library.
    "src/runtime/page-tools-loader.ts",
    "src/runtime/page-tools-window.ts"
  ]
}
