{
  // The page tools loader and the page pill run in the browser. The DOM types conflict with the Node stream types of the other sources.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": [],
    // The page pill takes the motion layer from the `@vite-hub/ui` sources, as the build does (see vite.config.ts).
    "paths": { "@vite-hub/ui/motion": ["../ui/src/motion.ts"] }
  },
  "include": ["src/runtime/page-account.ts", "src/runtime/page-pill.ts", "src/runtime/page-tools-loader.ts"],
  "exclude": ["dist", "node_modules"]
}
