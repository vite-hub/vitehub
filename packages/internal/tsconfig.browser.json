  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": []
  },
  "include": ["src/runtime/page-links.ts", "src/runtime/page-pill.ts", "src/runtime/page-tools-loader.ts"],
  "exclude": ["dist", "node_modules"]
}
