{
  "name": "@vite-hub/workflow",
  "version": "0.0.1",
  "description": "Workflow primitives and Vite integration for ViteHub.",
  "keywords": [
    "cloudflare",
    "docker",
    "openworkflow",
    "vercel",
    "vite",
    "vitehub",
    "workflow"
  ],
  "homepage": "https://github.com/vite-hub/vitehub#readme",
  "bugs": "https://github.com/vite-hub/vitehub/issues",
  "license": "Apache-2.0",
  "author": "onmax <maximogarciamtnez@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vite-hub/vitehub.git",
    "directory": "packages/workflow"
  },
  "files": [
    "dist",
    "package.json"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./runtime/cloudflare-runner": "./dist/runtime/cloudflare-runner.js",
    "./runtime/cloudflare-shared": "./dist/runtime/cloudflare-shared.js",
    "./runtime/cloudflare-vite": "./dist/runtime/cloudflare-vite.js",
    "./runtime/execute": "./dist/runtime/execute.js",
    "./runtime/openworkflow": "./dist/runtime/openworkflow.js",
    "./runtime/openworkflow-worker": "./dist/runtime/openworkflow-worker.js",
    "./runtime/state": "./dist/runtime/state.js",
    "./runtime/vercel-vite": "./dist/runtime/vercel-vite.js",
    "./vite": "./dist/vite.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "typecheck": "tsc --noEmit -p ./tsconfig.json",
    "test": "vp run -t @vite-hub/workflow#build && vp test"
  },
  "dependencies": {
    "@vercel/functions": "catalog:vercel",
    "defu": "catalog:unjs",
    "esbuild": "catalog:tooling",
    "h3": "catalog:unjs",
    "pathe": "catalog:unjs"
  },
  "devDependencies": {
    "@types/node": "catalog:tooling",
    "@vite-hub/database": "workspace:*",
    "@vite-hub/internal": "workspace:*",
    "openworkflow": "catalog:workflow",
    "publint": "catalog:tooling",
    "typescript": "catalog:tooling",
    "vite": "catalog:vite",
    "vite-plus": "catalog:tooling",
    "vitest": "catalog:tooling"
  },
  "peerDependencies": {
    "@vite-hub/database": "workspace:*",
    "openworkflow": "catalog:workflow",
    "vite": "catalog:vite-compat",
    "workflow": "catalog:workflow"
  },
  "peerDependenciesMeta": {
    "@vite-hub/database": {
      "optional": true
    },
    "openworkflow": {
      "optional": true
    },
    "vite": {
      "optional": true
    },
    "workflow": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
