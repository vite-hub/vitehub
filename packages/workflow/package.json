{
  "name": "@vite-hub/workflow",
  "version": "0.1.0",
  "description": "Workflow primitives and Vite integration for ViteHub.",
  "keywords": [
    "background-jobs",
    "cloudflare",
    "docker",
    "durable-execution",
    "openworkflow",
    "typescript",
    "vercel",
    "vite",
    "vitehub",
    "workflow"
  ],
  "homepage": "https://vitehub.dev",
  "bugs": "https://github.com/vite-hub/vitehub/issues",
  "license": "Apache-2.0",
  "author": "onmax <maximogarciamtnez@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vite-hub/vitehub.git",
    "directory": "packages/workflow"
  },
  "files": [
    "dist",
    "package.json"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./durability": {
      "types": "./dist/durability.d.ts",
      "import": "./dist/durability.js",
      "default": "./dist/durability.js"
    },
    "./runtime/openworkflow": {
      "types": "./dist/runtime/openworkflow.d.ts",
      "import": "./dist/runtime/openworkflow.js",
      "default": "./dist/runtime/openworkflow.js"
    },
    "./openworkflow": {
      "types": "./dist/openworkflow.d.ts",
      "import": "./dist/openworkflow.js",
      "default": "./dist/openworkflow.js"
    },
    "./runtime/state": {
      "types": "./dist/runtime/state.d.ts",
      "import": "./dist/runtime/state.js",
      "default": "./dist/runtime/state.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js",
      "default": "./dist/vite.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "typecheck": "vp run --cache -t @vite-hub/workflow#build && node ../../test/package-typecheck.mjs --noEmit -p ./tsconfig.json",
    "test": "vp run --cache -t @vite-hub/workflow#build && vp run --cache -t @vite-hub/agent#build && vp test"
  },
  "dependencies": {
    "@valibot/to-json-schema": "catalog:runtime",
    "@vite-hub/runtime": "workspace:*",
    "defu": "catalog:unjs",
    "esbuild": "catalog:tooling",
    "h3": "catalog:unjs",
    "nostics": "catalog:runtime",
    "openworkflow": "catalog:workflow",
    "pathe": "catalog:unjs",
    "postgres": "catalog:database",
    "semver": "^7.8.5",
    "valibot": "catalog:runtime"
  },
  "devDependencies": {
    "@types/node": "catalog:tooling",
    "@vercel/functions": "catalog:vercel",
    "@vite-hub/internal": "workspace:*",
    "publint": "catalog:tooling",
    "typescript": "catalog:tooling",
    "vite": "catalog:vite",
    "vite-plus": "catalog:tooling",
    "vitest": "catalog:tooling"
  },
  "peerDependencies": {
    "@vercel/functions": "catalog:vercel",
    "@vite-hub/database": "workspace:*",
    "@workflow/builders": "catalog:workflow",
    "vite": "catalog:vite-compat",
    "workflow": "catalog:workflow"
  },
  "peerDependenciesMeta": {
    "@vercel/functions": {
      "optional": true
    },
    "@vite-hub/database": {
      "optional": true
    },
    "@workflow/builders": {
      "optional": true
    },
    "vite": {
      "optional": true
    },
    "workflow": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
