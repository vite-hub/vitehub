{
  "label": "Workflow",
  "docsPath": "workflow",
  "icon": "i-lucide-workflow",
  "order": 4,
  "defaultPhase": "define",
  "providers": [
    {
      "id": "cloudflare",
      "label": "Cloudflare",
      "icon": "i-simple-icons-cloudflare",
      "configOverride": "  workflow: {\n    provider: 'cloudflare',\n  },"
    },
    {
      "id": "vercel",
      "label": "Vercel",
      "icon": "i-simple-icons-vercel",
      "darkInvert": true,
      "configOverride": "  workflow: {\n    provider: 'vercel',\n  },"
    },
    {
      "id": "openworkflow",
      "label": "Docker/OpenWorkflow",
      "icon": "i-simple-icons-docker",
      "configOverride": "  workflow: {\n    provider: 'openworkflow',\n    sqlite: {\n      path: '.vitehub/data/workflow.sqlite',\n    },\n  },"
    }
  ],
  "frameworks": {
    "vite": {
      "modes": {
        "dev": {
          "phases": {
            "configure": "vite.config.ts",
            "define": "src/welcome.workflow.ts",
            "run": "src/server.ts"
          },
          "supplementalFiles": [
            "package.json"
          ]
        },
        "build": {
          "phases": {
            "configure": "vite.config.ts",
            "define": "src/welcome.workflow.ts",
            "run": "src/server.ts"
          },
          "supplementalFiles": [
            "package.json"
          ]
        }
      }
    }
  }
}
