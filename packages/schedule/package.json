{
  "name": "@vite-hub/schedule",
  "version": "0.0.1",
  "description": "Schedule primitives and definition discovery for ViteHub.",
  "author": "onmax <maximogarciamtnez@gmail.com>",
  "license": "Apache-2.0",
  "homepage": "https://github.com/vite-hub/vitehub#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vite-hub/vitehub.git",
    "directory": "packages/schedule"
  },
  "bugs": "https://github.com/vite-hub/vitehub/issues",
  "keywords": [
    "vitehub",
    "vite",
    "nitro",
    "schedule",
    "cron"
  ],
  "dependencies": {
    "cron-schedule": "^6.0.0",
    "esbuild": "catalog:"
  },
  "sideEffects": false,
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./nitro": "./dist/nitro.js",
    "./runtime": "./dist/runtime.js",
    "./runtime/state": "./dist/runtime/state.js",
    "./runtime/static": "./dist/runtime/static.js",
    "./vite": "./dist/vite.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "package.json"
  ],
  "scripts": {
    "build": "tsdown --tsconfig tsconfig.build.json",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit -p ./tsconfig.json",
    "test": "pnpm --dir . build && vitest run"
  },
  "peerDependencies": {
    "@vite-hub/kv": "workspace:*",
    "nitro": "^3.0.0-0",
    "vite": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "@vite-hub/kv": {
      "optional": true
    },
    "nitro": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vite-hub/internal": "workspace:*",
    "@vite-hub/kv": "workspace:*",
    "nitro": "catalog:",
    "publint": "^0.3.15",
    "tsdown": "^0.21.8",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
