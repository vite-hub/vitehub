{
  "name": "@vite-hub/schedule",
  "version": "0.0.4",
  "description": "Schedule primitives and definition discovery for ViteHub.",
  "keywords": [
    "cron",
    "schedule",
    "vite",
    "vitehub"
  ],
  "homepage": "https://github.com/vite-hub/vitehub#readme",
  "bugs": "https://github.com/vite-hub/vitehub/issues",
  "license": "Apache-2.0",
  "author": "onmax <maximogarciamtnez@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vite-hub/vitehub.git",
    "directory": "packages/schedule"
  },
  "files": [
    "dist",
    "package.json"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js"
    },
    "./nuxt": {
      "types": "./dist/nuxt.d.ts",
      "import": "./dist/nuxt.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    },
    "./runtime/console": {
      "types": "./dist/runtime/console.d.ts",
      "import": "./dist/runtime/console.js"
    },
    "./runtime/dev": {
      "types": "./dist/runtime/dev.d.ts",
      "import": "./dist/runtime/dev.js"
    },
    "./runtime/driver": {
      "types": "./dist/runtime/driver.d.ts",
      "import": "./dist/runtime/driver.js"
    },
    "./runtime/kv": {
      "types": "./dist/runtime/kv.d.ts",
      "import": "./dist/runtime/kv.js"
    },
    "./runtime/process": {
      "types": "./dist/runtime/process.d.ts",
      "import": "./dist/runtime/process.js"
    },
    "./runtime/state": {
      "types": "./dist/runtime/state.d.ts",
      "import": "./dist/runtime/state.js"
    },
    "./runtime/static": {
      "types": "./dist/runtime/static.d.ts",
      "import": "./dist/runtime/static.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "typecheck": "tsc --noEmit -p ./tsconfig.json",
    "test": "vp run -t @vite-hub/schedule#build && vp test"
  },
  "dependencies": {
    "@vite-hub/runtime": "workspace:*",
    "cron-schedule": "catalog:workflow",
    "effect": "catalog:effect",
    "esbuild": "catalog:tooling",
    "nostics": "catalog:runtime"
  },
  "devDependencies": {
    "@types/node": "catalog:tooling",
    "@vite-hub/internal": "workspace:*",
    "@vite-hub/kv": "workspace:*",
    "publint": "catalog:tooling",
    "typescript": "catalog:tooling",
    "vite": "catalog:vite",
    "vite-plus": "catalog:tooling",
    "vitest": "catalog:tooling"
  },
  "peerDependencies": {
    "@vite-hub/kv": "workspace:*",
    "vite": "catalog:vite-compat"
  },
  "peerDependenciesMeta": {
    "@vite-hub/kv": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24.15.0"
  }
}
