{
  "name": "@vite-hub/schedule",
  "version": "0.1.0",
  "description": "Schedule primitives and definition discovery for ViteHub.",
  "keywords": [
    "cloudflare",
    "cron",
    "cron-jobs",
    "netlify",
    "nuxt",
    "schedule",
    "typescript",
    "vercel",
    "vite",
    "vitehub"
  ],
  "homepage": "https://vitehub.dev",
  "bugs": "https://github.com/vite-hub/vitehub/issues",
  "license": "Apache-2.0",
  "author": "onmax <maximogarciamtnez@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vite-hub/vitehub.git",
    "directory": "packages/schedule"
  },
  "files": [
    "dist",
    "package.json"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js",
      "default": "./dist/runtime.js"
    },
    "./runtime/kv": {
      "types": "./dist/runtime/kv.d.ts",
      "import": "./dist/runtime/kv.js",
      "default": "./dist/runtime/kv.js"
    },
    "./runtime/process": {
      "types": "./dist/runtime/process.d.ts",
      "import": "./dist/runtime/process.js",
      "default": "./dist/runtime/process.js"
    },
    "./runtime/static": {
      "types": "./dist/runtime/static.d.ts",
      "import": "./dist/runtime/static.js",
      "default": "./dist/runtime/static.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js",
      "default": "./dist/vite.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "typecheck": "vp run --cache -t @vite-hub/schedule#build && node ../../test/package-typecheck.mjs --noEmit -p ./tsconfig.json",
    "test": "vp run --cache -t @vite-hub/schedule#build && vp test"
  },
  "dependencies": {
    "@valibot/to-json-schema": "catalog:runtime",
    "@vite-hub/runtime": "workspace:*",
    "cron-schedule": "catalog:workflow",
    "esbuild": "catalog:tooling",
    "nostics": "catalog:runtime",
    "valibot": "catalog:runtime"
  },
  "devDependencies": {
    "@types/node": "catalog:tooling",
    "@vite-hub/internal": "workspace:*",
    "@vite-hub/kv": "workspace:*",
    "postgres": "catalog:database",
    "publint": "catalog:tooling",
    "typescript": "catalog:tooling",
    "vite": "catalog:vite",
    "vite-plus": "catalog:tooling",
    "vitest": "catalog:tooling"
  },
  "peerDependencies": {
    "@vite-hub/kv": "workspace:*",
    "vite": "catalog:vite-compat"
  },
  "peerDependenciesMeta": {
    "@vite-hub/kv": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
