{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "forceConsistentCasingInFileNames": true,
    "rootDir": "..",
    "baseUrl": "../..",
    "paths": {
      "@vitehub/kv": [
        "packages/kv/src/index.ts"
      ],
      "@vitehub/internal/*": [
        "packages/internal/src/*.ts"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts",
    "test/**/*.ts",
    "test/**/*.test-d.ts"
  ],
  "exclude": [
    "dist",
    "docs",
    "examples",
    "node_modules"
  ]
}
