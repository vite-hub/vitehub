[Unit]
Description=Back up the database at 50%% load

[Service]
Type=oneshot
ExecStart="/opt/backup tools/bin/backup" --label "say \"hi\"" "$$HOME"
WorkingDirectory=/srv/backup
Environment="PATH=/usr/bin:/bin"
Environment="GREETING=50%% \"off\""
StandardOutput=append:/var/log/backup-db/backup-db.log
StandardError=append:/var/log/backup-db/backup-db.log
SyslogIdentifier=backup-db
