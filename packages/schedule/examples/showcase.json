{
  "label": "Schedule",
  "docsPath": "schedule",
  "icon": "i-lucide-calendar-clock",
  "order": 5,
  "defaultPhase": "define",
  "providers": [
    {
      "id": "cloudflare",
      "label": "Cloudflare",
      "icon": "i-simple-icons-cloudflare",
      "configOverride": "  schedule: {\n    provider: 'cloudflare',\n  },"
    },
    {
      "id": "vercel",
      "label": "Vercel",
      "icon": "i-simple-icons-vercel",
      "darkInvert": true,
      "configOverride": "  schedule: {\n    provider: 'vercel',\n  },"
    }
  ],
  "frameworks": {
    "vite": {
      "modes": {
        "dev": {
          "phases": {
            "configure": "vite.config.ts",
            "define": "src/daily-report.schedule.ts",
            "run": "src/server.ts"
          },
          "supplementalFiles": [
            "src/database-cleanup.schedule.ts",
            "package.json"
          ]
        },
        "build": {
          "phases": {
            "configure": "vite.config.ts",
            "define": "src/daily-report.schedule.ts",
            "run": "src/server.ts"
          },
          "supplementalFiles": [
            "src/database-cleanup.schedule.ts",
            "package.json"
          ]
        }
      }
    }
  }
}
