{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "forceConsistentCasingInFileNames": true,
    "rootDir": "..",
    "paths": {
      "@vite-hub/internal/*": [
        "../../packages/internal/src/*.ts"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts"
  ],
  "exclude": [
    "dist",
    "docs",
    "examples",
    "node_modules"
  ]
}
