{
  "label": "Chat",
  "docsPath": "chat",
  "icon": "i-lucide-message-circle",
  "order": 5,
  "defaultPhase": "define",
  "providers": [
    {
      "id": "cloudflare",
      "label": "Cloudflare",
      "icon": "i-simple-icons-cloudflare",
      "configOverride": "  chat: {\n    provider: 'cloudflare',\n    cloudflare: {\n      durableObjectState: true,\n    },\n  },"
    },
    {
      "id": "vercel",
      "label": "Vercel",
      "icon": "i-simple-icons-vercel",
      "darkInvert": true,
      "configOverride": "  chat: {\n    provider: 'vercel',\n  },"
    }
  ],
  "frameworks": {
    "nitro": {
      "modes": {
        "dev": {
          "phases": {
            "configure": "vite.config.ts",
            "define": "server/agents/triage.ts"
          },
          "supplementalFiles": [
            "package.json"
          ]
        },
        "build": {
          "phases": {
            "configure": "vite.config.ts",
            "define": "server/agents/triage.ts"
          },
          "supplementalFiles": [
            "package.json"
          ]
        }
      }
    }
  }
}
