{
  "name": "@vitehub/chat",
  "version": "0.0.0",
  "description": "Chat SDK integration and Vite/Nitro deployment DX for ViteHub.",
  "author": "onmax <maximogarciamtnez@gmail.com>",
  "license": "Apache-2.0",
  "homepage": "https://github.com/vite-hub/vitehub#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vite-hub/vitehub.git",
    "directory": "packages/chat"
  },
  "bugs": "https://github.com/vite-hub/vitehub/issues",
  "keywords": [
    "vitehub",
    "vite",
    "nitro",
    "chat",
    "cloudflare",
    "vercel"
  ],
  "sideEffects": false,
  "type": "module",
  "types": "./dist/index.d.ts",
  "bin": {
    "vitehub-chat": "./dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./cli": "./dist/cli.js",
    "./cloudflare": "./dist/cloudflare.js",
    "./devtools": "./dist/devtools.js",
    "./nitro": "./dist/nitro.js",
    "./runtime/cloudflare-workers-dev": "./dist/runtime/cloudflare-workers-dev.js",
    "./runtime/nitro-dev-initialize": "./dist/runtime/nitro-dev-initialize.js",
    "./runtime/nitro-plugin": "./dist/runtime/nitro-plugin.js",
    "./runtime/nitro-runtime-config": "./dist/runtime/nitro-runtime-config.js",
    "./vercel": "./dist/vercel.js",
    "./vite": "./dist/vite.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "package.json"
  ],
  "scripts": {
    "build": "tsdown --tsconfig tsconfig.build.json",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit -p ./tsconfig.json",
    "test": "pnpm --filter @vitehub/chat build && vitest run"
  },
  "dependencies": {
    "@vercel/functions": "^3.4.3",
    "@vitejs/devtools-kit": "^0.1.18",
    "h3": "2.0.1-rc.20",
    "hookable": "^6.1.1"
  },
  "peerDependencies": {
    "@vitejs/devtools": "^0.1.18",
    "chat": "^4.27.0",
    "chat-state-cloudflare-do": "^0.2.0",
    "nitro": "^3.0.0-0",
    "vite": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "@vitejs/devtools": {
      "optional": true
    },
    "chat-state-cloudflare-do": {
      "optional": true
    },
    "nitro": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@vitehub/internal": "workspace:*",
    "@vitejs/devtools": "^0.1.18",
    "chat": "^4.27.0",
    "chat-state-cloudflare-do": "^0.2.0",
    "nitro": "3.0.260311-beta",
    "publint": "^0.3.15",
    "tsdown": "^0.21.8",
    "typescript": "^6.0.2",
    "vite": "^8.0.8",
    "vitest": "^4.1.4"
  }
}
