{
  "name": "@vitehub/chat",
  "version": "0.0.0",
  "description": "Chat SDK integration and Vite/Nitro deployment DX for ViteHub.",
  "author": "onmax <maximogarciamtnez@gmail.com>",
  "license": "Apache-2.0",
  "homepage": "https://github.com/vite-hub/vitehub#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vite-hub/vitehub.git",
    "directory": "packages/chat"
  },
  "bugs": "https://github.com/vite-hub/vitehub/issues",
  "keywords": [
    "vitehub",
    "vite",
    "nitro",
    "chat",
    "cloudflare",
    "vercel"
  ],
  "sideEffects": false,
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./cloudflare": "./dist/cloudflare.js",
    "./nitro": "./dist/nitro.js",
    "./runtime/nitro-plugin": "./dist/runtime/nitro-plugin.js",
    "./vercel": "./dist/vercel.js",
    "./vite": "./dist/vite.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "package.json"
  ],
  "scripts": {
    "build": "tsdown --tsconfig tsconfig.build.json",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit -p ./tsconfig.json",
    "test": "pnpm --filter @vitehub/chat build && vitest run"
  },
  "dependencies": {
    "@vercel/functions": "catalog:",
    "h3": "catalog:",
    "hookable": "catalog:"
  },
  "peerDependencies": {
    "chat": "catalog:",
    "chat-state-cloudflare-do": "catalog:",
    "nitro": "^3.0.0-0",
    "vite": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "chat-state-cloudflare-do": {
      "optional": true
    },
    "nitro": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vitehub/internal": "workspace:*",
    "chat": "catalog:",
    "chat-state-cloudflare-do": "catalog:",
    "nitro": "catalog:",
    "publint": "^0.3.15",
    "tsdown": "^0.21.8",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
