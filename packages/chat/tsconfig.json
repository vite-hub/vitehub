{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "#vitehub/agent/registry": [
        "packages/agent/src/runtime/empty-registry.ts"
      ],
      "@vitehub/chat": [
        "packages/chat/src/index.ts"
      ],
      "@vitehub/chat/cloudflare": [
        "packages/chat/src/cloudflare.ts"
      ],
      "@vitehub/chat/runtime/nitro-dev-initialize": [
        "packages/chat/src/runtime/nitro-dev-initialize.ts"
      ],
      "@vitehub/internal/*": [
        "packages/internal/src/*"
      ],
      "@vitehub/messages": [
        "packages/messages/src/index.ts"
      ],
      "@vitehub/runtime": [
        "packages/runtime/src/index.ts"
      ]
    },
    "rootDir": "..",
    "baseUrl": "../.."
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts",
    "test/**/*.ts",
    "test/**/*.test-d.ts"
  ],
  "exclude": [
    "dist",
    "docs",
    "examples",
    "node_modules"
  ]
}
