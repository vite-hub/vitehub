{
  "name": "@vite-hub/email",
  "version": "0.6.1",
  "description": "Provider-neutral transactional email primitives and Vite integration for ViteHub.",
  "keywords": [
    "cloudflare",
    "email",
    "resend",
    "transactional-email",
    "typescript",
    "vite",
    "vitehub"
  ],
  "homepage": "https://vitehub.dev",
  "bugs": "https://github.com/vite-hub/vitehub/issues",
  "license": "Apache-2.0",
  "author": "onmax <maximogarciamtnez@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vite-hub/vitehub.git",
    "directory": "packages/email"
  },
  "files": [
    "dist",
    "package.json"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "imports": {
    "#vitehub/email/definition": {
      "types": "./dist/runtime/empty-definition.d.ts",
      "default": "./dist/runtime/empty-definition.js"
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./drivers/cloudflare": {
      "types": "./dist/drivers/cloudflare.d.ts",
      "import": "./dist/drivers/cloudflare.js",
      "default": "./dist/drivers/cloudflare.js"
    },
    "./drivers/log": {
      "types": "./dist/drivers/log.d.ts",
      "import": "./dist/drivers/log.js",
      "default": "./dist/drivers/log.js"
    },
    "./drivers/resend": {
      "types": "./dist/drivers/resend.d.ts",
      "import": "./dist/drivers/resend.js",
      "default": "./dist/drivers/resend.js"
    },
    "./drivers/smtp": {
      "types": "./dist/drivers/smtp.d.ts",
      "import": "./dist/drivers/smtp.js",
      "default": "./dist/drivers/smtp.js"
    },
    "./markdown": {
      "types": "./dist/markdown.d.ts",
      "import": "./dist/markdown.js",
      "default": "./dist/markdown.js"
    },
    "./runtime/console": {
      "types": "./dist/runtime/console.d.ts",
      "import": "./dist/runtime/console.js",
      "default": "./dist/runtime/console.js"
    },
    "./test": {
      "types": "./dist/test.d.ts",
      "import": "./dist/test.js",
      "default": "./dist/test.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js",
      "default": "./dist/vite.js"
    },
    "./vue": {
      "types": "./dist/vue.d.ts",
      "import": "./dist/vue.js",
      "default": "./dist/vue.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "typecheck": "vp run --cache -t @vite-hub/email#build && node ../../test/package-typecheck.mjs --noEmit -p ./tsconfig.json",
    "test": "vp run --cache -t @vite-hub/email#build && vp test"
  },
  "dependencies": {
    "@valibot/to-json-schema": "catalog:runtime",
    "@comark/html": "catalog:markdown",
    "@vite-hub/env": "workspace:*",
    "@vite-hub/markdown-template": "workspace:*",
    "@vite-hub/runtime": "workspace:*",
    "birpc": "catalog:runtime",
    "nostics": "catalog:runtime",
    "valibot": "catalog:runtime"
  },
  "devDependencies": {
    "@types/node": "catalog:tooling",
    "@vite-hub/internal": "workspace:*",
    "@vite-hub/workflow": "workspace:*",
    "@vitejs/plugin-vue": "^6.0.10",
    "esbuild": "catalog:tooling",
    "nodemailer": "10.6.0",
    "publint": "catalog:tooling",
    "typescript": "catalog:tooling",
    "vite": "catalog:vite",
    "vite-plus": "catalog:tooling",
    "vitest": "catalog:tooling",
    "vue": "catalog:ui"
  },
  "peerDependencies": {
    "nodemailer": "^10.0.0",
    "vite": "catalog:vite-compat",
    "vue": "catalog:vue-compat"
  },
  "peerDependenciesMeta": {
    "nodemailer": {
      "optional": true
    },
    "vite": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24.15.0"
  }
}
