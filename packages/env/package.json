{
  "name": "@vite-hub/env",
  "version": "0.0.1",
  "description": "Safe build and runtime environment variables for Vite and Nitro.",
  "author": "onmax <maximogarciamtnez@gmail.com>",
  "license": "Apache-2.0",
  "homepage": "https://github.com/vite-hub/vitehub#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vite-hub/vitehub.git",
    "directory": "packages/env"
  },
  "bugs": "https://github.com/vite-hub/vitehub/issues",
  "keywords": [
    "vitehub",
    "vite",
    "nitro",
    "env",
    "environment-variables",
    "runtime-config"
  ],
  "sideEffects": false,
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./nitro": {
      "types": "./dist/nitro.d.ts",
      "import": "./dist/nitro.js"
    },
    "./nuxt": {
      "types": "./dist/nuxt.d.ts",
      "import": "./dist/nuxt.js"
    },
    "./presets": {
      "types": "./dist/presets.d.ts",
      "import": "./dist/presets.js"
    },
    "./runtime/server": {
      "types": "./dist/runtime/server.d.ts",
      "import": "./dist/runtime/server.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js"
    },
    "./secret": {
      "types": "./dist/secret.d.ts",
      "import": "./dist/secret.js"
    },
    "./virtual": {
      "types": "./dist/virtual.d.ts",
      "import": "./dist/virtual.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "package.json"
  ],
  "scripts": {
    "build": "tsdown --tsconfig tsconfig.build.json",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit -p ./tsconfig.json",
    "test": "pnpm --filter @vite-hub/env build && vitest run"
  },
  "dependencies": {
    "@nuxt/kit": "catalog:nuxt"
  },
  "peerDependencies": {
    "nitro": "catalog:nitro-compat",
    "vite": "catalog:vite6-compat"
  },
  "peerDependenciesMeta": {
    "nitro": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nuxt/schema": "catalog:nuxt",
    "@vite-hub/internal": "workspace:*",
    "nitro": "catalog:unjs",
    "publint": "catalog:tooling",
    "tsdown": "catalog:tooling",
    "tsx": "catalog:tooling",
    "typescript": "catalog:tooling",
    "vite": "catalog:vite",
    "vitest": "catalog:tooling"
  }
}
