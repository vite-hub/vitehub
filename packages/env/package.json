{
  "name": "@vitehub/env",
  "version": "0.0.0",
  "description": "Safe build and runtime environment variables for Vite and Nitro.",
  "author": "onmax <maximogarciamtnez@gmail.com>",
  "license": "Apache-2.0",
  "homepage": "https://github.com/vite-hub/vitehub#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vite-hub/vitehub.git",
    "directory": "packages/env"
  },
  "bugs": "https://github.com/vite-hub/vitehub/issues",
  "keywords": [
    "vitehub",
    "vite",
    "nitro",
    "env",
    "environment-variables",
    "runtime-config"
  ],
  "sideEffects": false,
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./nitro": "./dist/nitro.js",
    "./runtime/public-runtime": "./dist/runtime/public-runtime.js",
    "./runtime/server": "./dist/runtime/server.js",
    "./schema": "./dist/schema.js",
    "./virtual": "./dist/virtual.js",
    "./vite": "./dist/vite.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "package.json"
  ],
  "scripts": {
    "build": "tsdown --tsconfig tsconfig.build.json",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit -p ./tsconfig.json",
    "test": "pnpm --filter @vitehub/env build && vitest run"
  },
  "dependencies": {
    "exsolve": "catalog:",
    "pathe": "catalog:"
  },
  "peerDependencies": {
    "nitro": "^3.0.0-0",
    "vite": ">=6.0.0"
  },
  "peerDependenciesMeta": {
    "nitro": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@vitehub/internal": "workspace:*",
    "nitro": "catalog:",
    "publint": "^0.3.15",
    "tsdown": "^0.21.8",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
