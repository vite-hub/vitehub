{
  "name": "@vite-hub/env",
  "version": "0.1.0",
  "description": "Safe build and runtime environment variables for ViteHub.",
  "keywords": [
    "env",
    "environment-variables",
    "runtime-config",
    "secrets",
    "typescript",
    "vite",
    "vitehub"
  ],
  "homepage": "https://vitehub.dev",
  "bugs": "https://github.com/vite-hub/vitehub/issues",
  "license": "Apache-2.0",
  "author": "onmax <maximogarciamtnez@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vite-hub/vitehub.git",
    "directory": "packages/env"
  },
  "files": [
    "dist",
    "package.json"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "imports": {
    "#vitehub/env/public": {
      "types": "./dist/runtime/public-env.d.ts",
      "default": "./dist/runtime/public-env.js"
    },
    "#vitehub/env/server": {
      "types": "./dist/runtime/server-env.d.ts",
      "default": "./dist/runtime/server-env.js"
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./bridge": {
      "types": "./dist/bridge.d.ts",
      "import": "./dist/bridge.js",
      "default": "./dist/bridge.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js",
      "default": "./dist/cli.js"
    },
    "./database": {
      "types": "./dist/database.d.ts",
      "import": "./dist/database.js",
      "default": "./dist/database.js"
    },
    "./internal/agent": {
      "types": "./dist/internal/agent.d.ts",
      "import": "./dist/internal/agent.js",
      "default": "./dist/internal/agent.js"
    },
    "./internal/connections": {
      "types": "./dist/internal/connections.d.ts",
      "import": "./dist/internal/connections.js",
      "default": "./dist/internal/connections.js"
    },
    "./internal/server": {
      "types": "./dist/internal/server.d.ts",
      "import": "./dist/internal/server.js",
      "default": "./dist/internal/server.js"
    },
    "./seal": {
      "types": "./dist/seal.d.ts",
      "import": "./dist/seal.js",
      "default": "./dist/seal.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "default": "./dist/server.js"
    },
    "./virtual": {
      "types": "./dist/virtual.d.ts",
      "import": "./dist/virtual.js",
      "default": "./dist/virtual.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js",
      "default": "./dist/vite.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "typecheck": "vp run --cache -t @vite-hub/env#build && node ../../test/package-typecheck.mjs --noEmit -p ./tsconfig.json",
    "test": "vp run --cache -t @vite-hub/env#build && vp test"
  },
  "dependencies": {
    "@env-spec/parser": "0.6.2",
    "@vite-hub/runtime": "workspace:*",
    "nostics": "catalog:runtime",
    "valibot": "catalog:runtime"
  },
  "devDependencies": {
    "@types/node": "catalog:tooling",
    "zod": "catalog:runtime",
    "@vite-hub/internal": "workspace:*",
    "publint": "catalog:tooling",
    "typescript": "catalog:tooling",
    "vite": "catalog:vite",
    "vite-plus": "catalog:tooling",
    "vitest": "catalog:tooling",
    "drizzle-orm": "catalog:database",
    "@libsql/client": "catalog:database",
    "miniflare": "4.20260730.0"
  },
  "peerDependencies": {
    "vite": "catalog:vite-compat",
    "drizzle-orm": ">=1.0.0-rc.5 <2.0.0",
    "@vite-hub/agent": "^0.1.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    },
    "drizzle-orm": {
      "optional": true
    },
    "@vite-hub/agent": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
