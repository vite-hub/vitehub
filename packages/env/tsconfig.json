{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "forceConsistentCasingInFileNames": true,
    "rootDir": "..",
    "baseUrl": "../..",
    "paths": {
      "@vite-hub/runtime/internal/grant": [
        "packages/runtime/src/internal/grant.ts"
      ],
      "@vite-hub/internal/*": [
        "packages/internal/src/*.ts"
      ],
      "@vite-hub/runtime": [
        "packages/runtime/src/index.ts"
      ],
      "@vite-hub/agent/env-identity": [
        "packages/agent/src/env-identity.ts"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts",
    "test/**/*.ts",
    "test/**/*.test-d.ts"
  ],
  "exclude": [
    "dist",
    "examples",
    "playground",
    "docs",
    "node_modules"
  ]
}
