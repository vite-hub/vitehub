{
  "label": "Env",
  "docsPath": "env",
  "icon": "i-lucide-key-round",
  "order": 6,
  "defaultPhase": "run",
  "providers": [
    {
      "id": "cloudflare",
      "label": "Cloudflare",
      "icon": "i-simple-icons-cloudflare",
      "envOverride": "VITEHUB_PUBLIC_APP_NAME=ViteHub Env\nGITHUB_TOKEN=<github-token>"
    },
    {
      "id": "vercel",
      "label": "Vercel",
      "icon": "i-simple-icons-vercel",
      "darkInvert": true,
      "envOverride": "VITEHUB_PUBLIC_APP_NAME=ViteHub Env\nGITHUB_TOKEN=<github-token>"
    }
  ],
  "frameworks": {
    "vite": {
      "modes": {
        "dev": {
          "phases": {
            "configure": "vite.config.ts",
            "run": "src/server.ts"
          },
          "supplementalFiles": [
            "package.json"
          ]
        },
        "build": {
          "phases": {
            "configure": "vite.config.ts",
            "run": "src/server.ts"
          },
          "supplementalFiles": [
            "package.json"
          ]
        }
      }
    }
  }
}
