{
  "name": "@vite-hub/docs",
  "version": "0.1.0",
  "description": "A documentation site on ViteHub primitives: typed Markdown pages, navigation, tutorials, search, agent resources, Console editing, and a docs assistant.",
  "keywords": [
    "content",
    "docs",
    "documentation",
    "markdown",
    "nuxt",
    "vite",
    "vitehub"
  ],
  "homepage": "https://vitehub.dev",
  "bugs": "https://github.com/vite-hub/vitehub/issues",
  "license": "Apache-2.0",
  "author": "onmax <maximogarciamtnez@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vite-hub/vitehub.git",
    "directory": "packages/docs"
  },
  "files": [
    "dist",
    "package.json"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./assistant": {
      "types": "./dist/assistant.d.ts",
      "workerd": "./dist/assistant-worker.js",
      "worker": "./dist/assistant-worker.js",
      "import": "./dist/assistant.js",
      "default": "./dist/assistant.js"
    },
    "./navigation": {
      "types": "./dist/navigation.d.ts",
      "import": "./dist/navigation.js",
      "default": "./dist/navigation.js"
    },
    "./nuxt": {
      "types": "./dist/nuxt.d.ts",
      "import": "./dist/nuxt.js",
      "default": "./dist/nuxt.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "default": "./dist/server.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "typecheck": "vp run --cache -t @vite-hub/docs#build && node ../../test/package-typecheck.mjs --noEmit -p ./tsconfig.json",
    "test": "vp run -t @vite-hub/docs#build && vp test"
  },
  "dependencies": {
    "@comark/vue": "0.8.1",
    "@nuxt/kit": "4.6.2",
    "@nuxtjs/mcp-toolkit": "^0.22.0",
    "@vite-hub/content": "workspace:*",
    "@vite-hub/rate-limit": "workspace:*",
    "@vite-hub/source": "workspace:*",
    "@vite-hub/ui": "workspace:*",
    "@vite-hub/workspace": "workspace:*",
    "@vueuse/core": "catalog:ui",
    "comark": "catalog:markdown-ui",
    "defu": "catalog:unjs",
    "nuxt-agent-discovery": "^0.7.0",
    "nuxt-llms": "^0.2.0",
    "shiki": "^4.5.0",
    "yaml": "catalog:tooling",
    "zod": "catalog:runtime"
  },
  "devDependencies": {
    "@nuxt/ui": "catalog:nuxt",
    "@types/node": "catalog:tooling",
    "@vite-hub/agent": "workspace:*",
    "@vite-hub/gateways": "workspace:*",
    "@vite-hub/internal": "workspace:*",
    "h3": "catalog:unjs",
    "nitropack": "catalog:unjs",
    "nuxt": "catalog:nuxt",
    "publint": "catalog:tooling",
    "typescript": "catalog:tooling",
    "vite": "catalog:vite",
    "vite-plus": "catalog:tooling",
    "vitest": "catalog:tooling",
    "vue": "catalog:ui"
  },
  "peerDependencies": {
    "@nuxt/ui": "^4.11.0",
    "@vite-hub/agent": "workspace:*",
    "@vite-hub/gateways": "workspace:*",
    "nuxt": "catalog:nuxt-compat",
    "vue": "catalog:ui"
  },
  "peerDependenciesMeta": {
    "@vite-hub/agent": {
      "optional": true
    },
    "@vite-hub/gateways": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24.15.0"
  }
}
