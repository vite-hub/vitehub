{
  "name": "@vite-hub/markdown-template",
  "version": "0.0.4",
  "description": "Deterministic Markdown templates with explicit data, conditions, and fragments.",
  "keywords": [
    "agent",
    "markdown",
    "template",
    "vitehub"
  ],
  "homepage": "https://github.com/vite-hub/vitehub#readme",
  "bugs": "https://github.com/vite-hub/vitehub/issues",
  "license": "Apache-2.0",
  "author": "onmax <maximogarciamtnez@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vite-hub/vitehub.git",
    "directory": "packages/markdown-template"
  },
  "files": [
    "dist",
    "package.json"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": {
        "node": "./dist/index.d.ts",
        "default": "./dist/portable.d.ts"
      },
      "node": "./dist/index.js",
      "default": "./dist/portable.js"
    },
    "./file": {
      "types": "./dist/file.d.ts",
      "import": "./dist/file.js",
      "require": "./dist/file.js",
      "default": "./dist/file.js"
    },
    "./internal/composition": {
      "types": "./dist/internal/composition.d.ts",
      "import": "./dist/internal/composition.js",
      "require": "./dist/internal/composition.js",
      "default": "./dist/internal/composition.js"
    },
    "./internal/vite": {
      "types": "./dist/internal/vite.d.ts",
      "import": "./dist/internal/vite.js",
      "require": "./dist/internal/vite.js",
      "default": "./dist/internal/vite.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js",
      "require": "./dist/vite.js",
      "default": "./dist/vite.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "typecheck": "tsc --noEmit -p ./tsconfig.json",
    "test": "vp run -t @vite-hub/markdown-template#build && vp test"
  },
  "dependencies": {
    "character-entities-legacy": "3.0.0",
    "comark": "catalog:markdown",
    "entities": "8.1.0",
    "nostics": "catalog:runtime"
  },
  "peerDependencies": {
    "vite": "catalog:vite-compat"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "catalog:tooling",
    "@vite-hub/internal": "workspace:*",
    "publint": "catalog:tooling",
    "typescript": "catalog:tooling",
    "vite": "catalog:vite",
    "vite-plus": "catalog:tooling",
    "vitest": "catalog:tooling"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
