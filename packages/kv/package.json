{
  "name": "@vite-hub/kv",
  "version": "0.1.0",
  "description": "Vite-first key-value storage primitives and integration for ViteHub.",
  "keywords": [
    "cloudflare",
    "key-value",
    "kv",
    "postgres",
    "redis",
    "typescript",
    "upstash",
    "vercel",
    "vite",
    "vitehub"
  ],
  "homepage": "https://vitehub.dev",
  "bugs": "https://github.com/vite-hub/vitehub/issues",
  "license": "Apache-2.0",
  "author": "onmax <maximogarciamtnez@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vite-hub/vitehub.git",
    "directory": "packages/kv"
  },
  "files": [
    "dist",
    "package.json"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js",
      "default": "./dist/cli.js"
    },
    "./durability": {
      "types": "./dist/durability.d.ts",
      "import": "./dist/durability.js",
      "default": "./dist/durability.js"
    },
    "./runtime/redis-driver": {
      "types": "./dist/runtime/redis-driver.d.ts",
      "import": "./dist/runtime/redis-driver.js",
      "default": "./dist/runtime/redis-driver.js"
    },
    "./runtime/upstash-driver": {
      "types": "./dist/runtime/upstash-driver.d.ts",
      "import": "./dist/runtime/upstash-driver.js",
      "default": "./dist/runtime/upstash-driver.js"
    },
    "./virtual": {
      "types": "./dist/virtual.d.ts",
      "import": "./dist/virtual.js",
      "default": "./dist/virtual.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js",
      "default": "./dist/vite.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "typecheck": "vp run --cache -t @vite-hub/kv#build && node ../../test/package-typecheck.mjs --noEmit -p ./tsconfig.json",
    "test": "vp run --cache -t @vite-hub/kv#build && vp test"
  },
  "dependencies": {
    "@valibot/to-json-schema": "catalog:runtime",
    "@vite-hub/runtime": "workspace:*",
    "birpc": "catalog:runtime",
    "defu": "catalog:unjs",
    "destr": "^2.0.5",
    "ioredis": "catalog:storage",
    "nostics": "catalog:runtime",
    "proper-lockfile": "catalog:",
    "unstorage": "catalog:storage",
    "valibot": "catalog:runtime"
  },
  "devDependencies": {
    "@types/node": "catalog:tooling",
    "@libsql/client": "catalog:database",
    "@vite-hub/database": "workspace:*",
    "@types/proper-lockfile": "catalog:",
    "@vite-hub/internal": "workspace:*",
    "ofetch": "catalog:unjs",
    "postgres": "catalog:database",
    "publint": "catalog:tooling",
    "typescript": "catalog:tooling",
    "vite": "catalog:vite",
    "vite-plus": "catalog:tooling",
    "vitest": "catalog:tooling"
  },
  "peerDependencies": {
    "@upstash/redis": "catalog:storage",
    "@vite-hub/database": "workspace:*",
    "vite": "catalog:vite-compat"
  },
  "peerDependenciesMeta": {
    "@upstash/redis": {
      "optional": true
    },
    "@vite-hub/database": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
