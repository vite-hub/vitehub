{
  "name": "@vite-hub/kv",
  "version": "0.0.1",
  "description": "Vite-first key-value storage primitives and Nitro/Nuxt integration for ViteHub.",
  "author": "onmax <maximogarciamtnez@gmail.com>",
  "license": "Apache-2.0",
  "homepage": "https://github.com/vite-hub/vitehub#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vite-hub/vitehub.git",
    "directory": "packages/kv"
  },
  "bugs": "https://github.com/vite-hub/vitehub/issues",
  "keywords": [
    "vitehub",
    "vite",
    "nitro",
    "nuxt",
    "kv",
    "cloudflare",
    "vercel"
  ],
  "sideEffects": false,
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./nitro": "./dist/nitro.js",
    "./nuxt": "./dist/nuxt.js",
    "./runtime/nitro-plugin": "./dist/runtime/nitro-plugin.js",
    "./virtual": "./dist/virtual.js",
    "./vite": "./dist/vite.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "package.json"
  ],
  "scripts": {
    "build": "tsdown --tsconfig tsconfig.build.json",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit -p ./tsconfig.json",
    "test": "pnpm --dir ../runtime build && pnpm --dir ../shell build && pnpm --dir ../source build && pnpm --dir ../sandbox build && pnpm --dir ../workspace build && pnpm --dir ../agent build && pnpm --dir ../blob build && pnpm --dir ../database build && pnpm --dir ../env build && pnpm --dir . build && pnpm --dir ../queue build && pnpm --dir ../workflow build && vitest run",
    "test:e2e": "tsx ./test/e2e.ts"
  },
  "dependencies": {
    "@nuxt/kit": "catalog:nuxt",
    "defu": "catalog:unjs",
    "exsolve": "catalog:unjs",
    "unstorage": "catalog:storage"
  },
  "peerDependencies": {
    "@upstash/redis": "catalog:storage",
    "nitro": "catalog:nitro-compat",
    "vite": "catalog:vite6-compat"
  },
  "peerDependenciesMeta": {
    "@upstash/redis": {
      "optional": true
    },
    "nitro": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nuxt/schema": "catalog:nuxt",
    "@vite-hub/internal": "workspace:*",
    "nitro": "catalog:unjs",
    "ofetch": "catalog:unjs",
    "publint": "catalog:tooling",
    "tsdown": "catalog:tooling",
    "tsx": "catalog:tooling",
    "typescript": "catalog:tooling",
    "vite": "catalog:vite",
    "vitest": "catalog:tooling"
  }
}
