{
  "name": "@vite-hub/kv",
  "version": "0.0.4",
  "description": "Vite-first key-value storage primitives and integration for ViteHub.",
  "keywords": [
    "cloudflare",
    "kv",
    "vercel",
    "vite",
    "vitehub"
  ],
  "homepage": "https://github.com/vite-hub/vitehub#readme",
  "bugs": "https://github.com/vite-hub/vitehub/issues",
  "license": "Apache-2.0",
  "author": "onmax <maximogarciamtnez@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vite-hub/vitehub.git",
    "directory": "packages/kv"
  },
  "files": [
    "dist",
    "package.json"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js",
      "require": "./dist/cli.js",
      "default": "./dist/cli.js"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "import": "./dist/errors.js",
      "require": "./dist/errors.js",
      "default": "./dist/errors.js"
    },
    "./runtime/cloudflare-kv": {
      "types": "./dist/runtime/cloudflare-kv.d.ts",
      "import": "./dist/runtime/cloudflare-kv.js",
      "require": "./dist/runtime/cloudflare-kv.js",
      "default": "./dist/runtime/cloudflare-kv.js"
    },
    "./runtime/dev": {
      "types": "./dist/runtime/dev.d.ts",
      "import": "./dist/runtime/dev.js",
      "require": "./dist/runtime/dev.js",
      "default": "./dist/runtime/dev.js"
    },
    "./runtime/upstash-driver": {
      "types": "./dist/runtime/upstash-driver.d.ts",
      "import": "./dist/runtime/upstash-driver.js",
      "require": "./dist/runtime/upstash-driver.js",
      "default": "./dist/runtime/upstash-driver.js"
    },
    "./virtual": {
      "types": "./dist/virtual.d.ts",
      "import": "./dist/virtual.js",
      "require": "./dist/virtual.js",
      "default": "./dist/virtual.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js",
      "require": "./dist/vite.js",
      "default": "./dist/vite.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "typecheck": "tsc --noEmit -p ./tsconfig.json",
    "test": "vp run -t @vite-hub/kv#build && vp test"
  },
  "dependencies": {
    "@vite-hub/runtime": "workspace:*",
    "defu": "catalog:unjs",
    "destr": "^2.0.5",
    "nostics": "catalog:runtime",
    "unstorage": "catalog:storage",
    "valibot": "catalog:runtime"
  },
  "devDependencies": {
    "@vite-hub/internal": "workspace:*",
    "ofetch": "catalog:unjs",
    "publint": "catalog:tooling",
    "typescript": "catalog:tooling",
    "vite": "catalog:vite",
    "vite-plus": "catalog:tooling",
    "vitest": "catalog:tooling"
  },
  "peerDependencies": {
    "@upstash/redis": "catalog:storage",
    "vite": "catalog:vite-compat"
  },
  "peerDependenciesMeta": {
    "@upstash/redis": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
