{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "forceConsistentCasingInFileNames": true,
    "rootDir": "..",
    "baseUrl": "../..",
    "paths": {
      "@vitehub/internal/feature-bridge": [
        "packages/internal/src/feature-bridge/feature-engine.ts"
      ],
      "@vitehub/internal/*": [
        "packages/internal/src/*.ts"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts",
    "test/**/*.ts",
    "test/**/*.test-d.ts"
  ],
  "exclude": [
    "dist",
    "examples",
    "playground",
    "docs",
    "node_modules"
  ]
}
