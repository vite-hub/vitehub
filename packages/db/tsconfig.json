{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "rootDir": "..",
    "types": [
      "node",
      "vitest/globals"
    ],
    "baseUrl": "../..",
    "paths": {
      "@vitehub/internal/*": [
        "packages/internal/src/*.ts"
      ]
    }
  },
  "include": [
    "src/**/*.d.ts",
    "src/**/*.ts",
    "test/**/*.ts"
  ],
  "exclude": [
    "test/types-published.test-d.ts",
    "test/types-virtual-published.test-d.ts"
  ]
}
