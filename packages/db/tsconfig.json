{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "rootDir": "..",
    "types": [
      "node",
      "vitest/globals"
    ],
    "baseUrl": "../..",
    "paths": {
      "@vitehub/agent": [
        "packages/agent/src/tool-definition.ts"
      ],
      "@vitehub/messages": [
        "packages/messages/src/index.ts"
      ],
      "@vitehub/runtime": [
        "packages/runtime/src/index.ts"
      ],
      "@vitehub/workspace": [
        "packages/workspace/src/index.ts"
      ],
      "@vitehub/internal/*": [
        "packages/internal/src/*"
      ]
    }
  },
  "include": [
    "src/**/*.d.ts",
    "src/**/*.ts",
    "test/**/*.ts"
  ],
  "exclude": [
    "test/types-published.test-d.ts",
    "test/types-virtual-published.test-d.ts"
  ]
}
