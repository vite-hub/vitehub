{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "rootDir": "..",
    "baseUrl": "../..",
    "paths": {
      "#vitehub/agent/registry": ["packages/agent/src/runtime/empty-registry.ts"],
      "#vitehub/auth/definition": ["packages/auth/src/runtime/empty-definition.ts"],
      "#vitehub/database/databases": ["packages/database/src/runtime/virtual-databases.ts"],
      "#vitehub/database/schema": ["packages/database/src/runtime/virtual-schema.ts"],
      "#vitehub-sandbox-provider-loader": ["packages/sandbox/src/runtime/provider-loader.ts"],
      "#vitehub-sandbox-registry": ["packages/sandbox/src/runtime/empty-registry.ts"],
      "#vitehub-workspace-assets-registry": ["packages/workspace/src/runtime/empty-assets-registry.ts"],
      "#vitehub-workspace-registry": ["packages/workspace/src/runtime/empty-registry.ts"],
      "virtual:vitehub-sandbox-provider-loader": ["packages/sandbox/src/runtime/provider-loader.ts"],
      "vitehub-sandbox-provider-loader": ["packages/sandbox/src/runtime/provider-loader.ts"],
      "vite-hub": ["packages/vite-hub/src/index.ts"],
      "vite-hub/*": ["packages/vite-hub/src/*"],
      "@vite-hub/agent": ["packages/agent/src/index.ts"],
      "@vite-hub/agent/*": ["packages/agent/src/*"],
      "@vite-hub/auth": ["packages/auth/src/index.ts"],
      "@vite-hub/auth/*": ["packages/auth/src/*"],
      "@vite-hub/blob": ["packages/blob/src/index.ts"],
      "@vite-hub/blob/*": ["packages/blob/src/*"],
      "@vite-hub/browser": ["packages/browser/src/index.ts"],
      "@vite-hub/browser/*": ["packages/browser/src/*"],
      "@vite-hub/box": ["packages/box/src/index.ts"],
      "@vite-hub/box/*": ["packages/box/src/*"],
      "@vite-hub/cli": ["packages/cli/src/index.ts"],
      "@vite-hub/database": ["packages/database/src/index.ts"],
      "@vite-hub/database/*": ["packages/database/src/*"],
      "@vite-hub/email": ["packages/email/src/index.ts"],
      "@vite-hub/email/*": ["packages/email/src/*"],
      "@vite-hub/env": ["packages/env/src/index.ts"],
      "@vite-hub/env/*": ["packages/env/src/*"],
      "@vite-hub/kv": ["packages/kv/src/index.ts"],
      "@vite-hub/kv/*": ["packages/kv/src/*"],
      "@vite-hub/queue": ["packages/queue/src/index.ts"],
      "@vite-hub/queue/*": ["packages/queue/src/*"],
      "@vite-hub/rate-limit": ["packages/rate-limit/src/index.ts"],
      "@vite-hub/rate-limit/*": ["packages/rate-limit/src/*"],
      "@vite-hub/runtime": ["packages/runtime/src/index.ts"],
      "@vite-hub/internal/*": ["packages/internal/src/*.ts"],
      "@vite-hub/sandbox": ["packages/sandbox/src/index.ts"],
      "@vite-hub/sandbox/*": ["packages/sandbox/src/*"],
      "@vite-hub/schedule": ["packages/schedule/src/index.ts"],
      "@vite-hub/schedule/*": ["packages/schedule/src/*"],
      "@vite-hub/shell": ["packages/shell/src/index.ts"],
      "@vite-hub/shell/*": ["packages/shell/src/*"],
      "@vite-hub/source": ["packages/source/src/index.ts"],
      "@vite-hub/source/*": ["packages/source/src/*"],
      "@vite-hub/workflow": ["packages/workflow/src/index.ts"],
      "@vite-hub/workflow/*": ["packages/workflow/src/*"],
      "@vite-hub/workspace": ["packages/workspace/src/index.ts"],
      "@vite-hub/workspace/*": ["packages/workspace/src/*"],
      "@vite-hub/workspace/internal/runtime/hosted": ["packages/workspace/src/hosted.ts"],
      "@vite-hub/workspace/internal/runtime/hosted-vercel-blob": ["packages/workspace/src/hosted-vercel-blob.ts"],
      "@vite-hub/workspace/internal/stores/github": ["packages/workspace/src/providers/github/store.ts"]
    }
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts",
    "test/**/*.test-d.ts"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ]
}
