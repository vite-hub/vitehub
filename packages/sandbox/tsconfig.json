{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "#vitehub-sandbox-provider-loader": [
        "packages/sandbox/src/runtime/provider-loader.ts"
      ],
      "virtual:vitehub-sandbox-provider-loader": [
        "packages/sandbox/src/runtime/provider-loader.ts"
      ],
      "vitehub-sandbox-provider-loader": [
        "packages/sandbox/src/runtime/provider-loader.ts"
      ],
      "@vitehub/sandbox/runtime/provider-loader": [
        "packages/sandbox/src/runtime/provider-loader.ts"
      ],
      "#vitehub-sandbox-registry": [
        "packages/sandbox/src/runtime/empty-registry.ts"
      ],
      "@vitehub/internal/*": [
        "packages/internal/src/*.ts"
      ]
    },
    "rootDir": "..",
    "baseUrl": "../.."
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts",
    "test/**/*.ts",
    "test/**/*.test-d.ts"
  ],
  "exclude": [
    "dist",
    "examples",
    "playground",
    "docs",
    "node_modules"
  ]
}
