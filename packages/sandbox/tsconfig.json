{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "@vite-hub/sandbox": [
        "../../packages/sandbox/src/index.ts"
      ],
      "#vitehub-sandbox-task-provider-loader": [
        "../../packages/sandbox/src/task/runtime/provider-loader.ts"
      ],
      "virtual:vitehub-sandbox-task-provider-loader": [
        "../../packages/sandbox/src/task/runtime/provider-loader.ts"
      ],
      "vitehub-sandbox-task-provider-loader": [
        "../../packages/sandbox/src/task/runtime/provider-loader.ts"
      ],
      "@vite-hub/sandbox/task/runtime/provider-loader": [
        "../../packages/sandbox/src/task/runtime/provider-loader.ts"
      ],
      "#vitehub-sandbox-task-registry": [
        "../../packages/sandbox/src/task/runtime/empty-registry.ts"
      ],
      "@vite-hub/internal/*": [
        "../../packages/internal/src/*.ts"
      ]
    },
    "rootDir": ".."
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts",
    "test/**/*.ts",
    "test/**/*.test-d.ts"
  ],
  "exclude": [
    "dist",
    "examples",
    "node_modules"
  ]
}
