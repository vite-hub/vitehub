{
  "name": "@vite-hub/sandbox",
  "version": "0.0.1",
  "description": "Sandbox execution primitives and Vite integration for ViteHub.",
  "keywords": [
    "cloudflare",
    "sandbox",
    "vercel",
    "vite",
    "vitehub"
  ],
  "homepage": "https://github.com/vite-hub/vitehub#readme",
  "bugs": "https://github.com/vite-hub/vitehub/issues",
  "license": "Apache-2.0",
  "author": "onmax <maximogarciamtnez@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vite-hub/vitehub.git",
    "directory": "packages/sandbox"
  },
  "files": [
    "dist",
    "package.json"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "imports": {
    "#vitehub-sandbox-provider-loader": {
      "types": "./dist/runtime/provider-loader.d.ts",
      "default": "./dist/runtime/provider-loader.js"
    },
    "#vitehub-sandbox-registry": {
      "types": "./dist/runtime/empty-registry.d.ts",
      "default": "./dist/runtime/empty-registry.js"
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./runtime/empty-registry": {
      "types": "./dist/runtime/empty-registry.d.ts",
      "import": "./dist/runtime/empty-registry.js"
    },
    "./runtime/provider-loader": {
      "types": "./dist/runtime/provider-loader.d.ts",
      "import": "./dist/runtime/provider-loader.js"
    },
    "./runtime/state": {
      "types": "./dist/runtime/state.d.ts",
      "import": "./dist/runtime/state.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "typecheck": "tsc --noEmit -p ./tsconfig.json",
    "test": "vp run -t @vite-hub/sandbox#build && vp test"
  },
  "dependencies": {
    "@vite-hub/box": "workspace:*",
    "@vite-hub/runtime": "workspace:*",
    "esbuild": "catalog:tooling",
    "h3": "catalog:unjs",
    "local-pkg": "catalog:tooling",
    "mlly": "catalog:unjs",
    "pathe": "catalog:unjs",
    "rollup": "catalog:tooling",
    "scule": "catalog:unjs",
    "typescript": "catalog:tooling",
    "ufo": "catalog:unjs",
    "unimport": "catalog:unjs"
  },
  "devDependencies": {
    "@vite-hub/internal": "workspace:*",
    "ofetch": "catalog:unjs",
    "publint": "catalog:tooling",
    "vite": "catalog:vite",
    "vite-plus": "catalog:tooling",
    "vitest": "catalog:tooling"
  },
  "peerDependencies": {
    "@cloudflare/sandbox": "catalog:sandbox",
    "@vercel/sandbox": "catalog:sandbox",
    "vite": "catalog:vite-compat"
  },
  "peerDependenciesMeta": {
    "@cloudflare/sandbox": {
      "optional": true
    },
    "@vercel/sandbox": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
