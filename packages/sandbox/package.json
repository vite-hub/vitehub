{
  "name": "@vite-hub/sandbox",
  "version": "0.0.1",
  "description": "Sandbox execution primitives and Vite integration for ViteHub.",
  "author": "onmax <maximogarciamtnez@gmail.com>",
  "license": "Apache-2.0",
  "homepage": "https://github.com/vite-hub/vitehub#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vite-hub/vitehub.git",
    "directory": "packages/sandbox"
  },
  "bugs": "https://github.com/vite-hub/vitehub/issues",
  "keywords": [
    "vitehub",
    "vite",
    "nitro",
    "sandbox",
    "cloudflare",
    "vercel"
  ],
  "sideEffects": false,
  "type": "module",
  "types": "./dist/index.d.ts",
  "imports": {
    "#vitehub-sandbox-provider-loader": {
      "types": "./dist/runtime/provider-loader.d.ts",
      "default": "./dist/runtime/provider-loader.js"
    },
    "#vitehub-sandbox-registry": {
      "types": "./dist/runtime/empty-registry.d.ts",
      "default": "./dist/runtime/empty-registry.js"
    }
  },
  "exports": {
    ".": "./dist/index.js",
    "./nitro": "./dist/nitro.js",
    "./runtime/empty-registry": "./dist/runtime/empty-registry.js",
    "./runtime/nitro-plugin": "./dist/runtime/nitro-plugin.js",
    "./runtime/provider-loader": "./dist/runtime/provider-loader.js",
    "./runtime/providers/cloudflare": "./dist/runtime/providers/cloudflare.js",
    "./runtime/providers/vercel": "./dist/runtime/providers/vercel.js",
    "./runtime/state": "./dist/runtime/state.js",
    "./sandbox/providers/cloudflare": "./dist/sandbox/providers/cloudflare.js",
    "./sandbox/providers/vercel": "./dist/sandbox/providers/vercel.js",
    "./vite": "./dist/vite.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "package.json"
  ],
  "scripts": {
    "build": "tsdown --tsconfig tsconfig.build.json",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit -p ./tsconfig.json",
    "test": "pnpm --filter @vite-hub/agent... build && pnpm --dir ../blob build && pnpm --dir ../kv build && pnpm --dir ../queue build && pnpm --dir . build && vitest run",
    "test:e2e": "tsx ./test/e2e.ts"
  },
  "dependencies": {
    "esbuild": "catalog:tooling",
    "exsolve": "catalog:unjs",
    "h3": "catalog:unjs",
    "local-pkg": "catalog:tooling",
    "mlly": "catalog:unjs",
    "pathe": "catalog:unjs",
    "pkg-types": "catalog:unjs",
    "rollup": "catalog:tooling",
    "scule": "catalog:unjs",
    "typescript": "catalog:tooling",
    "ufo": "catalog:unjs",
    "unctx": "catalog:unjs",
    "unimport": "catalog:unjs"
  },
  "peerDependencies": {
    "@cloudflare/sandbox": "catalog:sandbox",
    "@vercel/sandbox": "catalog:sandbox",
    "nitro": "catalog:nitro-compat",
    "vite": "catalog:vite8-plus-compat"
  },
  "peerDependenciesMeta": {
    "@cloudflare/sandbox": {
      "optional": true
    },
    "@vercel/sandbox": {
      "optional": true
    },
    "nitro": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@cloudflare/sandbox": "catalog:sandbox",
    "@vercel/sandbox": "catalog:sandbox",
    "nitro": "catalog:unjs",
    "ofetch": "catalog:unjs",
    "publint": "catalog:tooling",
    "tsdown": "catalog:tooling",
    "tsx": "catalog:tooling",
    "@vite-hub/internal": "workspace:*",
    "vite": "catalog:vite",
    "vitest": "catalog:tooling"
  }
}
