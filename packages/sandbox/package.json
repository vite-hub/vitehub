{
  "name": "@vite-hub/sandbox",
  "version": "0.2.0",
  "description": "Portable, isolated Sandboxes for ViteHub Agents, and Sandbox Tasks that run named package projects in them.",
  "keywords": [
    "agent",
    "ai-agents",
    "cloudflare",
    "code-execution",
    "runtime",
    "sandbox",
    "typescript",
    "vercel",
    "vite",
    "vitehub"
  ],
  "homepage": "https://vitehub.dev",
  "bugs": "https://github.com/vite-hub/vitehub/issues",
  "license": "Apache-2.0",
  "author": "onmax <maximogarciamtnez@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vite-hub/vitehub.git",
    "directory": "packages/sandbox"
  },
  "files": [
    "dist",
    "package.json"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "imports": {
    "#vitehub-sandbox-task-provider-loader": {
      "types": "./dist/task/runtime/provider-loader.d.ts",
      "default": "./dist/task/runtime/provider-loader.js"
    },
    "#vitehub-sandbox-task-registry": {
      "types": "./dist/task/runtime/empty-registry.d.ts",
      "default": "./dist/task/runtime/empty-registry.js"
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./_internal/cloudflare": {
      "types": "./dist/internal/cloudflare.d.ts",
      "import": "./dist/internal/cloudflare.js",
      "default": "./dist/internal/cloudflare.js"
    },
    "./_internal/toolchain": {
      "types": "./dist/internal/host-toolchain.d.ts",
      "import": "./dist/internal/host-toolchain.js",
      "default": "./dist/internal/host-toolchain.js"
    },
    "./_internal/vercel": {
      "types": "./dist/internal/vercel.d.ts",
      "import": "./dist/internal/vercel.js",
      "default": "./dist/internal/vercel.js"
    },
    "./ssh": {
      "types": "./dist/ssh.d.ts",
      "import": "./dist/ssh.js",
      "default": "./dist/ssh.js"
    },
    "./task": {
      "types": "./dist/task/index.d.ts",
      "import": "./dist/task/index.js",
      "default": "./dist/task/index.js"
    },
    "./task/runtime/empty-registry": {
      "types": "./dist/task/runtime/empty-registry.d.ts",
      "import": "./dist/task/runtime/empty-registry.js",
      "default": "./dist/task/runtime/empty-registry.js"
    },
    "./task/runtime/provider-loader": {
      "types": "./dist/task/runtime/provider-loader.d.ts",
      "import": "./dist/task/runtime/provider-loader.js",
      "default": "./dist/task/runtime/provider-loader.js"
    },
    "./task/runtime/state": {
      "types": "./dist/task/runtime/state.d.ts",
      "import": "./dist/task/runtime/state.js",
      "default": "./dist/task/runtime/state.js"
    },
    "./task/vite": {
      "types": "./dist/task/vite.d.ts",
      "import": "./dist/task/vite.js",
      "default": "./dist/task/vite.js"
    },
    "./package.json": "./package.json",
    "./_internal/task/runtime": {
      "types": "./dist/task/index.d.ts",
      "import": "./dist/task/index.js",
      "default": "./dist/task/index.js"
    },
    "./_internal/task/runtime/providers/cloudflare": {
      "types": "./dist/task/runtime/providers/cloudflare.d.ts",
      "import": "./dist/task/runtime/providers/cloudflare.js",
      "default": "./dist/task/runtime/providers/cloudflare.js"
    },
    "./_internal/task/runtime/providers/vercel": {
      "types": "./dist/task/runtime/providers/vercel.d.ts",
      "import": "./dist/task/runtime/providers/vercel.js",
      "default": "./dist/task/runtime/providers/vercel.js"
    }
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "typecheck": "vp run --cache -t @vite-hub/sandbox#build && node ../../test/package-typecheck.mjs --noEmit -p ./tsconfig.json",
    "test": "vp run -t @vite-hub/sandbox#build && vp test"
  },
  "dependencies": {
    "@vite-hub/runtime": "workspace:*",
    "esbuild": "catalog:tooling",
    "local-pkg": "catalog:tooling",
    "mlly": "catalog:unjs",
    "nostics": "catalog:runtime",
    "pathe": "catalog:unjs",
    "semver": "^7.8.5",
    "unimport": "catalog:unjs",
    "yaml": "catalog:tooling"
  },
  "devDependencies": {
    "@cloudflare/sandbox": "catalog:sandbox",
    "@types/node": "catalog:tooling",
    "@types/semver": "^7.8.0",
    "@types/ssh2": "^1.15.6",
    "@vercel/sandbox": "catalog:sandbox",
    "@vite-hub/internal": "workspace:*",
    "ofetch": "catalog:unjs",
    "publint": "catalog:tooling",
    "rollup": "catalog:tooling",
    "ssh2": "^1.17.0",
    "typescript": "catalog:tooling",
    "vite": "catalog:vite",
    "vite-plus": "catalog:tooling",
    "vitest": "catalog:tooling",
    "zod": "catalog:runtime"
  },
  "peerDependencies": {
    "@cloudflare/sandbox": "catalog:sandbox",
    "ssh2": "^1.17.0",
    "@vercel/sandbox": "catalog:sandbox",
    "typescript": "^5.8.0 || ^6.0.0",
    "vite": "catalog:vite-compat"
  },
  "peerDependenciesMeta": {
    "@cloudflare/sandbox": {
      "optional": true
    },
    "ssh2": {
      "optional": true
    },
    "@vercel/sandbox": {
      "optional": true
    },
    "typescript": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
