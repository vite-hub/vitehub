{
  "name": "@vite-hub/cli",
  "version": "0.1.0",
  "description": "Command-line workflows for ViteHub projects.",
  "keywords": [
    "agent",
    "cli",
    "development-tools",
    "eval",
    "nuxt",
    "typescript",
    "vite",
    "vitehub"
  ],
  "homepage": "https://vitehub.dev",
  "bugs": "https://github.com/vite-hub/vitehub/issues",
  "license": "Apache-2.0",
  "author": "onmax <maximogarciamtnez@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vite-hub/vitehub.git",
    "directory": "packages/cli"
  },
  "files": [
    "dist",
    "package.json"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./setup": {
      "types": "./dist/setup/index.d.ts",
      "import": "./dist/setup/index.js",
      "default": "./dist/setup/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "typecheck": "vp run --cache -t @vite-hub/cli#build && node ../../test/package-typecheck.mjs --noEmit -p ./tsconfig.json",
    "test": "vp run --cache -t vite-hub#build && vp run --cache -t @vite-hub/cli#build && vp test"
  },
  "dependencies": {
    "@babel/parser": "^7.29.9",
    "@vite-hub/runtime": "workspace:*",
    "birpc": "catalog:runtime",
    "diff": "catalog:runtime",
    "nostics": "catalog:runtime",
    "pathe": "catalog:unjs",
    "semver": "^7.8.5"
  },
  "devDependencies": {
    "@types/node": "catalog:tooling",
    "@types/semver": "^7.8.0",
    "@vite-hub/internal": "workspace:*",
    "nuxt": "catalog:nuxt",
    "typescript": "catalog:tooling",
    "valibot": "catalog:runtime",
    "vite": "catalog:vite",
    "vite-plus": "catalog:tooling",
    "vitest": "catalog:tooling"
  },
  "peerDependencies": {
    "nuxt": "catalog:nuxt-compat",
    "vite": "catalog:vite-compat"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "peerDependenciesMeta": {
    "nuxt": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  }
}
