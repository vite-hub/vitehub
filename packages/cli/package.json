{
  "name": "@vite-hub/cli",
  "version": "0.1.1",
  "description": "Command-line workflows for ViteHub projects.",
  "keywords": [
    "agent",
    "cli",
    "development-tools",
    "eval",
    "nuxt",
    "typescript",
    "vite",
    "vitehub"
  ],
  "homepage": "https://vitehub.dev",
  "bugs": "https://github.com/vite-hub/vitehub/issues",
  "license": "Apache-2.0",
  "author": "onmax <maximogarciamtnez@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vite-hub/vitehub.git",
    "directory": "packages/cli"
  },
  "bin": {
    "vitehub": "./dist/index.js"
  },
  "files": [
    "dist",
    "package.json"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "typecheck": "vp run --cache -t @vite-hub/cli#build && node ../../test/package-typecheck.mjs --noEmit -p ./tsconfig.json",
    "test": "vp run -t @vite-hub/cli#build && vp test"
  },
  "dependencies": {
    "@vite-hub/runtime": "workspace:*",
    "nostics": "catalog:runtime",
    "pathe": "catalog:unjs"
  },
  "devDependencies": {
    "@types/node": "catalog:tooling",
    "@vite-hub/internal": "workspace:*",
    "typescript": "catalog:tooling",
    "valibot": "catalog:runtime",
    "vite": "catalog:vite",
    "vite-plus": "catalog:tooling",
    "vitest": "catalog:tooling"
  },
  "peerDependencies": {
    "nuxt": "catalog:nuxt-compat",
    "vite": "catalog:vite-compat"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "peerDependenciesMeta": {
    "nuxt": {
      "optional": true
    }
  }
}
