{
  "name": "@vite-hub/database",
  "version": "0.0.1",
  "description": "Vite-first Drizzle database primitives for ViteHub.",
  "keywords": [
    "database",
    "db",
    "drizzle",
    "sqlite",
    "vite",
    "vitehub"
  ],
  "homepage": "https://github.com/vite-hub/vitehub#readme",
  "bugs": "https://github.com/vite-hub/vitehub/issues",
  "license": "Apache-2.0",
  "author": "onmax <maximogarciamtnez@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vite-hub/vitehub.git",
    "directory": "packages/database"
  },
  "files": [
    "dist",
    "package.json"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "imports": {
    "#vitehub/database/databases": "./dist/runtime/virtual-databases.js",
    "#vitehub/database/definition-defaults": "./dist/runtime/definition-defaults.js",
    "#vitehub/database/definition-runtime": {
      "vitehub-hosted": "./dist/runtime/definition-hosted.js",
      "default": "./dist/runtime/definition-local.js"
    },
    "#vitehub/database/schema": "./dist/runtime/virtual-schema.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./cli": "./dist/cli.js",
    "./config": "./dist/config.js",
    "./drizzle": "./dist/drizzle.js",
    "./nuxt": "./dist/nuxt.js",
    "./runtime/agent": "./dist/runtime/agent.js",
    "./runtime/cloudflare-vite": "./dist/runtime/cloudflare-vite.js",
    "./runtime/hosted": "./dist/runtime/hosted.js",
    "./runtime/state": "./dist/runtime/state.js",
    "./runtime/vercel-vite": "./dist/runtime/vercel-vite.js",
    "./runtime/virtual-databases": "./dist/runtime/virtual-databases.js",
    "./runtime/virtual-schema": "./dist/runtime/virtual-schema.js",
    "./virtual": "./dist/virtual.js",
    "./vite": "./dist/vite.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "typecheck": "tsc --noEmit -p ./tsconfig.json",
    "test": "vp run -t @vite-hub/database#build && vp test"
  },
  "dependencies": {
    "@libsql/client": "catalog:database",
    "esbuild": "catalog:tooling",
    "h3": "catalog:unjs",
    "pathe": "catalog:unjs"
  },
  "devDependencies": {
    "@vite-hub/env": "workspace:*",
    "@vite-hub/internal": "workspace:*",
    "drizzle-orm": "catalog:database",
    "publint": "catalog:tooling",
    "typescript": "catalog:tooling",
    "vite": "catalog:vite",
    "vite-plus": "catalog:tooling",
    "vitest": "catalog:tooling"
  },
  "peerDependencies": {
    "drizzle-kit": "catalog:database",
    "drizzle-orm": "catalog:database",
    "vite": "catalog:vite-compat"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
