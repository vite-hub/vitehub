{
  "name": "@vite-hub/database",
  "version": "0.1.0",
  "description": "Vite-first Drizzle database primitives for ViteHub.",
  "keywords": [
    "cloudflare",
    "d1",
    "database",
    "db",
    "drizzle",
    "drizzle-orm",
    "libsql",
    "nuxt",
    "nuxt-module",
    "postgres",
    "sqlite",
    "turso",
    "typescript",
    "vite",
    "vitehub"
  ],
  "homepage": "https://vitehub.dev",
  "bugs": "https://github.com/vite-hub/vitehub/issues",
  "license": "Apache-2.0",
  "author": "onmax <maximogarciamtnez@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vite-hub/vitehub.git",
    "directory": "packages/database"
  },
  "files": [
    "dist",
    "package.json"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "imports": {
    "#vitehub/database/databases": "./dist/runtime/virtual-databases.js",
    "#vitehub/database/definition-defaults": "./dist/runtime/definition-defaults.js",
    "#vitehub/database/definition-runtime": {
      "vitehub-hosted": "./dist/runtime/definition-hosted.js",
      "default": "./dist/runtime/definition-local.js"
    },
    "#vitehub/database/libsql": "./dist/runtime/libsql.js",
    "#vitehub/database/migrations": "./dist/runtime/virtual-migrations.js",
    "#vitehub/database/schema": "./dist/runtime/virtual-schema.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js",
      "default": "./dist/cli.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js",
      "default": "./dist/config.js"
    },
    "./connect": {
      "types": "./dist/connect.d.ts",
      "import": "./dist/connect.js",
      "default": "./dist/connect.js"
    },
    "./connect/node": {
      "types": "./dist/connect/node.d.ts",
      "import": "./dist/connect/node.js",
      "default": "./dist/connect/node.js"
    },
    "./durability": {
      "types": "./dist/durability.d.ts",
      "import": "./dist/durability.js",
      "default": "./dist/durability.js"
    },
    "./nuxt": {
      "types": "./dist/nuxt.d.ts",
      "import": "./dist/nuxt.js",
      "default": "./dist/nuxt.js"
    },
    "./runtime/libsql-drizzle": {
      "types": "./dist/runtime/libsql-drizzle.d.ts",
      "import": "./dist/runtime/libsql-drizzle.js",
      "default": "./dist/runtime/libsql-drizzle.js"
    },
    "./runtime/postgres-connection": {
      "types": "./dist/runtime/postgres-connection.d.ts",
      "import": "./dist/runtime/postgres-connection.js",
      "default": "./dist/runtime/postgres-connection.js"
    },
    "./runtime/registry": {
      "types": "./dist/runtime/registry.d.ts",
      "import": "./dist/runtime/registry.js",
      "default": "./dist/runtime/registry.js"
    },
    "./runtime/request-stats": {
      "types": "./dist/runtime/request-stats.d.ts",
      "import": "./dist/runtime/request-stats.js",
      "default": "./dist/runtime/request-stats.js"
    },
    "./runtime/state": {
      "types": "./dist/runtime/state.d.ts",
      "import": "./dist/runtime/state.js",
      "default": "./dist/runtime/state.js"
    },
    "./virtual": {
      "types": "./dist/virtual.d.ts",
      "import": "./dist/virtual.js",
      "default": "./dist/virtual.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js",
      "default": "./dist/vite.js"
    },
    "./package.json": "./package.json",
    "./runtime/cloudflare-env": {
      "types": "./dist/runtime/state.d.ts",
      "import": "./dist/runtime/state.js",
      "default": "./dist/runtime/state.js"
    }
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "typecheck": "vp run --cache -t @vite-hub/database#build && node ../../test/package-typecheck.mjs --noEmit -p ./tsconfig.json",
    "test": "vp run --cache -t @vite-hub/database#build && vp test"
  },
  "dependencies": {
    "@libsql/client": "catalog:database",
    "@sqlite.org/sqlite-wasm": "catalog:database",
    "@vite-hub/runtime": "workspace:*",
    "@vite-hub/web-container": "workspace:*",
    "get-tsconfig": "^4.14.3",
    "jiti": "catalog:unjs",
    "nostics": "catalog:runtime",
    "pathe": "catalog:unjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "catalog:database",
    "@types/node": "catalog:tooling",
    "@vite-hub/env": "workspace:*",
    "@vite-hub/internal": "workspace:*",
    "drizzle-kit": "catalog:database",
    "drizzle-orm": "catalog:database",
    "esbuild": "catalog:tooling",
    "publint": "catalog:tooling",
    "typescript": "catalog:tooling",
    "vite": "catalog:vite",
    "vite-plus": "catalog:tooling",
    "vitest": "catalog:tooling",
    "postgres": "catalog:database"
  },
  "peerDependencies": {
    "@electric-sql/pglite": "catalog:database",
    "drizzle-kit": ">=1.0.0-rc.5 <2.0.0",
    "drizzle-orm": ">=1.0.0-rc.5 <2.0.0",
    "postgres": "catalog:database",
    "vite": "catalog:vite-compat"
  },
  "peerDependenciesMeta": {
    "@electric-sql/pglite": {
      "optional": true
    },
    "drizzle-kit": {
      "optional": true
    },
    "postgres": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
