{
  "name": "@vite-hub/database",
  "version": "0.0.4",
  "description": "Vite-first Drizzle database primitives for ViteHub.",
  "keywords": [
    "database",
    "db",
    "drizzle",
    "sqlite",
    "vite",
    "vitehub"
  ],
  "homepage": "https://github.com/vite-hub/vitehub#readme",
  "bugs": "https://github.com/vite-hub/vitehub/issues",
  "license": "Apache-2.0",
  "author": "onmax <maximogarciamtnez@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vite-hub/vitehub.git",
    "directory": "packages/database"
  },
  "files": [
    "dist",
    "package.json"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "imports": {
    "#vitehub/database/databases": "./dist/runtime/virtual-databases.js",
    "#vitehub/database/definition-defaults": "./dist/runtime/definition-defaults.js",
    "#vitehub/database/definition-runtime": {
      "vitehub-hosted": "./dist/runtime/definition-hosted.js",
      "default": "./dist/runtime/definition-local.js"
    },
    "#vitehub/database/schema": "./dist/runtime/virtual-schema.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js"
    },
    "./drizzle": {
      "types": "./dist/drizzle.d.ts",
      "import": "./dist/drizzle.js"
    },
    "./nuxt": {
      "types": "./dist/nuxt.d.ts",
      "import": "./dist/nuxt.js"
    },
    "./runtime/agent": {
      "types": "./dist/runtime/agent.d.ts",
      "import": "./dist/runtime/agent.js"
    },
    "./runtime/cloudflare-vite": {
      "types": "./dist/runtime/cloudflare-vite.d.ts",
      "import": "./dist/runtime/cloudflare-vite.js"
    },
    "./runtime/d1": {
      "types": "./dist/runtime/d1.d.ts",
      "import": "./dist/runtime/d1.js"
    },
    "./runtime/hosted": {
      "types": "./dist/runtime/hosted.d.ts",
      "import": "./dist/runtime/hosted.js"
    },
    "./runtime/state": {
      "types": "./dist/runtime/state.d.ts",
      "import": "./dist/runtime/state.js"
    },
    "./runtime/vercel-vite": {
      "types": "./dist/runtime/vercel-vite.d.ts",
      "import": "./dist/runtime/vercel-vite.js"
    },
    "./runtime/virtual-databases": {
      "types": "./dist/runtime/virtual-databases.d.ts",
      "import": "./dist/runtime/virtual-databases.js"
    },
    "./runtime/virtual-schema": {
      "types": "./dist/runtime/virtual-schema.d.ts",
      "import": "./dist/runtime/virtual-schema.js"
    },
    "./virtual": {
      "types": "./dist/virtual.d.ts",
      "import": "./dist/virtual.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    },
    "./package.json": "./package.json",
    "./runtime/cloudflare-env": {
      "types": "./dist/runtime/state.d.ts",
      "import": "./dist/runtime/state.js"
    }
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "typecheck": "tsc --noEmit -p ./tsconfig.json",
    "test": "vp run -t @vite-hub/database#build && vp test"
  },
  "dependencies": {
    "@libsql/client": "catalog:database",
    "esbuild": "catalog:tooling",
    "h3": "catalog:unjs",
    "nostics": "catalog:runtime",
    "pathe": "catalog:unjs"
  },
  "devDependencies": {
    "@vite-hub/env": "workspace:*",
    "@vite-hub/internal": "workspace:*",
    "drizzle-orm": "catalog:database",
    "publint": "catalog:tooling",
    "typescript": "catalog:tooling",
    "vite": "catalog:vite",
    "vite-plus": "catalog:tooling",
    "vitest": "catalog:tooling"
  },
  "peerDependencies": {
    "drizzle-kit": "catalog:database",
    "drizzle-orm": "catalog:database",
    "vite": "catalog:vite-compat"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
