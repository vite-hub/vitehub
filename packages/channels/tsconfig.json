{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "rootDir": "..",
    "types": [
      "node",
      "vitest/globals"
    ],
    "baseUrl": "../..",
    "paths": {
      "#vitehub/channels/registry": [
        "packages/channels/src/runtime/empty-registry.ts"
      ],
      "#vitehub/channels/runtime": [
        "packages/channels/src/runtime/empty-runtime.ts"
      ],
      "@vite-hub/internal/*": [
        "packages/internal/src/*.ts"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts",
    "test/**/*.test-d.ts"
  ],
  "exclude": [
    "dist"
  ]
}
