{
  "name": "@vite-hub/ci",
  "version": "0.0.1",
  "description": "Provider-agnostic CI and deployment status/log primitives for ViteHub.",
  "author": "onmax <maximogarciamtnez@gmail.com>",
  "license": "Apache-2.0",
  "homepage": "https://github.com/vite-hub/vitehub#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vite-hub/vitehub.git",
    "directory": "packages/ci"
  },
  "bugs": "https://github.com/vite-hub/vitehub/issues",
  "keywords": [
    "vitehub",
    "ci",
    "deployments",
    "cloudflare",
    "vercel",
    "github-actions"
  ],
  "sideEffects": false,
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./cloudflare": "./dist/providers/cloudflare.js",
    "./github": "./dist/providers/github.js",
    "./logs": "./dist/logs/error-extraction.js",
    "./vercel": "./dist/providers/vercel.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "package.json"
  ],
  "scripts": {
    "build": "tsdown --tsconfig tsconfig.build.json",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit -p ./tsconfig.json",
    "test": "pnpm --filter @vite-hub/ci build && vitest run"
  },
  "dependencies": {
    "ofetch": "catalog:",
    "ufo": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsdown": "^0.21.8",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
