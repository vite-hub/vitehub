{
  "name": "@vite-hub/ci",
  "version": "0.0.1",
  "description": "Provider-agnostic CI and deployment status/log primitives for ViteHub.",
  "keywords": [
    "ci",
    "cloudflare",
    "deployments",
    "github-actions",
    "vercel",
    "vitehub"
  ],
  "homepage": "https://github.com/vite-hub/vitehub#readme",
  "bugs": "https://github.com/vite-hub/vitehub/issues",
  "license": "Apache-2.0",
  "author": "onmax <maximogarciamtnez@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vite-hub/vitehub.git",
    "directory": "packages/ci"
  },
  "files": [
    "dist",
    "package.json"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./cloudflare": "./dist/providers/cloudflare.js",
    "./github": "./dist/providers/github.js",
    "./logs": "./dist/logs/error-extraction.js",
    "./vercel": "./dist/providers/vercel.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "typecheck": "tsc --noEmit -p ./tsconfig.json",
    "test": "vp run -t @vite-hub/ci#build && vp test"
  },
  "dependencies": {
    "ofetch": "catalog:unjs",
    "ufo": "catalog:unjs"
  },
  "devDependencies": {
    "@types/node": "catalog:tooling",
    "typescript": "catalog:tooling",
    "vite-plus": "catalog:tooling",
    "vitest": "catalog:tooling"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
