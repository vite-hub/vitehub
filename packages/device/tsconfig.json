{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "forceConsistentCasingInFileNames": true,
    "rootDir": "..",
    // Device runs in the browser: it reads IndexedDB and BroadcastChannel.
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "paths": {
      "@vite-hub/internal/*": [
        "../../packages/internal/src/*.ts"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts",
    "test/**/*.ts",
    "test/**/*.test-d.ts"
  ],
  "exclude": [
    "dist",
    "docs",
    "examples",
    "node_modules",
    "test/fixtures"
  ]
}
