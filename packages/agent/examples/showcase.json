            "run": "src/server.ts"
          },
          "supplementalFiles": [
            "README.md",
            "package.json"
          ]
        },
        "build": {
          "phases": {
            "configure": "vite.config.ts",
            "define": "server/agents/greeting.ts",
            "run": "src/server.ts"
          },
          "supplementalFiles": [
            "README.md",
            "package.json"
          ]
        }
      }
    }
  }
}
