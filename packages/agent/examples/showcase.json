{
  "label": "Agent",
  "description": "A credential-free Agent Definition with local discovery and invocation.",
  "icon": "i-lucide-bot",
  "order": 1,
  "defaultPhase": "define",
  "frameworks": {
    "vite": {
      "modes": {
        "dev": {
          "phases": {
            "configure": "vite.config.ts",
