{
  "name": "@vitehub/agent",
  "version": "0.0.0",
  "description": "Agent DX layer and Vite/Nitro integration for ViteHub.",
  "author": "onmax <maximogarciamtnez@gmail.com>",
  "license": "Apache-2.0",
  "homepage": "https://github.com/vite-hub/vitehub#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vite-hub/vitehub.git",
    "directory": "packages/agent"
  },
  "bugs": "https://github.com/vite-hub/vitehub/issues",
  "keywords": [
    "vitehub",
    "vite",
    "nitro",
    "agent",
    "ai",
    "cloudflare",
    "vercel"
  ],
  "sideEffects": false,
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./ai-sdk": "./dist/ai-sdk.js",
    "./capabilities": "./dist/capabilities.js",
    "./capability-runtime": "./dist/capability-runtime.js",
    "./chat": "./dist/chat/index.js",
    "./chat/cloudflare": "./dist/chat/cloudflare.js",
    "./chat/devtools": "./dist/chat/devtools.js",
    "./chat/nitro": "./dist/chat/nitro.js",
    "./chat/presets": "./dist/chat/presets.js",
    "./chat/runtime/agent-chat": "./dist/chat/runtime/agent-chat.js",
    "./chat/runtime/chat-devtools-handler": "./dist/chat/runtime/chat-devtools-handler.js",
    "./chat/runtime/cloudflare-workers-dev": "./dist/chat/runtime/cloudflare-workers-dev.js",
    "./chat/runtime/memory-state": "./dist/chat/runtime/memory-state.js",
    "./chat/runtime/nitro-dev-initialize": "./dist/chat/runtime/nitro-dev-initialize.js",
    "./chat/runtime/nitro-plugin": "./dist/chat/runtime/nitro-plugin.js",
    "./chat/runtime/nitro-runtime-config": "./dist/chat/runtime/nitro-runtime-config.js",
    "./chat/vercel": "./dist/chat/vercel.js",
    "./chat/vite": "./dist/chat/vite.js",
    "./cloudflare": "./dist/cloudflare.js",
    "./memory": "./dist/memory.js",
    "./messages": "./dist/messages.js",
    "./nitro": "./dist/nitro.js",
    "./runtime/chat-devtools-handler": "./dist/runtime/chat-devtools-handler.js",
    "./runtime/empty-registry": "./dist/runtime/empty-registry.js",
    "./runtime/nitro-runtime-config": "./dist/runtime/nitro-runtime-config.js",
    "./tanstack-ai": "./dist/tanstack-ai.js",
    "./test": "./dist/test.js",
    "./vercel": "./dist/vercel.js",
    "./vite": "./dist/vite.js",
    "./package.json": "./package.json"
  },
  "imports": {
    "#vitehub/agent/registry": {
      "types": "./dist/runtime/empty-registry.d.ts",
      "default": "./dist/runtime/empty-registry.js"
    },
    "#vitehub/agent/chat/registry": {
      "types": "./dist/runtime/empty-registry.d.ts",
      "default": "./dist/runtime/empty-registry.js"
    }
  },
  "files": [
    "dist",
    "package.json"
  ],
  "scripts": {
    "build": "tsdown --tsconfig tsconfig.build.json",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit -p ./tsconfig.json",
    "test": "pnpm --filter @vitehub/agent... build && vitest run"
  },
  "dependencies": {
    "@vitehub/runtime": "workspace:*",
    "@vitehub/workflow": "workspace:*",
    "@vitehub/workspace": "workspace:*",
    "@vercel/functions": "catalog:",
    "chat": "catalog:",
    "chat-state-cloudflare-do": "^0.2.0",
    "h3": "catalog:",
    "hookable": "^6.1.1"
  },
  "peerDependencies": {
    "agents": "^0.12.3",
    "@tanstack/ai": "0.16.0",
    "ai": "^6.0.0",
    "@vitejs/devtools-kit": ">=0.2.0",
    "nitro": "^3.0.0-0",
    "vite": ">=8.0.0"
  },
  "peerDependenciesMeta": {
    "agents": {
      "optional": true
    },
    "@tanstack/ai": {
      "optional": true
    },
    "ai": {
      "optional": true
    },
    "@vitejs/devtools-kit": {
      "optional": true
    },
    "nitro": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vitehub/devtools": "workspace:*",
    "@vitehub/internal": "workspace:*",
    "@tanstack/ai": "0.16.0",
    "@vitejs/devtools-kit": "catalog:",
    "ai": "^6.0.172",
    "nitro": "catalog:",
    "publint": "^0.3.15",
    "tsdown": "^0.21.8",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
