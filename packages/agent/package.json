{
  "name": "@vitehub/agent",
  "version": "0.0.0",
  "description": "Agent DX layer and Vite/Nitro integration for ViteHub.",
  "author": "onmax <maximogarciamtnez@gmail.com>",
  "license": "Apache-2.0",
  "homepage": "https://github.com/vite-hub/vitehub#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vite-hub/vitehub.git",
    "directory": "packages/agent"
  },
  "bugs": "https://github.com/vite-hub/vitehub/issues",
  "keywords": [
    "vitehub",
    "vite",
    "nitro",
    "agent",
    "ai",
    "cloudflare",
    "vercel"
  ],
  "sideEffects": false,
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./capabilities": "./dist/capabilities.js",
    "./chat/devtools": "./dist/chat/devtools.js",
    "./chat/runtime/agent-chat": "./dist/chat/runtime/agent-chat.js",
    "./chat/runtime/chat-devtools-handler": "./dist/chat/runtime/chat-devtools-handler.js",
    "./chat/runtime/workspace-state": "./dist/chat/runtime/workspace-state.js",
    "./cloudflare": "./dist/cloudflare.js",
    "./nitro": "./dist/nitro.js",
    "./runtime/empty-registry": "./dist/runtime/empty-registry.js",
    "./runtime/nitro-runtime-config": "./dist/runtime/nitro-runtime-config.js",
    "./test": "./dist/test.js",
    "./vercel": "./dist/vercel.js",
    "./vite": "./dist/vite.js",
    "./package.json": "./package.json"
  },
  "imports": {
    "#vitehub/agent/registry": {
      "types": "./dist/runtime/empty-registry.d.ts",
      "default": "./dist/runtime/empty-registry.js"
    }
  },
  "files": [
    "devtools-client",
    "dist",
    "package.json"
  ],
  "scripts": {
    "build": "tsdown --tsconfig tsconfig.build.json",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit -p ./tsconfig.json",
    "test": "pnpm --filter @vitehub/agent... build && vitest run"
  },
  "dependencies": {
    "@vitehub/runtime": "workspace:*",
    "@vitehub/workspace": "workspace:*",
    "@vitejs/devtools-kit": "catalog:",
    "@vercel/functions": "catalog:",
    "chat": "catalog:",
    "h3": "catalog:"
  },
  "peerDependencies": {
    "agents": "^0.12.3",
    "@ai-sdk/mcp": "^1.0.36",
    "@tanstack/ai": "0.16.0",
    "@vitehub/db": "workspace:*",
    "@vitehub/kv": "workspace:*",
    "ai": "^6.0.0",
    "chat-state-cloudflare-do": "^0.2.0",
    "nitro": "^3.0.0-0",
    "vite": ">=8.0.0",
    "@vitehub/devtools": "workspace:*"
  },
  "peerDependenciesMeta": {
    "agents": {
      "optional": true
    },
    "@ai-sdk/mcp": {
      "optional": true
    },
    "@tanstack/ai": {
      "optional": true
    },
    "@vitehub/db": {
      "optional": true
    },
    "@vitehub/kv": {
      "optional": true
    },
    "ai": {
      "optional": true
    },
    "chat-state-cloudflare-do": {
      "optional": true
    },
    "nitro": {
      "optional": true
    },
    "vite": {
      "optional": true
    },
    "@vitehub/devtools": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@ai-sdk/mcp": "^1.0.36",
    "@vitehub/internal": "workspace:*",
    "@tanstack/ai": "0.16.0",
    "@vitehub/db": "workspace:*",
    "@vitehub/kv": "workspace:*",
    "ai": "^6.0.172",
    "nitro": "catalog:",
    "publint": "^0.3.15",
    "tsdown": "^0.21.8",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "@vitehub/devtools": "workspace:*"
  }
}
