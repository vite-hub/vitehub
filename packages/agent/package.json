{
  "name": "@vite-hub/agent",
  "version": "0.0.0",
  "description": "Agent DX layer and Vite/Nitro integration for ViteHub.",
  "author": "onmax <maximogarciamtnez@gmail.com>",
  "license": "Apache-2.0",
  "homepage": "https://github.com/vite-hub/vitehub#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vite-hub/vitehub.git",
    "directory": "packages/agent"
  },
  "bugs": "https://github.com/vite-hub/vitehub/issues",
  "keywords": [
    "vitehub",
    "vite",
    "nitro",
    "agent",
    "ai",
    "cloudflare",
    "vercel"
  ],
  "sideEffects": false,
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./ai-sdk": "./dist/ai-sdk.js",
    "./capabilities": "./dist/capabilities.js",
    "./capability-runtime": "./dist/capability-runtime.js",
    "./cli": "./dist/cli.js",
    "./cloudflare": "./dist/cloudflare.js",
    "./eval": "./dist/eval.js",
    "./mcp": "./dist/mcp.js",
    "./mcp/stdio": "./dist/mcp/stdio.js",
    "./memory": "./dist/memory.js",
    "./messages": "./dist/messages.js",
    "./nitro": "./dist/nitro.js",
    "./runtime/chat-devtools-handler": "./dist/runtime/chat-devtools-handler.js",
    "./runtime/empty-registry": "./dist/runtime/empty-registry.js",
    "./runtime/nitro-runtime-config": "./dist/runtime/nitro-runtime-config.js",
    "./test": "./dist/test.js",
    "./vercel": "./dist/vercel.js",
    "./vite": "./dist/vite.js",
    "./package.json": "./package.json"
  },
  "imports": {
    "#vitehub/agent/registry": {
      "types": "./dist/runtime/empty-registry.d.ts",
      "default": "./dist/runtime/empty-registry.js"
    }
  },
  "files": [
    "dist",
    "package.json"
  ],
  "scripts": {
    "build": "tsdown --tsconfig tsconfig.build.json",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit -p ./tsconfig.json",
    "test": "pnpm --filter @vite-hub/agent... build && vitest run"
  },
  "dependencies": {
    "@vite-hub/runtime": "workspace:*",
    "@vite-hub/workflow": "workspace:*",
    "@vite-hub/workspace": "workspace:*",
    "@vite-hub/devtools": "workspace:*",
    "@vercel/functions": "catalog:",
    "@vitejs/devtools-kit": "catalog:",
    "chat": "catalog:",
    "chat-state-cloudflare-do": "^0.2.0",
    "h3": "catalog:",
    "hookable": "^6.1.1"
  },
  "peerDependencies": {
    "@ai-sdk/mcp": "^1.0.36",
    "agents": "^0.12.3",
    "ai": "^6.0.0",
    "evalite": "1.0.0-beta.16",
    "nitro": "^3.0.0-0",
    "vite": ">=8.0.0"
  },
  "peerDependenciesMeta": {
    "@ai-sdk/mcp": {
      "optional": true
    },
    "agents": {
      "optional": true
    },
    "ai": {
      "optional": true
    },
    "evalite": {
      "optional": true
    },
    "nitro": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ai-sdk/mcp": "^1.0.36",
    "@types/node": "catalog:",
    "@vite-hub/internal": "workspace:*",
    "@vitejs/devtools-kit": "catalog:",
    "ai": "^6.0.172",
    "evalite": "catalog:",
    "nitro": "catalog:",
    "publint": "^0.3.15",
    "tsdown": "^0.21.8",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
