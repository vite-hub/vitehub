{
  "name": "@vite-hub/agent",
  "version": "0.0.1",
  "description": "Agent DX layer and Vite integration for ViteHub.",
  "keywords": [
    "agent",
    "ai",
    "cloudflare",
    "vercel",
    "vite",
    "vitehub"
  ],
  "homepage": "https://github.com/vite-hub/vitehub#readme",
  "bugs": "https://github.com/vite-hub/vitehub/issues",
  "license": "Apache-2.0",
  "author": "onmax <maximogarciamtnez@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vite-hub/vitehub.git",
    "directory": "packages/agent"
  },
  "files": [
    "dist",
    "package.json"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "imports": {
    "#vitehub/agent/registry": {
      "types": "./dist/runtime/empty-registry.d.ts",
      "default": "./dist/runtime/empty-registry.js"
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./ai-sdk": {
      "types": "./dist/ai-sdk.d.ts",
      "import": "./dist/ai-sdk.js"
    },
    "./capabilities": {
      "types": "./dist/capabilities.d.ts",
      "import": "./dist/capabilities.js"
    },
    "./channels": {
      "types": "./dist/channels.d.ts",
      "import": "./dist/channels.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js"
    },
    "./cloudflare": {
      "types": "./dist/cloudflare.d.ts",
      "import": "./dist/cloudflare.js"
    },
    "./cloudflare/state": {
      "types": "./dist/cloudflare/state.d.ts",
      "import": "./dist/cloudflare/state.js"
    },
    "./eval": {
      "types": "./dist/eval.d.ts",
      "import": "./dist/eval.js"
    },
    "./harness/claude-code": {
      "types": "./dist/harness/claude-code.d.ts",
      "import": "./dist/harness/claude-code.js"
    },
    "./harness/codex": {
      "types": "./dist/harness/codex.d.ts",
      "import": "./dist/harness/codex.js"
    },
    "./harness/local-sandbox": {
      "types": "./dist/harness/local-sandbox.d.ts",
      "import": "./dist/harness/local-sandbox.js"
    },
    "./mcp": {
      "types": "./dist/mcp.d.ts",
      "import": "./dist/mcp.js"
    },
    "./mcp/stdio": {
      "types": "./dist/mcp/stdio.d.ts",
      "import": "./dist/mcp/stdio.js"
    },
    "./messages": {
      "types": "./dist/messages.d.ts",
      "import": "./dist/messages.js"
    },
    "./output": {
      "types": "./dist/output.d.ts",
      "import": "./dist/output.js"
    },
    "./runtime/empty-registry": {
      "types": "./dist/runtime/empty-registry.d.ts",
      "import": "./dist/runtime/empty-registry.js"
    },
    "./runtime/workflow": {
      "types": "./dist/runtime/workflow.d.ts",
      "import": "./dist/runtime/workflow.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./server/internal": {
      "types": "./dist/server/internal.d.ts",
      "import": "./dist/server/internal.js"
    },
    "./server/workspace": {
      "types": "./dist/server/workspace.d.ts",
      "import": "./dist/server/workspace.js"
    },
    "./state/sqlite": {
      "types": "./dist/state/sqlite.d.ts",
      "import": "./dist/state/sqlite.js"
    },
    "./test": {
      "types": "./dist/test.d.ts",
      "import": "./dist/test.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "typecheck": "tsc --noEmit -p ./tsconfig.json",
    "test": "vp run -t @vite-hub/agent#build && vp test"
  },
  "dependencies": {
    "@libsql/client": "catalog:database",
    "@standard-schema/spec": "catalog:runtime",
    "@types/json-schema": "catalog:ai",
    "@vercel/nft": "catalog:vercel",
    "@vite-hub/box": "workspace:*",
    "@vite-hub/markdown-template": "workspace:*",
    "@vite-hub/rate-limit": "workspace:*",
    "@vite-hub/runtime": "workspace:*",
    "@vite-hub/workspace": "workspace:*",
    "chat": "catalog:chat",
    "comark": "catalog:ui",
    "esbuild": "catalog:esbuild-v27",
    "effect": "catalog:effect"
  },
  "devDependencies": {
    "@ai-sdk/harness": "catalog:ai",
    "@ai-sdk/harness-claude-code": "catalog:ai",
    "@ai-sdk/harness-codex": "catalog:ai",
    "@ai-sdk/mcp": "catalog:ai",
    "@chat-adapter/discord": "catalog:chat",
    "@types/node": "catalog:tooling",
    "@vercel/functions": "catalog:vercel",
    "@vite-hub/internal": "workspace:*",
    "@vite-hub/schedule": "workspace:*",
    "@vite-hub/workflow": "workspace:*",
    "ai": "catalog:ai",
    "askweb": "catalog:ai",
    "evalite": "catalog:ai",
    "publint": "catalog:tooling",
    "typescript": "catalog:tooling",
    "vite": "catalog:vite",
    "vite-plus": "catalog:tooling",
    "vitest": "catalog:tooling"
  },
  "peerDependencies": {
    "@ai-sdk/harness": "catalog:ai-compat",
    "@ai-sdk/harness-claude-code": "catalog:ai",
    "@ai-sdk/harness-codex": "catalog:ai-compat",
    "@ai-sdk/mcp": "catalog:ai",
    "@chat-adapter/discord": "catalog:chat",
    "@vercel/functions": "catalog:vercel",
    "@vite-hub/blob": "workspace:*",
    "@vite-hub/email": "workspace:*",
    "@vite-hub/schedule": "workspace:*",
    "@vite-hub/workflow": "workspace:*",
    "ai": "catalog:ai-compat",
    "askweb": "catalog:ai",
    "vite": "catalog:vite-compat",
    "vitest": "catalog:tooling"
  },
  "peerDependenciesMeta": {
    "@ai-sdk/harness": {
      "optional": true
    },
    "@ai-sdk/harness-claude-code": {
      "optional": true
    },
    "@ai-sdk/harness-codex": {
      "optional": true
    },
    "@ai-sdk/mcp": {
      "optional": true
    },
    "@chat-adapter/discord": {
      "optional": true
    },
    "@vercel/functions": {
      "optional": true
    },
    "@vite-hub/blob": {
      "optional": true
    },
    "@vite-hub/email": {
      "optional": true
    },
    "@vite-hub/schedule": {
      "optional": true
    },
    "@vite-hub/workflow": {
      "optional": true
    },
    "ai": {
      "optional": true
    },
    "askweb": {
      "optional": true
    },
    "vite": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24.15.0"
  }
}
