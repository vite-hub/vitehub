{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "#vitehub/agent/registry": ["./src/runtime/empty-registry.ts"],
      "@vitehub/workspace": ["../workspace/src/index.ts"]
    },
    "rootDir": ".."
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts",
    "test/**/*.ts",
    "test/**/*.test-d.ts"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ]
}
