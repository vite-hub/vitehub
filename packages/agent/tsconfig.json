{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "#vitehub/agent/registry": [
        "packages/agent/src/runtime/empty-registry.ts"
      ],
      "#vitehub-sandbox-provider-loader": [
        "packages/sandbox/src/runtime/provider-loader.ts"
      ],
      "virtual:vitehub-sandbox-provider-loader": [
        "packages/sandbox/src/runtime/provider-loader.ts"
      ],
      "vitehub-sandbox-provider-loader": [
        "packages/sandbox/src/runtime/provider-loader.ts"
      ],
      "@vite-hub/sandbox/runtime/provider-loader": [
        "packages/sandbox/src/runtime/provider-loader.ts"
      ],
      "#vitehub-sandbox-registry": [
        "packages/sandbox/src/runtime/empty-registry.ts"
      ],
      "#vitehub-workspace-assets-registry": [
        "packages/workspace/src/runtime/empty-assets-registry.ts"
      ],
      "#vitehub-workspace-registry": [
        "packages/workspace/src/runtime/empty-registry.ts"
      ],
      "@vite-hub/internal/*": [
        "packages/internal/src/*.ts"
      ],
      "@vite-hub/agent": [
        "packages/agent/src/index.ts"
      ],
      "@vite-hub/agent/*": [
        "packages/agent/src/*"
      ],
      "@vite-hub/devtools": [
        "packages/devtools/src/index.ts"
      ],
      "@vite-hub/devtools/*": [
        "packages/devtools/src/*.ts"
      ],
      "@vite-hub/runtime": [
        "packages/runtime/src/index.ts"
      ],
      "@vite-hub/sandbox": [
        "packages/sandbox/src/index.ts"
      ],
      "@vite-hub/sandbox/runtime/state": [
        "packages/sandbox/src/runtime/state.ts"
      ],
      "@vite-hub/shell": [
        "packages/shell/src/index.ts"
      ],
      "@vite-hub/shell/providers/just-bash": [
        "packages/shell/src/providers/just-bash.ts"
      ],
      "@vite-hub/shell/workspace": [
        "packages/shell/src/workspace/index.ts"
      ],
      "@vite-hub/source": [
        "packages/source/src/index.ts"
      ],
      "@vite-hub/workspace": [
        "packages/workspace/src/index.ts"
      ],
      "@vite-hub/workspace/*": [
        "packages/workspace/src/*"
      ],
      "@vite-hub/workspace/internal/runtime/state": [
        "packages/workspace/src/runtime/state.ts"
      ],
      "@vite-hub/workflow": [
        "packages/workflow/src/index.ts"
      ],
      "@vite-hub/workflow/runtime/state": [
        "packages/workflow/src/runtime/state.ts"
      ]
    },
    "rootDir": "..",
    "baseUrl": "../.."
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts",
    "test/**/*.ts",
    "test/**/*.test-d.ts"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ]
}
