{
  "name": "@vite-hub/content",
  "version": "0.0.1",
  "description": "Comark Content runtime integration for ViteHub Sources.",
  "keywords": [
    "comark",
    "content",
    "markdown",
    "vitehub"
  ],
  "homepage": "https://github.com/vite-hub/vitehub#readme",
  "bugs": "https://github.com/vite-hub/vitehub/issues",
  "license": "Apache-2.0",
  "author": "onmax <maximogarciamtnez@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vite-hub/vitehub.git",
    "directory": "packages/content"
  },
  "files": [
    "dist",
    "package.json"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "typecheck": "tsc --noEmit -p ./tsconfig.json",
    "test": "vp run -t @vite-hub/content#build && vp test"
  },
  "dependencies": {
    "@vite-hub/source": "workspace:*",
    "h3": "catalog:unjs"
  },
  "devDependencies": {
    "@types/node": "catalog:tooling",
    "comark-content": "catalog:markdown",
    "publint": "catalog:tooling",
    "typescript": "catalog:tooling",
    "vite-plus": "catalog:tooling",
    "vitest": "catalog:tooling"
  },
  "peerDependencies": {
    "comark-content": "catalog:markdown"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
