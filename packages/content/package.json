{
  "name": "@vite-hub/content",
  "version": "0.0.4",
  "description": "Comark Content runtime integration for ViteHub Sources, with editable document collections on Workspace history.",
  "keywords": [
    "comark",
    "content",
    "markdown",
    "vitehub"
  ],
  "homepage": "https://github.com/vite-hub/vitehub#readme",
  "bugs": "https://github.com/vite-hub/vitehub/issues",
  "license": "Apache-2.0",
  "author": "onmax <maximogarciamtnez@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vite-hub/vitehub.git",
    "directory": "packages/content"
  },
  "files": [
    "dist",
    "package.json"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "require": "./dist/client.js",
      "default": "./dist/client.js"
    },
    "./collections": {
      "types": "./dist/collections.d.ts",
      "import": "./dist/collections.js",
      "require": "./dist/collections.js",
      "default": "./dist/collections.js"
    },
    "./presets/cms": {
      "types": "./dist/presets/cms.d.ts",
      "import": "./dist/presets/cms.js",
      "require": "./dist/presets/cms.js",
      "default": "./dist/presets/cms.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js",
      "require": "./dist/vite.js",
      "default": "./dist/vite.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "typecheck": "vp run --cache -t @vite-hub/content#build && tsc --noEmit -p ./tsconfig.json",
    "test": "vp run -t @vite-hub/content#build && vp test"
  },
  "dependencies": {
    "@standard-schema/spec": "catalog:runtime",
    "@vite-hub/runtime": "workspace:*",
    "@vite-hub/source": "workspace:*",
    "h3": "catalog:unjs",
    "nostics": "catalog:runtime",
    "yaml": "catalog:tooling"
  },
  "devDependencies": {
    "@libsql/client": "catalog:database",
    "@types/node": "catalog:tooling",
    "@valibot/to-json-schema": "catalog:runtime",
    "@vite-hub/database": "workspace:*",
    "@vite-hub/internal": "workspace:*",
    "@vite-hub/workspace": "workspace:*",
    "comark-content": "catalog:markdown",
    "drizzle-orm": "catalog:database",
    "publint": "catalog:tooling",
    "typescript": "catalog:tooling",
    "valibot": "catalog:runtime",
    "vite": "catalog:vite",
    "vite-plus": "catalog:tooling",
    "vitest": "catalog:tooling",
    "zod": "catalog:runtime"
  },
  "peerDependencies": {
    "@vite-hub/database": "workspace:*",
    "@vite-hub/workspace": "workspace:*",
    "comark-content": "catalog:markdown",
    "vite": "catalog:vite-compat"
  },
  "peerDependenciesMeta": {
    "@vite-hub/database": {
      "optional": true
    },
    "@vite-hub/workspace": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
