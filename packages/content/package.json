{
  "name": "@vite-hub/content",
  "version": "0.0.4",
  "description": "Comark Content runtime integration for ViteHub Sources, with editable document collections on Workspace history.",
  "keywords": [
    "comark",
    "content",
    "markdown",
    "vitehub"
  ],
  "homepage": "https://github.com/vite-hub/vitehub#readme",
  "bugs": "https://github.com/vite-hub/vitehub/issues",
  "license": "Apache-2.0",
  "author": "onmax <maximogarciamtnez@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vite-hub/vitehub.git",
    "directory": "packages/content"
  },
  "files": [
    "dist",
    "package.json"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js",
      "require": "./dist/cli.js",
      "default": "./dist/cli.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "require": "./dist/client.js",
      "default": "./dist/client.js"
    },
    "./collections": {
      "types": "./dist/collections.d.ts",
      "import": "./dist/collections.js",
      "require": "./dist/collections.js",
      "default": "./dist/collections.js"
    },
    "./database": {
      "types": "./dist/database.d.ts",
      "import": "./dist/database.js",
      "require": "./dist/database.js",
      "default": "./dist/database.js"
    },
    "./editor": {
      "types": "./dist/editor.d.ts",
      "import": "./dist/editor.js",
      "require": "./dist/editor.js",
      "default": "./dist/editor.js"
    },
    "./operations": {
      "types": "./dist/operations.d.ts",
      "import": "./dist/operations.js",
      "require": "./dist/operations.js",
      "default": "./dist/operations.js"
    },
    "./presets/cms": {
      "types": "./dist/presets/cms.d.ts",
      "import": "./dist/presets/cms.js",
      "require": "./dist/presets/cms.js",
      "default": "./dist/presets/cms.js"
    },
    "./realtime": {
      "types": "./dist/realtime.d.ts",
      "import": "./dist/realtime.js",
      "require": "./dist/realtime.js",
      "default": "./dist/realtime.js"
    },
    "./runtime/console": {
      "types": "./dist/runtime/console.d.ts",
      "import": "./dist/runtime/console.js",
      "require": "./dist/runtime/console.js",
      "default": "./dist/runtime/console.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js",
      "require": "./dist/vite.js",
      "default": "./dist/vite.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "typecheck": "vp run --cache -t @vite-hub/content#build && node ../../node_modules/typescript-native/bin/tsc --noEmit -p ./tsconfig.json",
    "test": "vp run -t @vite-hub/content#build && vp test"
  },
  "dependencies": {
    "@standard-schema/spec": "catalog:runtime",
    "@valibot/to-json-schema": "catalog:runtime",
    "@vite-hub/blob": "workspace:*",
    "@vite-hub/runtime": "workspace:*",
    "@vite-hub/source": "workspace:*",
    "diff": "catalog:runtime",
    "h3": "catalog:unjs",
    "nostics": "catalog:runtime",
    "yaml": "catalog:tooling"
  },
  "devDependencies": {
    "@libsql/client": "catalog:database",
    "@tiptap/core": "catalog:realtime",
    "@tiptap/extension-code-block": "catalog:realtime",
    "@tiptap/extension-image": "catalog:realtime",
    "@tiptap/extension-table": "catalog:realtime",
    "@tiptap/pm": "catalog:realtime",
    "@tiptap/starter-kit": "catalog:realtime",
    "@types/node": "catalog:tooling",
    "@vite-hub/database": "workspace:*",
    "@vite-hub/internal": "workspace:*",
    "@vite-hub/realtime": "workspace:*",
    "@vite-hub/workspace": "workspace:*",
    "comark": "catalog:markdown",
    "comark-content": "catalog:markdown",
    "comark-tiptap": "catalog:markdown",
    "drizzle-orm": "catalog:database",
    "publint": "catalog:tooling",
    "typescript": "catalog:tooling",
    "valibot": "catalog:runtime",
    "vite": "catalog:vite",
    "vite-plus": "catalog:tooling",
    "vitest": "catalog:tooling",
    "zod": "catalog:runtime"
  },
  "peerDependencies": {
    "@tiptap/core": "catalog:realtime",
    "@tiptap/extension-code-block": "catalog:realtime",
    "@tiptap/extension-image": "catalog:realtime",
    "@tiptap/extension-table": "catalog:realtime",
    "@tiptap/pm": "catalog:realtime",
    "@tiptap/starter-kit": "catalog:realtime",
    "@vite-hub/database": "workspace:*",
    "@vite-hub/realtime": "workspace:*",
    "@vite-hub/workspace": "workspace:*",
    "comark": "catalog:markdown",
    "comark-content": "catalog:markdown",
    "comark-tiptap": "catalog:markdown",
    "drizzle-orm": "catalog:database",
    "vite": "catalog:vite-compat"
  },
  "peerDependenciesMeta": {
    "@tiptap/core": {
      "optional": true
    },
    "@tiptap/extension-code-block": {
      "optional": true
    },
    "@tiptap/extension-image": {
      "optional": true
    },
    "@tiptap/extension-table": {
      "optional": true
    },
    "@tiptap/pm": {
      "optional": true
    },
    "@tiptap/starter-kit": {
      "optional": true
    },
    "@vite-hub/database": {
      "optional": true
    },
    "@vite-hub/realtime": {
      "optional": true
    },
    "@vite-hub/workspace": {
      "optional": true
    },
    "comark": {
      "optional": true
    },
    "comark-tiptap": {
      "optional": true
    },
    "drizzle-orm": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
