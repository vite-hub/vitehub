{
  "name": "@vite-hub/vite",
  "version": "0.0.1",
  "description": "Preset Vite integration for ViteHub primitives.",
  "keywords": [
    "vite",
    "vitehub"
  ],
  "homepage": "https://github.com/vite-hub/vitehub#readme",
  "bugs": "https://github.com/vite-hub/vitehub/issues",
  "license": "Apache-2.0",
  "author": "onmax <maximogarciamtnez@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vite-hub/vitehub.git",
    "directory": "packages/vite"
  },
  "files": [
    "dist",
    "package.json"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./agent": "./dist/agent.js",
    "./agent/capabilities": "./dist/agent/capabilities.js",
    "./agent/channels": "./dist/agent/channels.js",
    "./agent/cloudflare": "./dist/agent/cloudflare.js",
    "./agent/cloudflare/state": "./dist/agent/cloudflare/state.js",
    "./agent/eval": "./dist/agent/eval.js",
    "./agent/harness/local-sandbox": "./dist/agent/harness/local-sandbox.js",
    "./agent/mcp": "./dist/agent/mcp.js",
    "./agent/mcp/stdio": "./dist/agent/mcp/stdio.js",
    "./agent/runtime/workflow": "./dist/agent/runtime/workflow.js",
    "./agent/server": "./dist/agent/server.js",
    "./agent/server/routes": "./dist/agent/server/routes.js",
    "./agent/state/sqlite": "./dist/agent/state/sqlite.js",
    "./blob": "./dist/blob.js",
    "./blob/drivers/akamai": "./dist/blob/drivers/akamai.js",
    "./blob/drivers/azure": "./dist/blob/drivers/azure.js",
    "./blob/drivers/box": "./dist/blob/drivers/box.js",
    "./blob/drivers/cloudflare": "./dist/blob/drivers/cloudflare.js",
    "./blob/drivers/digitalocean-spaces": "./dist/blob/drivers/digitalocean-spaces.js",
    "./blob/drivers/dropbox": "./dist/blob/drivers/dropbox.js",
    "./blob/drivers/files": "./dist/blob/drivers/files.js",
    "./blob/drivers/files-sdk": "./dist/blob/drivers/files-sdk.js",
    "./blob/drivers/fs": "./dist/blob/drivers/fs.js",
