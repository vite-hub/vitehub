{
  "name": "@vite-hub/vite",
  "version": "0.0.1",
  "description": "Preset Vite integration for ViteHub primitives.",
  "keywords": [
    "vite",
    "vitehub"
  ],
  "homepage": "https://github.com/vite-hub/vitehub#readme",
  "bugs": "https://github.com/vite-hub/vitehub/issues",
  "license": "Apache-2.0",
  "author": "onmax <maximogarciamtnez@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vite-hub/vitehub.git",
    "directory": "packages/vite"
  },
  "bin": {
    "vitehub": "./dist/cli.js"
  },
  "files": [
    "dist",
    "package.json"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./agent": "./dist/agent.js",
    "./agent/capabilities": "./dist/agent/capabilities.js",
    "./agent/channels": "./dist/agent/channels.js",
    "./agent/cloudflare": "./dist/agent/cloudflare.js",
    "./agent/eval": "./dist/agent/eval.js",
    "./agent/harness/claude-code": "./dist/agent/harness/claude-code.js",
    "./agent/harness/codex": "./dist/agent/harness/codex.js",
    "./agent/harness/local-sandbox": "./dist/agent/harness/local-sandbox.js",
    "./agent/runtime/workflow": "./dist/agent/runtime/workflow.js",
    "./agent/server": "./dist/agent/server.js",
    "./agent/server/internal": "./dist/agent/server/internal.js",
    "./agent/server/workspace": "./dist/agent/server/workspace.js",
    "./agent/state/sqlite": "./dist/agent/state/sqlite.js",
    "./agent/test": "./dist/agent/test.js",
    "./blob": "./dist/blob.js",
    "./blob/runtime/state": "./dist/blob/runtime/state.js",
    "./cli": "./dist/cli.js",
    "./database": "./dist/database.js",
    "./database/drizzle": "./dist/database/drizzle.js",
    "./env": "./dist/env.js",
    "./env/presets": "./dist/env/presets.js",
    "./env/schema": "./dist/env/schema.js",
    "./env/secret": "./dist/env/secret.js",
    "./env/server": "./dist/env/server.js",
    "./kv": "./dist/kv.js",
    "./queue": "./dist/queue.js",
    "./sandbox": "./dist/sandbox.js",
    "./schedule": "./dist/schedule.js",
    "./schedule/runtime": "./dist/schedule/runtime.js",
    "./schedule/runtime/driver": "./dist/schedule/runtime/driver.js",
    "./schedule/runtime/process": "./dist/schedule/runtime/process.js",
    "./schedule/runtime/static": "./dist/schedule/runtime/static.js",
    "./workflow": "./dist/workflow.js",
    "./workflow/runtime/execute": "./dist/workflow/runtime/execute.js",
    "./workflow/runtime/state": "./dist/workflow/runtime/state.js",
    "./workspace": "./dist/workspace.js",
    "./workspace/internal/runtime/hosted": "./dist/workspace/internal/runtime/hosted.js",
    "./workspace/internal/runtime/hosted-vercel-blob": "./dist/workspace/internal/runtime/hosted-vercel-blob.js",
    "./workspace/runtime": "./dist/workspace/runtime.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "typecheck": "tsc --noEmit -p ./tsconfig.json",
    "test": "vp run -t @vite-hub/vite#build && vp test"
  },
  "dependencies": {
    "@vite-hub/agent": "workspace:*",
    "@vite-hub/blob": "workspace:*",
    "@vite-hub/cli": "workspace:*",
    "@vite-hub/database": "workspace:*",
    "@vite-hub/devtools": "workspace:*",
    "@vite-hub/env": "workspace:*",
    "@vite-hub/kv": "workspace:*",
    "@vite-hub/queue": "workspace:*",
    "@vite-hub/sandbox": "workspace:*",
    "@vite-hub/schedule": "workspace:*",
    "@vite-hub/workflow": "workspace:*",
    "@vite-hub/workspace": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:tooling",
    "publint": "catalog:tooling",
    "typescript": "catalog:tooling",
    "vite": "catalog:vite",
    "vite-plus": "catalog:tooling",
    "vitest": "catalog:tooling"
  },
  "peerDependencies": {
    "vite": "catalog:vite-compat"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
