{
  "name": "@vite-hub/blob",
  "version": "0.0.1",
  "description": "Vite-first blob storage primitives and deployment integration for ViteHub.",
  "keywords": [
    "blob",
    "cloudflare",
    "r2",
    "vercel",
    "vite",
    "vitehub"
  ],
  "homepage": "https://github.com/vite-hub/vitehub#readme",
  "bugs": "https://github.com/vite-hub/vitehub/issues",
  "license": "Apache-2.0",
  "author": "onmax <maximogarciamtnez@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vite-hub/vitehub.git",
    "directory": "packages/blob"
  },
  "files": [
    "dist",
    "package.json"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./config": "./dist/config.js",
    "./content-type": "./dist/content-type.js",
    "./drivers/akamai": {
      "types": "./dist/drivers/akamai.d.ts",
      "default": "./dist/drivers/akamai.js"
    },
    "./drivers/azure": {
      "types": "./dist/drivers/azure.d.ts",
      "default": "./dist/drivers/azure.js"
    },
    "./drivers/box": {
      "types": "./dist/drivers/box.d.ts",
      "default": "./dist/drivers/box.js"
    },
    "./drivers/cloudflare": "./dist/drivers/cloudflare.js",
    "./drivers/cloudflare-native": "./dist/drivers/cloudflare-native.js",
    "./drivers/digitalocean-spaces": {
      "types": "./dist/drivers/digitalocean-spaces.d.ts",
      "default": "./dist/drivers/digitalocean-spaces.js"
    },
    "./drivers/dropbox": {
      "types": "./dist/drivers/dropbox.d.ts",
      "default": "./dist/drivers/dropbox.js"
    },
    "./drivers/files": "./dist/drivers/files.js",
    "./drivers/fs": {
      "types": "./dist/drivers/fs.d.ts",
      "default": "./dist/drivers/fs.js"
    },
    "./drivers/gcs": {
      "types": "./dist/drivers/gcs.d.ts",
      "default": "./dist/drivers/gcs.js"
    },
    "./drivers/google-drive": {
      "types": "./dist/drivers/google-drive.d.ts",
      "default": "./dist/drivers/google-drive.js"
    },
    "./drivers/hetzner": {
      "types": "./dist/drivers/hetzner.d.ts",
      "default": "./dist/drivers/hetzner.js"
    },
    "./drivers/minio": {
      "types": "./dist/drivers/minio.d.ts",
      "default": "./dist/drivers/minio.js"
    },
    "./drivers/netlify-blobs": "./dist/drivers/netlify-blobs.js",
    "./drivers/onedrive": {
      "types": "./dist/drivers/onedrive.d.ts",
      "default": "./dist/drivers/onedrive.js"
    },
    "./drivers/s3": {
      "types": "./dist/drivers/s3.d.ts",
      "default": "./dist/drivers/s3.js"
    },
    "./drivers/storj": {
      "types": "./dist/drivers/storj.d.ts",
      "default": "./dist/drivers/storj.js"
    },
    "./drivers/supabase": {
      "types": "./dist/drivers/supabase.d.ts",
      "default": "./dist/drivers/supabase.js"
    },
    "./drivers/uploadthing": {
      "types": "./dist/drivers/uploadthing.d.ts",
      "default": "./dist/drivers/uploadthing.js"
    },
    "./drivers/vercel": "./dist/drivers/vercel.js",
    "./ensure": "./dist/ensure.js",
    "./errors": "./dist/errors.js",
    "./runtime/cloudflare-vite": "./dist/runtime/cloudflare-vite.js",
    "./runtime/state": "./dist/runtime/state.js",
    "./runtime/vercel-vite": "./dist/runtime/vercel-vite.js",
    "./virtual": "./dist/virtual.js",
    "./vite": "./dist/vite.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "typecheck": "tsc --noEmit -p ./tsconfig.json",
    "test": "vp run -t @vite-hub/blob#build && vp test"
  },
  "dependencies": {
    "@vite-hub/netlify-blobs-runtime": "npm:@netlify/blobs@^11.0.1",
    "@vite-hub/runtime": "workspace:*",
    "aws4fetch": "catalog:storage",
    "defu": "catalog:unjs",
    "esbuild": "catalog:esbuild-v27",
    "h3": "catalog:unjs",
    "pathe": "catalog:unjs"
  },
  "devDependencies": {
    "@types/node": "catalog:tooling",
    "@vite-hub/internal": "workspace:*",
    "@vercel/blob": "catalog:storage",
    "files-sdk": "catalog:storage",
    "ofetch": "catalog:unjs",
    "publint": "catalog:tooling",
    "typescript": "catalog:tooling",
    "vite": "catalog:vite",
    "vite-plus": "catalog:tooling",
    "vitest": "catalog:tooling"
  },
  "peerDependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/lib-storage": "^3.700.0",
    "@aws-sdk/s3-presigned-post": "^3.700.0",
