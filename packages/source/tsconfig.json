{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "@vite-hub/internal/*": [
        "packages/internal/src/*.ts"
      ]
    },
    "rootDir": "..",
    "baseUrl": "../.."
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts",
    "test/**/*.test-d.ts"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ]
}
