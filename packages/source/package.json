{
  "name": "@vite-hub/source",
  "version": "0.0.4",
  "description": "Typed source retrieval primitives for ViteHub.",
  "keywords": [
    "content",
    "files",
    "github",
    "source",
    "vitehub"
  ],
  "homepage": "https://github.com/vite-hub/vitehub#readme",
  "bugs": "https://github.com/vite-hub/vitehub/issues",
  "license": "Apache-2.0",
  "author": "onmax <maximogarciamtnez@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vite-hub/vitehub.git",
    "directory": "packages/source"
  },
  "files": [
    "dist",
    "types",
    "tsconfig.vite.json",
    "package.json"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "require": "./dist/client.js",
      "default": "./dist/client.js"
    },
    "./drizzle": {
      "types": "./dist/drizzle.d.ts",
      "import": "./dist/drizzle.js",
      "require": "./dist/drizzle.js",
      "default": "./dist/drizzle.js"
    },
    "./file": {
      "types": "./dist/file.d.ts",
      "import": "./dist/file.js",
      "require": "./dist/file.js",
      "default": "./dist/file.js"
    },
    "./github": {
      "types": "./dist/github.d.ts",
      "import": "./dist/github.js",
      "require": "./dist/github.js",
      "default": "./dist/github.js"
    },
    "./glob": {
      "types": "./dist/glob.d.ts",
      "import": "./dist/glob.js",
      "require": "./dist/glob.js",
      "default": "./dist/glob.js"
    },
    "./markdown": {
      "types": "./dist/markdown.d.ts",
      "import": "./dist/markdown.js",
      "require": "./dist/markdown.js",
      "default": "./dist/markdown.js"
    },
    "./mcp": {
      "types": "./dist/mcp.d.ts",
      "import": "./dist/mcp.js",
      "require": "./dist/mcp.js",
      "default": "./dist/mcp.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "require": "./dist/server.js",
      "default": "./dist/server.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js",
      "require": "./dist/vite.js",
      "default": "./dist/vite.js"
    },
    "./package.json": "./package.json",
    "./tsconfig": "./tsconfig.vite.json"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "typecheck": "tsc --noEmit -p ./tsconfig.json",
    "test": "vp run -t @vite-hub/source#build && vp test"
  },
  "dependencies": {
    "@standard-schema/spec": "catalog:runtime",
    "@vite-hub/forge": "workspace:*",
    "@vite-hub/runtime": "workspace:*",
    "h3": "catalog:unjs",
    "mlly": "catalog:unjs",
    "nostics": "catalog:runtime",
    "ofetch": "catalog:unjs"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "catalog:ai",
    "@types/node": "catalog:tooling",
    "@types/picomatch": "catalog:tooling",
    "@vite-hub/internal": "workspace:*",
    "drizzle-orm": "catalog:database",
    "mrmime": "catalog:workspace",
    "nitro": "catalog:unjs",
    "ocache": "catalog:unjs",
    "picomatch": "catalog:workspace",
    "publint": "catalog:tooling",
    "tinyglobby": "catalog:workspace",
    "typescript": "catalog:tooling",
    "vite": "catalog:vite",
    "valibot": "catalog:runtime",
    "vite-plus": "catalog:tooling",
    "vitest": "catalog:tooling",
    "vue": "catalog:ui"
  },
  "peerDependencies": {
    "drizzle-orm": "catalog:database",
    "nitro": "catalog:unjs",
    "vite": "catalog:vite-compat",
    "vue": "catalog:ui"
  },
  "peerDependenciesMeta": {
    "drizzle-orm": {
      "optional": true
    },
    "nitro": {
      "optional": true
    },
    "vite": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
