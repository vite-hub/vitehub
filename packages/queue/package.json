{
  "name": "@vite-hub/queue",
  "version": "0.1.0",
  "description": "Queue primitives and Vite deployment integration for ViteHub.",
  "keywords": [
    "background-jobs",
    "cloudflare",
    "h3",
    "job-queue",
    "nuxt",
    "postgres",
    "queue",
    "typescript",
    "vercel",
    "vite",
    "vitehub"
  ],
  "homepage": "https://vitehub.dev",
  "bugs": "https://github.com/vite-hub/vitehub/issues",
  "license": "Apache-2.0",
  "author": "onmax <maximogarciamtnez@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vite-hub/vitehub.git",
    "directory": "packages/queue"
  },
  "files": [
    "dist",
    "package.json"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "imports": {
    "#vitehub/queue/node-client": {
      "types": "./dist/internal/runtime/postgres-client.d.ts",
      "workerd": "./dist/internal/runtime/worker-client.js",
      "worker": "./dist/internal/runtime/worker-client.js",
      "browser": "./dist/internal/runtime/worker-client.js",
      "default": "./dist/internal/runtime/postgres-client.js"
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./durability": {
      "types": "./dist/durability.d.ts",
      "import": "./dist/durability.js",
      "default": "./dist/durability.js"
    },
    "./runtime/hosted": {
      "types": "./dist/runtime/hosted.d.ts",
      "import": "./dist/runtime/hosted.js",
      "default": "./dist/runtime/hosted.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js",
      "default": "./dist/vite.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "typecheck": "vp run --cache -t @vite-hub/queue#build && node ../../test/package-typecheck.mjs --noEmit -p ./tsconfig.json",
    "test": "vp run --cache -t @vite-hub/queue#build && vp test"
  },
  "dependencies": {
    "@vite-hub/runtime": "workspace:*",
    "defu": "catalog:unjs",
    "nostics": "catalog:runtime",
    "pathe": "catalog:unjs"
  },
  "devDependencies": {
    "@types/node": "catalog:tooling",
    "@vercel/functions": "catalog:vercel",
    "@vercel/queue": "catalog:vercel",
    "@vite-hub/database": "workspace:*",
    "@vite-hub/internal": "workspace:*",
    "postgres": "catalog:database",
    "publint": "catalog:tooling",
    "typescript": "catalog:tooling",
    "undici": "8.12.2",
    "valibot": "catalog:runtime",
    "vite": "catalog:vite",
    "vite-plus": "catalog:tooling",
    "vitest": "catalog:tooling"
  },
  "peerDependencies": {
    "@vercel/functions": "catalog:vercel",
    "@vercel/queue": "catalog:vercel",
    "postgres": "catalog:database",
    "vite": "catalog:vite-compat"
  },
  "peerDependenciesMeta": {
    "@vercel/functions": {
      "optional": true
    },
    "@vercel/queue": {
      "optional": true
    },
    "postgres": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
