{
  "name": "@vite-hub/queue",
  "version": "0.0.1",
  "description": "Queue primitives and Vite deployment integration for ViteHub.",
  "author": "onmax <maximogarciamtnez@gmail.com>",
  "license": "Apache-2.0",
  "homepage": "https://github.com/vite-hub/vitehub#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vite-hub/vitehub.git",
    "directory": "packages/queue"
  },
  "bugs": "https://github.com/vite-hub/vitehub/issues",
  "keywords": [
    "vitehub",
    "vite",
    "h3",
    "queue",
    "cloudflare",
    "vercel"
  ],
  "sideEffects": false,
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./provision": "./dist/provision.js",
    "./runtime/cloudflare-vite": "./dist/runtime/cloudflare-vite.js",
    "./runtime/hosted": "./dist/runtime/hosted.js",
    "./runtime/state": "./dist/runtime/state.js",
    "./runtime/vercel-vite": "./dist/runtime/vercel-vite.js",
    "./vite": "./dist/vite.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "package.json"
  ],
  "scripts": {
    "build": "tsdown --tsconfig tsconfig.build.json",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit -p ./tsconfig.json",
    "test": "pnpm --dir ../blob build && pnpm --dir ../kv build && pnpm --dir ../schedule build && pnpm --dir . build && pnpm --dir ../sandbox build && pnpm --dir ../workflow build && vitest run"
  },
  "dependencies": {
    "@vercel/functions": "catalog:vercel",
    "defu": "catalog:unjs",
    "esbuild": "catalog:esbuild-v27",
    "exsolve": "catalog:unjs",
    "h3": "catalog:unjs",
    "pathe": "catalog:unjs"
  },
  "peerDependencies": {
    "@vercel/queue": "catalog:vercel",
    "vite": "catalog:vite8-compat"
  },
  "peerDependenciesMeta": {
    "@vercel/queue": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "catalog:tooling",
    "@vite-hub/internal": "workspace:*",
    "publint": "catalog:tooling",
    "tsdown": "catalog:tooling",
    "typescript": "catalog:tooling",
    "vite": "catalog:vite",
    "vitest": "catalog:tooling"
  }
}
