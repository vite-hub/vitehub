{
  "name": "@vite-hub/queue",
  "version": "0.0.1",
  "description": "Queue primitives and Vite deployment integration for ViteHub.",
  "keywords": [
    "cloudflare",
    "h3",
    "queue",
    "vercel",
    "vite",
    "vitehub"
  ],
  "homepage": "https://github.com/vite-hub/vitehub#readme",
  "bugs": "https://github.com/vite-hub/vitehub/issues",
  "license": "Apache-2.0",
  "author": "onmax <maximogarciamtnez@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vite-hub/vitehub.git",
    "directory": "packages/queue"
  },
  "files": [
    "dist",
    "package.json"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./nuxt": "./dist/nuxt.js",
    "./internal/runtime/cloudflare-client": "./dist/internal/runtime/cloudflare-client.js",
    "./internal/runtime/vercel-client": "./dist/internal/runtime/vercel-client.js",
    "./runtime/cloudflare-vite": "./dist/runtime/cloudflare-vite.js",
    "./runtime/hosted": "./dist/runtime/hosted.js",
    "./runtime/state": "./dist/runtime/state.js",
    "./runtime/vercel-vite": "./dist/runtime/vercel-vite.js",
    "./vite": "./dist/vite.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "typecheck": "tsc --noEmit -p ./tsconfig.json",
    "test": "vp run -t @vite-hub/queue#build && vp test"
  },
  "dependencies": {
    "@vite-hub/runtime": "workspace:*",
    "defu": "catalog:unjs",
    "esbuild": "catalog:esbuild-v27",
    "h3": "catalog:unjs",
    "pathe": "catalog:unjs"
  },
  "devDependencies": {
    "@types/node": "catalog:tooling",
    "@vercel/functions": "catalog:vercel",
    "@vite-hub/internal": "workspace:*",
    "nuxt": "catalog:nuxt",
    "publint": "catalog:tooling",
    "typescript": "catalog:tooling",
    "vite": "catalog:vite",
    "vite-plus": "catalog:tooling",
    "vitest": "catalog:tooling"
  },
  "peerDependencies": {
    "@vercel/functions": "catalog:vercel",
    "@vercel/queue": "catalog:vercel",
    "vite": "catalog:vite-compat"
  },
  "peerDependenciesMeta": {
    "@vercel/functions": {
      "optional": true
    },
    "@vercel/queue": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
