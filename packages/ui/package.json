{
  "name": "@vite-hub/ui",
  "version": "0.0.4",
  "description": "AI interface primitives for Vue and Nuxt.",
  "keywords": [
    "ai",
    "chat",
    "nuxt",
    "vitehub",
    "vue"
  ],
  "homepage": "https://vitehub.dev/docs/ui",
  "bugs": "https://github.com/vite-hub/vitehub/issues",
  "license": "Apache-2.0",
  "author": "onmax <maximogarciamtnez@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vite-hub/vitehub.git",
    "directory": "packages/ui"
  },
  "files": [
    "dist",
    "package.json"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/styles.css"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./agent-code-view": {
      "types": "./dist/agent-code-view.d.ts",
      "import": "./dist/agent-code-view.js",
      "default": "./dist/agent-code-view.js"
    },
    "./agent-file-tree": {
      "types": "./dist/agent-file-tree.d.ts",
      "import": "./dist/agent-file-tree.js",
      "default": "./dist/agent-file-tree.js"
    },
    "./agent-tool-list": {
      "types": "./dist/agent-tool-list.d.ts",
      "import": "./dist/agent-tool-list.js",
      "default": "./dist/agent-tool-list.js"
    },
    "./agent-trace": {
      "types": "./dist/agent-trace.d.ts",
      "import": "./dist/agent-trace.js",
      "default": "./dist/agent-trace.js"
    },
    "./attachment": {
      "types": "./dist/attachment.d.ts",
      "import": "./dist/attachment.js",
      "default": "./dist/attachment.js"
    },
    "./bubble": {
      "types": "./dist/bubble.d.ts",
      "import": "./dist/bubble.js",
      "default": "./dist/bubble.js"
    },
    "./chat": {
      "types": "./dist/chat.d.ts",
      "import": "./dist/chat.js",
      "default": "./dist/chat.js"
    },
    "./chat-message": {
      "types": "./dist/chat-message.d.ts",
      "import": "./dist/chat-message.js",
      "default": "./dist/chat-message.js"
    },
    "./chat-session": {
      "types": "./dist/chat-session.d.ts",
      "import": "./dist/chat-session.js",
      "default": "./dist/chat-session.js"
    },
    "./code-block": {
      "types": "./dist/code-block.d.ts",
      "import": "./dist/code-block.js",
      "default": "./dist/code-block.js"
    },
    "./headless": {
      "types": "./dist/headless.d.ts",
      "import": "./dist/headless.js",
      "require": "./dist/headless.js",
      "default": "./dist/headless.js"
    },
    "./marker": {
      "types": "./dist/marker.d.ts",
      "import": "./dist/marker.js",
      "default": "./dist/marker.js"
    },
    "./message": {
      "types": "./dist/message.d.ts",
      "import": "./dist/message.js",
      "default": "./dist/message.js"
    },
    "./markdown": {
      "types": "./dist/markdown.d.ts",
      "import": "./dist/markdown.js",
      "default": "./dist/markdown.js"
    },
    "./message-parts": {
      "types": "./dist/message-parts.d.ts",
      "import": "./dist/message-parts.js",
      "default": "./dist/message-parts.js"
    },
    "./nuxt": {
      "types": "./dist/nuxt.d.ts",
      "import": "./dist/nuxt.js",
      "require": "./dist/nuxt.js",
      "default": "./dist/nuxt.js"
    },
    "./primitive-rail": {
      "types": "./dist/primitive-rail.d.ts",
      "import": "./dist/primitive-rail.js",
      "require": "./dist/primitive-rail.js",
      "default": "./dist/primitive-rail.js"
    },
    "./trace": {
      "types": "./dist/trace.d.ts",
      "import": "./dist/trace.js",
      "default": "./dist/trace.js"
    },
    "./prompt-input": {
      "types": "./dist/prompt-input.d.ts",
      "import": "./dist/prompt-input.js",
      "default": "./dist/prompt-input.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js",
      "require": "./dist/vite.js",
      "default": "./dist/vite.js"
    },
    "./package.json": "./package.json",
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "typecheck": "tsc --noEmit -p ./tsconfig.json",
    "test": "vp run -t @vite-hub/runtime#build && vp run -t @vite-hub/ui#build && vp test"
  },
  "dependencies": {
    "@comark/vue": "0.7.0",
    "@iconify-json/ph": "catalog:ui",
    "@nuxt/kit": "4.6.2",
    "@shikijs/langs": "4.5.0",
    "@types/node": "catalog:tooling",
    "nostics": "catalog:runtime",
    "katex": "^0.17.0",
    "reka-ui": "catalog:ui",
    "shiki": "^4.5.0"
  },
  "devDependencies": {
    "@nuxt/ui": "catalog:nuxt",
    "@pierre/diffs": "1.5.2",
    "@pierre/theme": "2.0.0",
    "@pierre/trees": "1.0.0-beta.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vite-hub/runtime": "workspace:*",
    "@vue/server-renderer": "3.5.44",
    "@vue/test-utils": "2.5.1",
    "ai": "catalog:ai",
    "happy-dom": "21.0.3",
    "nuxt": "catalog:nuxt",
    "publint": "catalog:tooling",
    "typescript": "catalog:tooling",
    "vite": "catalog:vite",
    "vite-plus": "catalog:tooling",
    "vitest": "catalog:tooling",
    "vue": "catalog:ui",
    "@types/markdown-it": "^14.2.0",
    "@vite-hub/agent": "workspace:*"
  },
  "peerDependencies": {
    "@nuxt/ui": "^4.11.0",
    "ai": "catalog:ai-compat",
    "vite": "catalog:vite-compat",
    "vue": "catalog:ui"
  },
  "peerDependenciesMeta": {
    "@nuxt/ui": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24.15.0"
  }
}
