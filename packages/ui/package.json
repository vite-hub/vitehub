{
  "name": "@vite-hub/ui",
  "version": "0.1.0",
  "description": "AI interface primitives for Vue and Nuxt.",
  "keywords": [
    "ai",
    "ai-chat",
    "chat",
    "nuxt",
    "nuxt-module",
    "typescript",
    "vitehub",
    "vue"
  ],
  "homepage": "https://vitehub.dev/docs/ui",
  "bugs": "https://github.com/vite-hub/vitehub/issues",
  "license": "Apache-2.0",
  "author": "onmax <maximogarciamtnez@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vite-hub/vitehub.git",
    "directory": "packages/ui"
  },
  "files": [
    "dist",
    "package.json"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/styles.css",
    "./dist/theme.css"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./headless": {
      "types": "./dist/headless.d.ts",
      "import": "./dist/headless.js",
      "default": "./dist/headless.js"
    },
    "./markdown-editor": {
      "types": "./dist/markdown-editor.d.ts",
      "import": "./dist/markdown-editor.js",
      "default": "./dist/markdown-editor.js"
    },
    "./nuxt": {
      "types": "./dist/nuxt.d.ts",
      "import": "./dist/nuxt.js",
      "default": "./dist/nuxt.js"
    },
    "./playground": {
      "types": "./dist/playground.d.ts",
      "import": "./dist/playground.js",
      "default": "./dist/playground.js"
    },
    "./theme": {
      "types": "./dist/theme.d.ts",
      "import": "./dist/theme.js",
      "default": "./dist/theme.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js",
      "default": "./dist/vite.js"
    },
    "./workspace": {
      "types": "./dist/workspace.d.ts",
      "import": "./dist/workspace.js",
      "default": "./dist/workspace.js"
    },
    "./package.json": "./package.json",
    "./styles.css": "./dist/styles.css",
    "./theme.css": "./dist/theme.css"
  },
  "scripts": {
    "bench:headless": "node scripts/headless-weight.ts",
    "build": "vp pack",
    "dev": "vp pack --watch",
    "typecheck": "vp run --cache -t @vite-hub/ui#build && node ../../test/package-typecheck.mjs --noEmit -p ./tsconfig.json",
    "test": "vp run --cache -t @vite-hub/runtime#build && vp run --cache -t @vite-hub/ui#build && vp test",
    "test:browser": "vp run --cache -t @vite-hub/ui#build && node --test test/browser/workspace.browser.mjs",
    "test:parity": "node --test test/browser/parity.browser.mjs"
  },
  "dependencies": {
    "@comark/vue": "0.9.0",
    "comark-chat": "catalog:",
    "@nuxt/kit": "4.6.2",
    "@shikijs/langs": "4.5.0",
    "@shikijs/themes": "4.5.0",
    "@types/node": "catalog:tooling",
    "@vite-hub/comments": "workspace:*",
    "@ui-sdk/core": "0.1.0-beta.2",
    "@ui-sdk/vue": "0.1.0-beta.2",
    "nostics": "catalog:runtime",
    "katex": "^0.19.1",
    "shiki": "^4.5.0",
    "comark": "catalog:markdown-ui",
    "vega-loader": "^5.1.3",
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/lang-vue": "0.1.3",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/highlight": "1.2.5",
    "@vite-hub/web-container": "workspace:*",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0"
  },
  "devDependencies": {
    "@ai-sdk/vue": "catalog:ai",
    "@iconify-json/lucide": "catalog:ui",
    "@nuxt/schema": "4.6.3",
    "@nuxt/ui": "catalog:nuxt",
    "@pierre/diffs": "1.5.2",
    "@pierre/theme": "2.0.0",
    "@pierre/trees": "1.0.0-beta.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vite-hub/icons": "workspace:*",
    "@vite-hub/runtime": "workspace:*",
    "@vue/server-renderer": "3.5.44",
    "@vue/test-utils": "2.5.1",
    "ai": "catalog:ai",
    "happy-dom": "21.0.3",
    "nuxt": "catalog:nuxt",
    "publint": "catalog:tooling",
    "reka-ui": "catalog:ui",
    "tailwindcss": "^4.3.3",
    "typescript": "catalog:tooling",
    "vega-canvas": "^2.0.0",
    "vite": "catalog:vite",
    "vite-plus": "catalog:tooling",
    "vitest": "catalog:tooling",
    "vue": "catalog:ui",
    "@types/markdown-it": "^14.2.0",
    "comark-ui": "catalog:markdown-ui",
    "@vite-hub/content": "workspace:*",
    "playwright-core": "catalog:browser",
    "@tiptap/core": "catalog:realtime",
    "@tiptap/extension-image": "catalog:realtime",
    "@tiptap/extension-list": "catalog:realtime",
    "@tiptap/extension-table": "catalog:realtime",
    "@tiptap/pm": "catalog:realtime",
    "@tiptap/starter-kit": "catalog:realtime",
    "@tiptap/vue-3": "3.31.4",
    "@vite-hub/blob": "workspace:*"
  },
  "peerDependencies": {
    "@iconify-json/lucide": "catalog:ui",
    "@nuxt/ui": "^4.11.0",
    "@tiptap/core": "catalog:realtime",
    "@tiptap/extension-image": "catalog:realtime",
    "@tiptap/extension-list": "catalog:realtime",
    "@tiptap/extension-table": "catalog:realtime",
    "@tiptap/pm": "catalog:realtime",
    "@tiptap/starter-kit": "catalog:realtime",
    "@tiptap/vue-3": "^3.31.4",
    "ai": "catalog:ai-compat",
    "vite": "catalog:vite-compat",
    "vue": "catalog:vue-compat"
  },
  "peerDependenciesMeta": {
    "@iconify-json/lucide": {
      "optional": true
    },
    "@nuxt/ui": {
      "optional": true
    },
    "@tiptap/core": {
      "optional": true
    },
    "@tiptap/extension-image": {
      "optional": true
    },
    "@tiptap/extension-list": {
      "optional": true
    },
    "@tiptap/extension-table": {
      "optional": true
    },
    "@tiptap/pm": {
      "optional": true
    },
    "@tiptap/starter-kit": {
      "optional": true
    },
    "@tiptap/vue-3": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.22.0"
  }
}
