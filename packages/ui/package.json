{
  "name": "@vite-hub/ui",
  "version": "0.0.1",
  "description": "AI interface primitives for Vue and Nuxt.",
  "keywords": [
    "ai",
    "chat",
    "nuxt",
    "vitehub",
    "vue"
  ],
  "homepage": "https://vitehub.dev/docs/ui",
  "bugs": "https://github.com/vite-hub/vitehub/issues",
  "license": "Apache-2.0",
  "author": "onmax <maximogarciamtnez@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vite-hub/vitehub.git",
    "directory": "packages/ui"
  },
  "files": [
    "dist",
    "package.json"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/styles.css"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./headless": {
      "types": "./dist/headless.d.ts",
      "import": "./dist/headless.js"
    },
    "./nuxt": {
      "types": "./dist/nuxt.d.ts",
      "import": "./dist/nuxt.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    },
    "./package.json": "./package.json",
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "typecheck": "tsc --noEmit -p ./tsconfig.json",
    "test": "vp run -t @vite-hub/runtime#build && vp run -t @vite-hub/ui#build && vp test"
  },
  "dependencies": {
    "@comark/vue": "0.6.2",
    "@nuxt/kit": "4.4.8"
  },
  "devDependencies": {
    "@nuxt/ui": "catalog:nuxt",
    "@pierre/diffs": "1.3.5",
    "@pierre/theme": "1.1.0",
    "@pierre/trees": "1.0.0-beta.6",
    "@types/node": "catalog:tooling",
    "@vite-hub/internal": "workspace:*",
    "@vite-hub/runtime": "workspace:*",
    "@vue/server-renderer": "^3.5.0",
    "@vue/test-utils": "2.4.11",
    "ai": "catalog:ai",
    "happy-dom": "20.11.6",
    "nuxt": "catalog:nuxt",
    "publint": "catalog:tooling",
    "typescript": "catalog:tooling",
    "vite": "catalog:vite",
    "vite-plus": "catalog:tooling",
    "vitest": "catalog:tooling",
    "vue": "catalog:ui"
  },
  "peerDependencies": {
    "@nuxt/ui": "^4.9.0",
    "ai": "catalog:ai-compat",
    "vite": "catalog:vite",
    "vue": "catalog:ui"
  },
  "peerDependenciesMeta": {
    "@nuxt/ui": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24.15.0"
  }
}
