index 0000000000000000000000000000000000000000..a55e7dec27a486d12964dcbbb42c549742cf8c75
--- /dev/null
+++ b/dist/adapters/h3.mjs
@@ -0,0 +1,47 @@
+import { fromWebHandler } from "h3";
+import { cleanDoubleSlashes, withLeadingSlash, withTrailingSlash } from "ufo";
+import { initDevframe } from "./initiate.mjs";
+
+function normalizeBasePath(base) {
+	return cleanDoubleSlashes(withTrailingSlash(withLeadingSlash(base)));
+}
+
+function addDevframeNitroHandler(config, options) {
+	const route = `${normalizeBasePath(options.base).slice(0, -1)}/**`;
+	const handlers = config.handlers ??= [];
+	const conflict = handlers.find(candidate => candidate.route === route && candidate.handler !== options.handler);
+	if (conflict) throw new Error(`Cannot mount the devframe handler at "${route}" because that route already uses "${conflict.handler}".`);
+	if (!handlers.some(candidate => candidate.route === route && candidate.handler === options.handler)) {
+		handlers.push({ handler: options.handler, route });
+	}
+}
+
+function createDevframeH3Handler(definition, options) {
+	const { responseHeaders, ...initOptions } = options;
+	let instance;
+	const handler = fromWebHandler(async (request) => {
+		instance ??= initDevframe(definition, initOptions);
+		const url = new URL(request.url);
+		const marker = url.pathname.indexOf(instance.base);
+		if (marker > 0) {
+			url.pathname = url.pathname.slice(marker);
+			request = new Request(url, request);
+		}
+		const response = await instance.handler(request);
+		if (!responseHeaders) return response;
+		const headers = new Headers(response.headers);
+		for (const [name, value] of new Headers(responseHeaders)) headers.set(name, value);
+		return new Response(response.body, {
+			headers,
+			status: response.status,
+			statusText: response.statusText
+		});
+	});
+	handler.close = async () => {
+		await instance?.close();
+		instance = void 0;
+	};
+	return handler;
+}
+
+export { addDevframeNitroHandler, createDevframeH3Handler };
