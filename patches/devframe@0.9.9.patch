+import type { EventHandler } from "h3";
+import type { DevframeDefinition } from "../index.mjs";
+import type { DevframeInstance, InitDevframeOptions } from "./initiate.mjs";
+
+interface CreateDevframeH3HandlerOptions extends InitDevframeOptions {
+  responseHeaders?: HeadersInit;
+}
+
+interface DevframeH3Handler extends EventHandler {
+  close: () => Promise<void>;
+}
+
+interface DevframeNitroConfig {
+  handlers?: Array<{ handler: string; route: string }>;
+}
+
+declare function addDevframeNitroHandler(config: DevframeNitroConfig, options: {
+  base: string;
+  handler: string;
+}): void;
+
+declare function createDevframeH3Handler(
+  definition: DevframeDefinition,
+  options: CreateDevframeH3HandlerOptions,
+): DevframeH3Handler;
+
+export {
+  type CreateDevframeH3HandlerOptions,
+  type DevframeH3Handler,
+  type DevframeNitroConfig,
+  addDevframeNitroHandler,
+  createDevframeH3Handler,
+};
diff --git a/dist/adapters/h3.mjs b/dist/adapters/h3.mjs
