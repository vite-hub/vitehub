+      border-color: var(--ui-destructive);
+    }
+
+    &[data-disabled] {
+      opacity: 0.5;
+      cursor: not-allowed;
+    }
+  }
+
+  [data-slot="input-clear"] {
+    --ui-icon: var(--ui-icon-x);
+    display: inline-flex;
+    flex-shrink: 0;
+    align-items: center;
+    justify-content: center;
+    width: calc(var(--ui-spacing) * 6);
+    height: calc(var(--ui-spacing) * 6);
+    padding: 0;
+    border: 0;
+    border-radius: max(0px, calc(var(--ui-radius) - 2px));
+    background: transparent;
+    color: var(--ui-muted-foreground);
+    font: inherit;
+    cursor: pointer;
+
+    &:not(:has(svg))::before {
+      content: "";
+      flex-shrink: 0;
+      width: var(--ui-icon-size, 1rem);
+      height: var(--ui-icon-size, 1rem);
+      background: currentColor;
+      mask: var(--ui-icon) center / contain no-repeat;
+    }
+
+    &:hover {
+      background: var(--ui-muted);
+      color: var(--ui-foreground);
+    }
+
+    &:not([data-filled]) {
+      visibility: hidden;
+    }
+  }
+
+  [data-slot="select-label"] {
+    display: block;
+    margin-block-end: calc(var(--ui-spacing) * 1.5);
+    font-size: calc(var(--ui-font-size) - 0.0625rem);
+    font-weight: 500;
+  }
+
+  [data-slot="number-input-scrub-area"] {
+    cursor: ew-resize;
+  }
+
+  [data-slot="timeline"] {
+    display: flex;
+    flex-direction: column;
+    margin: 0;
+    padding: 0;
+    color: var(--ui-foreground);
+    font-size: var(--ui-font-size);
+    list-style: none;
+
+    &[data-orientation="horizontal"] {
+      display: grid;
+      grid-template-columns: repeat(var(--timeline-count, 1), minmax(0, 1fr));
+    }
+
+    &[data-busy] {
+      opacity: 0.6;
+    }
+  }
+
+  /* The marker sits in its own column, and the connector runs down that column to the next marker. */
+  [data-slot="timeline-item"] {
+    position: relative;
+    display: grid;
+    grid-template-columns: calc(var(--ui-spacing) * 2) minmax(0, 1fr);
+    align-items: baseline;
+    column-gap: calc(var(--ui-spacing) * 3);
+    padding-block-end: calc(var(--ui-spacing) * 5);
+
+    &:is([data-last], :last-child) {
+      padding-block-end: 0;
+    }
+
+    & > :not([data-slot="timeline-marker"], [data-slot="timeline-connector"]) {
+      grid-column: 2;
+    }
+
+    &[data-orientation="horizontal"] {
+      grid-template-columns: minmax(0, 1fr);
+      padding: calc(var(--ui-spacing) * 5) calc(var(--ui-spacing) * 4) 0 0;
+
+      & > :not([data-slot="timeline-marker"], [data-slot="timeline-connector"]) {
+        grid-column: 1;
+      }
+    }
+  }
+
+  [data-slot="timeline-marker"] {
+    grid-row: 1;
+    grid-column: 1;
+    align-self: center;
+    width: calc(var(--ui-spacing) * 2);
+    height: calc(var(--ui-spacing) * 2);
+    border: 1px solid var(--ui-input);
+    border-radius: 50%;
+    background: var(--ui-background);
+
+    [data-slot="timeline-item"][data-first] > & {
+      border-color: var(--ui-primary);
+      background: var(--ui-primary);
+    }
+
+    &[data-orientation="horizontal"] {
+      position: absolute;
+      inset-block-start: var(--ui-spacing);
+      inset-inline-start: 0;
+    }
+  }
+
+  [data-slot="timeline-connector"] {
+    position: absolute;
+    inset-block: calc(var(--ui-spacing) * 4.5) calc(var(--ui-spacing) * 0.5);
+    inset-inline-start: calc(var(--ui-spacing) - 0.5px);
+    width: 1px;
+    background: var(--ui-border);
+
+    [data-slot="timeline-item"]:is([data-last], :last-child) > & {
+      display: none;
+    }
+
+    &[data-orientation="horizontal"] {
+      inset-block: calc(var(--ui-spacing) * 2 - 0.5px) auto;
+      inset-inline: calc(var(--ui-spacing) * 3) var(--ui-spacing);
+      width: auto;
+      height: 1px;
+    }
+  }
+
+  [data-slot="timeline-title"] {
+    font-weight: 500;
+  }
+
+  :is([data-slot="timeline-time"], [data-slot="timeline-description"]) {
+    color: var(--ui-muted-foreground);
+    font-size: calc(var(--ui-font-size) - 0.0625rem);
+  }
+
+  [data-slot="timeline-time"] {
+    font-variant-numeric: tabular-nums;
+  }
+
+  /* Rows share the columns of the grid through subgrid, so a row can take a hover fill and a focus ring. */
+  [data-slot="waterfall"] {
+    display: grid;
+    grid-template-columns: minmax(6rem, max-content) max-content minmax(12rem, 1fr);
+    width: 100%;
+    overflow: hidden;
+    border: 1px solid var(--ui-border);
+    border-radius: var(--ui-radius-popup, calc(var(--ui-radius) * 1.5));
+    background: var(--ui-background);
+    color: var(--ui-foreground);
+    font-size: calc(var(--ui-font-size) - 0.0625rem);
+  }
+
+  :is([data-slot="waterfall-header-row"], [data-slot="waterfall-row"]) {
+    display: grid;
+    grid-column: 1 / -1;
+    grid-template-columns: subgrid;
+    align-items: center;
+    min-height: calc(var(--ui-spacing) * 8);
+  }
+
+  [data-slot="waterfall-header-row"] {
+    border-block-end: 1px solid var(--ui-border);
+    color: var(--ui-muted-foreground);
+  }
+
+  [data-slot="waterfall-row"] {
+    &:is(:hover, [data-selected]) {
+      background: var(--ui-muted);
+    }
+
+    &:focus-visible {
+      outline-offset: calc(var(--ui-ring-width, 4px) * -1);
+    }
+  }
+
+  :is(
+    [data-slot="waterfall-column-header"],
+    [data-slot="waterfall-row-header"],
+    [data-slot="waterfall-cell"]
+  ) {
+    min-width: 0;
+    padding-inline: calc(var(--ui-spacing) * 3);
+    overflow: hidden;
+    font-weight: 400;
+    text-overflow: ellipsis;
+    white-space: nowrap;
+  }
+
+  [data-slot="waterfall-row-header"] {
+    padding-inline-start: calc(var(--ui-spacing) * 3 + (var(--waterfall-level, 1) - 1) * var(--ui-spacing) * 4);
+  }
+
+  [data-slot="waterfall-cell"] {
+    color: var(--ui-muted-foreground);
+    font-variant-numeric: tabular-nums;
+    text-align: end;
+  }
+
+  /* The axis header and the bars have the same box, so a tick and a bar at the same time line up. */
+  [data-slot="waterfall-column-header"]:has([data-slot="waterfall-axis"]) {
+    position: relative;
+    align-self: stretch;
+    margin-inline-end: calc(var(--ui-spacing) * 3);
+    padding: 0;
+  }
+
+  [data-slot="waterfall-axis"] {
+    position: absolute;
+    inset: 0;
+    container-type: inline-size;
+  }
+
+  /* On a narrow axis, every other tick keeps its line and drops its label, so the labels do not overlap. */
+  @container (max-width: 24rem) {
+    [data-slot="waterfall-tick"]:nth-child(even) {
+      color: transparent;
+    }
+  }
+
+  [data-slot="waterfall-tick"] {
+    position: absolute;
+    inset-block: 0;
+    inset-inline-start: var(--waterfall-tick);
+    display: flex;
+    align-items: center;
+    padding-inline-start: var(--ui-spacing);
+    border-inline-start: 1px solid var(--ui-border);
+    font-size: calc(var(--ui-font-size) - 0.125rem);
+    font-variant-numeric: tabular-nums;
+  }
+
+  [data-slot="waterfall-mark"] {
+    position: absolute;
+    inset-block-end: 0;
+    inset-inline-start: var(--waterfall-mark);
+    width: 1px;
+    height: calc(var(--ui-spacing) * 2);
+    overflow: hidden;
+    background: var(--ui-destructive);
+    color: transparent;
+  }
+
+  [data-slot="waterfall-bar"] {
+    position: relative;
+    align-self: stretch;
+    margin-inline-end: calc(var(--ui-spacing) * 3);
+
+    &::before {
+      position: absolute;
+      inset-block: calc(50% - var(--ui-spacing));
+      inset-inline-start: var(--waterfall-start);
+      width: max(2px, var(--waterfall-size));
+      border-radius: max(0px, calc(var(--ui-radius) - 2px));
+      background: var(--ui-primary);
+      content: "";
+    }
+  }
 }
