{
  "name": "vitehub-first-agent-tutorial",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 3000 --strictPort",
    "build": "vite build",
    "start": "node .output/server/index.mjs",
    "postinstall": "vitehub types prepare"
  },
  "dependencies": {
    "@vite-hub/agent": "workspace:*",
    "h3": "catalog:unjs",
    "vite-hub": "workspace:*",
    "vite": "catalog:vite",
    "nitro": "catalog:unjs"
  },
  "imports": {
    "#vitehub/env/public": {
      "types": "./.vitehub/env/public.d.ts",
      "default": "./.vitehub/env/public.mjs"
    },
    "#vitehub/env/server": {
      "types": "./.vitehub/env/server.d.ts",
      "default": "./.vitehub/env/server.mjs"
    }
  },
  "devDependencies": {
    "@types/node": "catalog:tooling",
    "typescript": "catalog:tooling"
  }
}
