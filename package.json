{
  "name": "babysitter",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite --host 127.0.0.1 --port 3028",
    "start": "node .output/server/index.mjs",
    "test": "node --test test/*.test.ts",
    "typecheck": "vite build --app && tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/harness": "1.0.0",
    "@ai-sdk/harness-codex": "1.0.0",
    "@vite-hub/agent": "https://pkg.pr.new/vite-hub/vitehub/@vite-hub/agent@0fa23d743da3ea8afdcdef97c8cbe221f1a26b6d",
    "@vite-hub/markdown-template": "https://pkg.pr.new/vite-hub/vitehub/@vite-hub/markdown-template@0fa23d743da3ea8afdcdef97c8cbe221f1a26b6d",
    "ai": "7.0.0",
    "h3": "^2.0.1-rc.25",
    "nitro": "3.0.260429-beta",
    "vite": "^8.0.11",
    "vite-hub": "https://pkg.pr.new/vite-hub/vitehub/vite-hub@0fa23d743da3ea8afdcdef97c8cbe221f1a26b6d"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "typescript": "^6.0.3"
  },
  "imports": {
    "#vitehub/env/public": {
      "types": "./.vitehub/env/public.d.ts",
      "default": "./.vitehub/env/public.mjs"
