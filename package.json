{
  "name": "babysitter",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite --host 127.0.0.1 --port 3028",
    "start": "node .output/server/index.mjs",
    "test": "node --test test/*.test.ts",
    "typecheck": "vite build --app && vue-tsc --noEmit && tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/harness": "1.0.39",
    "@ai-sdk/harness-codex": "1.0.41",
    "@github-tools/eve-extension": "0.3.0",
    "@nuxt/ui": "4.10.0",
    "@vite-hub/markdown-template": "https://pkg.pr.new/vite-hub/vitehub/@vite-hub/markdown-template@89df2d7c50dfd40ad7b180b9d910d35e672e2a84",
    "ai": "7.0.38",
    "eve": "^0.31.3",
    "h3": "^2.0.1-rc.25",
    "nitro": "3.0.260429-beta",
    "tailwindcss": "4.3.2",
    "vite": "^8.0.11",
    "vite-hub": "https://pkg.pr.new/vite-hub/vitehub/vite-hub@89df2d7c50dfd40ad7b180b9d910d35e672e2a84",
    "vue": "3.5.40",
    "vue-router": "4.6.4"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@vitejs/plugin-vue": "6.0.5",
    "typescript": "^6.0.3",
    "vue-tsc": "3.3.8"
  },
  "imports": {
    "#vitehub/env/public": {
      "types": "./.vitehub/env/public.d.ts",
      "default": "./.vitehub/env/public.mjs"
    },
    "#vitehub/env/server": {
      "types": "./.vitehub/env/server.d.ts",
      "default": "./.vitehub/env/server.mjs"
    }
  }
}
