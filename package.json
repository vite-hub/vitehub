{
  "name": "babysitter",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite --host 127.0.0.1 --port 3028",
    "start": "node .output/server/index.mjs",
    "typecheck": "vite build --app && tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/harness": "1.0.0",
    "@ai-sdk/harness-codex": "1.0.0",
    "@vite-hub/agent": "https://pkg.pr.new/vite-hub/vitehub/@vite-hub/agent@a4e2a17237b0578f405af31794ef1150ab0dfdfc",
    "@vite-hub/box": "https://pkg.pr.new/vite-hub/vitehub/@vite-hub/box@a4e2a17237b0578f405af31794ef1150ab0dfdfc",
    "@vite-hub/env": "https://pkg.pr.new/vite-hub/vitehub/@vite-hub/env@a4e2a17237b0578f405af31794ef1150ab0dfdfc",
    "@vite-hub/kv": "https://pkg.pr.new/vite-hub/vitehub/@vite-hub/kv@a4e2a17237b0578f405af31794ef1150ab0dfdfc",
    "@vite-hub/schedule": "https://pkg.pr.new/vite-hub/vitehub/@vite-hub/schedule@a4e2a17237b0578f405af31794ef1150ab0dfdfc",
    "@vite-hub/workspace": "https://pkg.pr.new/vite-hub/vitehub/@vite-hub/workspace@a4e2a17237b0578f405af31794ef1150ab0dfdfc",
    "ai": "7.0.0",
    "h3": "^2.0.1-rc.25",
    "nitro": "3.0.260429-beta",
    "vite": "^8.0.11"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "typescript": "^6.0.3"
  },
  "imports": {
    "#vitehub/env/public": {
      "types": "./.vitehub/env/public.d.ts",
      "default": "./.vitehub/env/public.mjs"
    },
    "#vitehub/env/server": {
      "types": "./.vitehub/env/server.d.ts",
      "default": "./.vitehub/env/server.mjs"
    }
  }
}
