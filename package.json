{
  "name": "vitehub-workspace",
  "private": true,
  "version": "0.0.1",
  "description": "ViteHub monorepo workspace.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "fallow:dead-code": "pnpm exec fallow dead-code --summary --format markdown --fail-on-issues",
    "lint": "pnpm exec oxlint . --ignore-path .gitignore",
    "typecheck": "pnpm --dir docs typecheck && pnpm -r --filter './packages/*' --if-present run typecheck",
    "test:contracts": "vitest run",
    "test": "pnpm -r --workspace-concurrency=1 --filter './packages/*' --if-present run test",
    "build": "pnpm -r --workspace-concurrency=1 --filter './packages/*' --if-present run build",
    "release": "pnpm dlx bumpp@11.1.0 package.json packages/*/package.json --commit \"chore(release): v%s\" --tag \"v%s\" --push --no-push-all --git-check",
    "playground:vite:build": "pnpm --dir playground/vite build",
    "playground:vite:build:cloudflare": "pnpm build && pnpm playground:vite:build --mode chat",
    "docs:dev": "pnpm --dir docs dev",
    "docs:build": "pnpm --dir docs build"
  },
  "devDependencies": {
    "@types/node": "catalog:tooling",
    "fallow": "catalog:tooling",
    "oxlint": "catalog:tooling",
    "typescript": "catalog:tooling",
    "vitest": "catalog:tooling"
  }
}
