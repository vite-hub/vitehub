    {
      "name": "core",
      "type": "registry:file",
      "title": "ViteHub core",
      "description": "vitehub.css: the ui-sdk stylesheet, the shadcn tokens mapped onto its --ui-* variables, the status colors, and the focus ring. Every component item imports it.",
      "css": {
        "@layer components": {
          ":where([data-slot])": {
            "box-sizing": "border-box"
          }
        }
      },
      "dependencies": [
        "@ui-sdk/core@0.1.0-beta.19"
      ],
