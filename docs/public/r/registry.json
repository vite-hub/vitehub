{
  "$schema": "https://shadcn-vue.com/schema/registry.json",
  "name": "vitehub",
  "homepage": "https://vitehub.dev",
  "items": [
    {
      "name": "vitehub",
      "type": "registry:style",
      "title": "ViteHub",
      "description": "The ViteHub look for @vite-hub/kit parts: the shadcn tokens with ViteHub values, light and dark, and the default style family. It installs no Reka UI.",
      "extends": "none",
      "files": [
        {
          "path": "src/styles/default.css",
          "type": "registry:file",
          "target": "styles/vitehub.css"
        }
      ]
    },
    {
      "name": "vitehub-ui-skill",
      "type": "registry:item",
      "title": "ViteHub UI agent skill",
      "description": "A skill that tells a coding agent how to use, style, and install ViteHub UI parts.",
      "dependencies": [
        "tw-animate-css"
      ],
      "files": [
        {
          "path": "registry/vitehub-ui/SKILL.md",
          "type": "registry:file",
          "target": "~/.agents/skills/vitehub-ui/SKILL.md"
        }
      ]
    },
    {
      "name": "utils",
      "type": "registry:lib",
      "title": "cn()",
      "description": "The cn() helper that every ViteHub UI item uses to join Vue class values and merge Tailwind classes.",
      "dependencies": [
        "tailwind-merge"
      ],
      "files": [
        {
          "path": "registry/lib/utils.ts",
          "type": "registry:lib"
        }
      ]
    },
    {
      "name": "theme",
      "type": "registry:theme",
      "title": "ViteHub theme",
      "description": "The ViteHub tokens as Tailwind theme variables, light and dark, with the ViteHub radius scale, the blue focus ring, and the base styles the UI items expect.",
      "dependencies": [
        "tw-animate-css"
      ],
      "cssVars": {
        "theme": {
          "radius-xs": "calc(var(--radius) * 0.5)",
          "radius-sm": "var(--radius)",
          "radius-md": "calc(var(--radius) * 1.5)",
          "radius-lg": "calc(var(--radius) * 2)",
          "radius-xl": "calc(var(--radius) * 3)",
          "radius-2xl": "calc(var(--radius) * 4)",
          "radius-3xl": "calc(var(--radius) * 6)",
          "radius-4xl": "calc(var(--radius) * 8)"
        }
      },
      "css": {
        "@layer base": {
          "body": {
            "font-family": "var(--font-sans)",
            "-webkit-font-smoothing": "antialiased",
            "-moz-osx-font-smoothing": "grayscale"
          },
          ":focus-visible": {
            "outline": "2px solid var(--ring)",
            "outline-offset": "2px"
          },
          ":where([role='menuitem'], [role='menuitemcheckbox'], [role='menuitemradio'], [role='option'], [role='tab'], tr, [data-focus-inset]):focus-visible": {
            "outline-offset": "-2px"
          },
          ":where(input, textarea, select, [tabindex='-1']):focus-visible": {
            "outline": "none"
          },
          "::selection": {
            "background-color": "color-mix(in oklab, var(--ring) 25%, transparent)"
          }
        }
      }
    },
