{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "app-shell",
  "type": "registry:block",
  "title": "App shell",
  "description": "An app layout: a sidebar of grouped links and a header that sticks to the top of the page.",
  "dependencies": [
    "@lucide/vue",
    "@ui-sdk/vue@0.1.0-beta.19"
  ],
  "registryDependencies": [
    "@vitehub/sidebar"
  ],
  "files": [
    {
      "path": "components/vitehub/app-shell/AppShell.vue",
      "type": "registry:component",
      "content": "<script setup lang=\"ts\">\nimport \"./app-shell.css\";\nimport { ChevronRight } from \"@lucide/vue\";\nimport { Collapsible, CollapsiblePanel, CollapsibleTrigger } from \"@ui-sdk/vue/collapsible\";\nimport { reactive } from \"vue\";\nimport {\n  Sidebar,\n  SidebarContent,\n  SidebarFooter,\n  SidebarGroup,\n  SidebarGroupLabel,\n  SidebarHeader,\n  SidebarInset,\n  SidebarMenu,\n  SidebarMenuBadge,\n  SidebarMenuButton,\n  SidebarMenuItem,\n  SidebarMenuSub,\n  SidebarMenuSubButton,\n  SidebarMenuSubItem,\n  SidebarProvider,\n  SidebarTrigger,\n} from \"../sidebar/index.ts\";\nimport type { AppShellEmits, AppShellItem, AppShellProps, AppShellSlots } from \"./types.ts\";\n\nconst { title, heading, groups, current, link, defaultCollapsed = false } = defineProps<AppShellProps>();\nconst collapsed = defineModel<boolean | undefined>(\"collapsed\", { default: undefined });\ndefineEmits<AppShellEmits>();\ndefineSlots<AppShellSlots>();\n\nconst openGroups = reactive(new WeakMap<AppShellItem, boolean>());\n\nfunction isCurrent(href?: string) {\n  return href !== undefined && href === current;\n}\n\nfunction hasCurrent(item: AppShellItem) {\n  return item.children?.some((child) => isCurrent(child.href)) ?? false;\n}\n\nfunction setGroupOpen(item: AppShellItem, open: boolean, isMobile: boolean) {\n  if (!isMobile && (collapsed.value ?? defaultCollapsed)) {\n    collapsed.value = false;\n    openGroups.set(item, true);\n    return;\n  }\n  openGroups.set(item, open);\n}\n\nfunction closeOnNavigation(event: MouseEvent, href: string | undefined, closeMobile: () => void) {\n  if (href === undefined || event.defaultPrevented || event.button !== 0 || event.altKey || event.ctrlKey || event.metaKey || event.shiftKey) return;\n  const target = event.currentTarget;\n  if (target instanceof HTMLAnchorElement && (target.hasAttribute(\"download\") || (target.target && target.target.toLowerCase() !== \"_self\"))) return;\n  closeMobile();\n}\n</script>\n\n<template>\n  <div data-slot=\"app-shell\">\n    <SidebarProvider v-slot=\"{ isMobile, closeMobile }\" v-model:collapsed=\"collapsed\" :default-collapsed=\"defaultCollapsed || undefined\">\n      <Sidebar>\n        <SidebarHeader>\n          <div data-slot=\"app-shell-brand\">\n            <slot name=\"logo\" />\n            <span data-slot=\"app-shell-title\">{{ title }}</span>\n          </div>\n        </SidebarHeader>\n        <SidebarContent>\n          <SidebarGroup v-for=\"(group, index) in groups\" :key=\"group.label ?? index\">\n            <SidebarGroupLabel v-if=\"group.label\" :label=\"group.label\" />\n            <SidebarMenu>\n              <SidebarMenuItem v-for=\"item in group.items\" :key=\"item.title\">\n                <Collapsible\n                  v-if=\"item.children\"\n                  :open=\"openGroups.get(item) ?? hasCurrent(item)\"\n                  @update:open=\"setGroupOpen(item, $event, isMobile)\"\n                >\n                  <template #render=\"{ props: part, children }\">\n                    <div v-bind=\"part\" data-slot=\"app-shell-group\"><component :is=\"children\" /></div>\n                  </template>\n                  <CollapsibleTrigger :title=\"item.title\">\n                    <template #render=\"{ props: part, children }\">\n                      <button v-bind=\"part\" data-slot=\"sidebar-menu-button\"><component :is=\"children\" /></button>\n                    </template>\n                    <component :is=\"item.icon\" v-if=\"item.icon\" aria-hidden=\"true\" />\n                    <span>{{ item.title }}</span>\n                    <ChevronRight data-slot=\"app-shell-chevron\" aria-hidden=\"true\" />\n                  </CollapsibleTrigger>\n                  <CollapsiblePanel>\n                    <template #render=\"{ props: part, children }\">\n                      <div v-bind=\"part\" data-slot=\"app-shell-group-panel\"><component :is=\"children\" /></div>\n                    </template>\n                    <SidebarMenuSub>\n                      <SidebarMenuSubItem v-for=\"child in item.children\" :key=\"child.href\">\n                        <SidebarMenuSubButton :href=\"child.href\" :is-active=\"isCurrent(child.href)\" @click.capture=\"isMobile && closeOnNavigation($event, child.href, closeMobile)\">\n                          <template v-if=\"link\" #render=\"{ props: row }\">\n                            <component :is=\"link\" v-bind=\"row\" :to=\"child.href\">\n                              <span>{{ child.title }}</span>\n                            </component>\n                          </template>\n                          <span>{{ child.title }}</span>\n                        </SidebarMenuSubButton>\n                      </SidebarMenuSubItem>\n                    </SidebarMenuSub>\n                  </CollapsiblePanel>\n                </Collapsible>\n                <template v-else>\n                  <SidebarMenuButton :href=\"item.href\" :is-active=\"isCurrent(item.href)\" :title=\"item.title\" @click.capture=\"isMobile && closeOnNavigation($event, item.href, closeMobile)\">\n                    <template v-if=\"link\" #render=\"{ props: row }\">\n                      <component :is=\"link\" v-bind=\"row\" :to=\"item.href\">\n                        <component :is=\"item.icon\" v-if=\"item.icon\" aria-hidden=\"true\" />\n                        <span>{{ item.title }}</span>\n                      </component>\n                    </template>\n                    <component :is=\"item.icon\" v-if=\"item.icon\" aria-hidden=\"true\" />\n                    <span>{{ item.title }}</span>\n                  </SidebarMenuButton>\n                  <SidebarMenuBadge v-if=\"item.badge !== undefined\">{{ item.badge }}</SidebarMenuBadge>\n                </template>\n              </SidebarMenuItem>\n            </SidebarMenu>\n          </SidebarGroup>\n        </SidebarContent>\n        <SidebarFooter v-if=\"$slots.footer\">\n          <slot name=\"footer\" />\n        </SidebarFooter>\n      </Sidebar>\n      <SidebarInset>\n        <header data-slot=\"app-shell-header\">\n          <SidebarTrigger />\n          <div data-slot=\"app-shell-divider\" aria-hidden=\"true\" />\n          <slot name=\"header\">\n            <h1 data-slot=\"app-shell-heading\">{{ heading }}</h1>\n          </slot>\n          <div data-slot=\"app-shell-actions\">\n            <slot name=\"actions\" />\n          </div>\n        </header>\n        <div data-slot=\"app-shell-body\">\n          <slot />\n        </div>\n      </SidebarInset>\n    </SidebarProvider>\n  </div>\n</template>\n"
    },
    {
      "path": "components/vitehub/app-shell/app-shell.css",
      "type": "registry:component",
      "content": "@layer components {\n  /* App shell: the sidebar and a 48px header that sticks to the top of the page. */\n  [data-slot=\"app-shell-brand\"] {\n    align-items: center;\n    display: flex;\n    gap: 0.5rem;\n    height: 2rem;\n    min-width: 0;\n    padding-inline: 0.5rem;\n  }\n\n  [data-slot=\"app-shell-title\"] {\n    font-size: 0.875rem;\n    font-weight: 600;\n    overflow: hidden;\n    text-overflow: ellipsis;\n    white-space: nowrap;\n  }\n\n  [data-slot=\"sidebar\"][data-collapsed][data-collapsible=\"icon\"] [data-slot=\"app-shell-title\"],\n  [data-slot=\"sidebar\"][data-collapsed][data-collapsible=\"icon\"] [data-slot=\"app-shell-chevron\"] {\n    display: none;\n  }\n\n  [data-slot=\"app-shell-chevron\"] {\n    color: var(--vh-muted);\n    margin-inline-start: auto;\n    transition: rotate 200ms ease-out;\n  }\n\n  [data-slot=\"app-shell-group\"][data-open] [data-slot=\"app-shell-chevron\"] {\n    rotate: 90deg;\n  }\n\n  [data-slot=\"app-shell-chevron\"]:is([dir=\"rtl\"] *) {\n    rotate: 180deg;\n  }\n\n  [data-slot=\"app-shell-group\"][data-open] [data-slot=\"app-shell-chevron\"]:is([dir=\"rtl\"] *) {\n    rotate: 90deg;\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    [data-slot=\"app-shell-chevron\"] {\n      transition: none;\n    }\n  }\n\n  [data-slot=\"app-shell-header\"] {\n    align-items: center;\n    background: var(--vh-bg);\n    border-bottom: 1px solid var(--vh-border);\n    display: flex;\n    flex: none;\n    gap: 0.5rem;\n    height: 3rem;\n    padding-inline: 0.75rem;\n    position: sticky;\n    top: 0;\n    z-index: 10;\n  }\n\n  [data-slot=\"app-shell-divider\"] {\n    background: var(--vh-border);\n    height: 1rem;\n    width: 1px;\n  }\n\n  [data-slot=\"app-shell-heading\"] {\n    font-size: 0.875rem;\n    font-weight: 500;\n    margin: 0;\n    min-width: 0;\n    overflow: hidden;\n    text-overflow: ellipsis;\n    white-space: nowrap;\n  }\n\n  [data-slot=\"app-shell-actions\"] {\n    align-items: center;\n    display: flex;\n    gap: 0.25rem;\n    margin-inline-start: auto;\n  }\n\n  [data-slot=\"app-shell-body\"] {\n    display: flex;\n    flex: 1;\n    flex-direction: column;\n    min-width: 0;\n    padding: 1rem;\n  }\n\n  @media (min-width: 768px) {\n    [data-slot=\"app-shell-body\"] {\n      padding: 1.5rem;\n    }\n  }\n}\n"
    },
    {
      "path": "components/vitehub/app-shell/index.ts",
      "type": "registry:component",
      "content": "export { default as AppShell } from \"./AppShell.vue\";\nexport type * from \"./types.ts\";\n"
    },
    {
      "path": "components/vitehub/app-shell/types.ts",
      "type": "registry:component",
      "content": "import type { Component } from \"vue\";\n\nexport interface AppShellLink {\n  title: string;\n  href: string;\n}\n\nexport interface AppShellItem {\n  title: string;\n  href?: string;\n  icon?: Component;\n  badge?: string | number;\n  children?: AppShellLink[];\n}\n\nexport interface AppShellGroup {\n  label?: string;\n  items: AppShellItem[];\n}\n\nexport interface AppShellProps {\n  title: string;\n  heading?: string;\n  groups: AppShellGroup[];\n  current?: string;\n  link?: Component;\n  collapsed?: boolean;\n  defaultCollapsed?: boolean;\n}\n\nexport interface AppShellEmits {\n  \"update:collapsed\": [collapsed: boolean];\n}\n\nexport interface AppShellSlots {\n  default?: () => unknown;\n  logo?: () => unknown;\n  header?: () => unknown;\n  actions?: () => unknown;\n  footer?: () => unknown;\n}\n"
    }
  ]
}
