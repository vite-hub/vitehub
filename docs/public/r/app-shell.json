{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "app-shell",
  "type": "registry:block",
  "title": "App shell",
  "description": "An app layout with a collapsible sidebar, sections that open and close, a top bar and the page.",
  "dependencies": [
    "@ui-sdk/vue@0.1.0-beta.14",
    "@ui-sdk/core@0.1.0-beta.14",
    "@lucide/vue"
  ],
  "registryDependencies": [
    "@vitehub/sidebar"
  ],
  "files": [
    {
      "path": "blocks/app-shell/AppShell.vue",
      "type": "registry:component",
      "content": "<script lang=\"ts\">\nimport type { Component } from \"vue\";\n\nexport interface AppShellLink {\n  title: string;\n  href: string;\n}\n\nexport interface AppShellItem extends Partial<AppShellLink> {\n  title: string;\n  icon?: Component;\n  badge?: string | number;\n  children?: AppShellLink[];\n}\n\nexport interface AppShellGroup {\n  label?: string;\n  items: AppShellItem[];\n}\n</script>\n\n<script setup lang=\"ts\">\nimport { reactive } from \"vue\";\nimport { ChevronRightIcon } from \"@lucide/vue\";\nimport { Collapsible, CollapsiblePanel, CollapsibleTrigger } from \"@ui-sdk/vue/collapsible\";\nimport {\n  Sidebar,\n  SidebarContent,\n  SidebarFooter,\n  SidebarGroup,\n  SidebarGroupLabel,\n  SidebarHeader,\n  SidebarInset,\n  SidebarMenu,\n  SidebarMenuBadge,\n  SidebarMenuButton,\n  SidebarMenuItem,\n  SidebarMenuSub,\n  SidebarMenuSubButton,\n  SidebarMenuSubItem,\n  SidebarProvider,\n  SidebarTrigger,\n  sidebarMenuButtonVariants,\n} from \"@/components/ui/sidebar\";\n\nconst props = withDefaults(\n  defineProps<{\n    title: string;\n    heading?: string;\n    groups: AppShellGroup[];\n    current?: string;\n    link?: string | Component;\n  }>(),\n  { link: \"a\" },\n);\nconst open = defineModel<boolean>(\"open\", { default: true });\nconst openGroups = reactive(new WeakMap<AppShellItem, boolean>());\n\nconst isCurrent = (href?: string) => href !== undefined && href === props.current;\nconst hasCurrent = (item: AppShellItem) => item.children?.some((child) => isCurrent(child.href)) ?? false;\n\nfunction setGroupOpen(item: AppShellItem, groupOpen: boolean, isMobile: boolean) {\n  if (!isMobile && !open.value) {\n    open.value = true;\n    openGroups.set(item, true);\n    return;\n  }\n  openGroups.set(item, groupOpen);\n}\n\nfunction closeOnNavigation(event: MouseEvent, href: string | undefined, closeMobile: () => void) {\n  if (href === undefined || event.defaultPrevented || event.button !== 0 || event.altKey || event.ctrlKey || event.metaKey || event.shiftKey) return;\n  const link = event.currentTarget;\n  if (link instanceof HTMLAnchorElement && (link.hasAttribute(\"download\") || (link.target && link.target.toLowerCase() !== \"_self\"))) return;\n  closeMobile();\n}\n</script>\n\n<template>\n  <SidebarProvider v-slot=\"{ isMobile, closeMobile }\" v-model:open=\"open\">\n    <Sidebar>\n      <SidebarHeader>\n        <div class=\"flex h-8 min-w-0 items-center gap-2 px-2\">\n          <slot name=\"logo\" />\n          <span class=\"truncate text-sm font-semibold group-data-[collapsible=icon]:hidden\">{{ props.title }}</span>\n        </div>\n      </SidebarHeader>\n      <SidebarContent>\n        <SidebarGroup v-for=\"(group, index) in props.groups\" :key=\"group.label ?? index\">\n          <SidebarGroupLabel v-if=\"group.label\">{{ group.label }}</SidebarGroupLabel>\n          <SidebarMenu>\n            <SidebarMenuItem v-for=\"item in group.items\" :key=\"item.title\">\n              <Collapsible\n                v-if=\"item.children\"\n                class=\"group/collapsible\"\n                :open=\"openGroups.get(item) ?? hasCurrent(item)\"\n                @update:open=\"setGroupOpen(item, $event, isMobile)\"\n              >\n                <CollapsibleTrigger :class=\"sidebarMenuButtonVariants()\" data-focus-inset=\"\">\n                  <component :is=\"item.icon\" v-if=\"item.icon\" aria-hidden=\"true\" />\n                  <span>{{ item.title }}</span>\n                  <ChevronRightIcon\n                    aria-hidden=\"true\"\n                    class=\"ms-auto text-muted-foreground transition-transform duration-200 ease-out group-data-open/collapsible:rotate-90 group-data-[collapsible=icon]:hidden motion-reduce:transition-none rtl:rotate-180\"\n                  />\n                </CollapsibleTrigger>\n                <CollapsiblePanel>\n                  <SidebarMenuSub>\n                    <SidebarMenuSubItem v-for=\"child in item.children\" :key=\"child.href\">\n                      <SidebarMenuSubButton :as=\"props.link\" :href=\"child.href\" :is-active=\"isCurrent(child.href)\" @click.capture=\"isMobile && closeOnNavigation($event, child.href, closeMobile)\">\n                        <span>{{ child.title }}</span>\n                      </SidebarMenuSubButton>\n                    </SidebarMenuSubItem>\n                  </SidebarMenuSub>\n                </CollapsiblePanel>\n              </Collapsible>\n              <template v-else>\n                <SidebarMenuButton :as=\"props.link\" :href=\"item.href\" :is-active=\"isCurrent(item.href)\" :title=\"item.title\" @click.capture=\"isMobile && closeOnNavigation($event, item.href, closeMobile)\">\n                  <component :is=\"item.icon\" v-if=\"item.icon\" aria-hidden=\"true\" />\n                  <span>{{ item.title }}</span>\n                </SidebarMenuButton>\n                <SidebarMenuBadge v-if=\"item.badge !== undefined\">{{ item.badge }}</SidebarMenuBadge>\n              </template>\n            </SidebarMenuItem>\n          </SidebarMenu>\n        </SidebarGroup>\n      </SidebarContent>\n      <SidebarFooter v-if=\"$slots.footer\">\n        <slot name=\"footer\" />\n      </SidebarFooter>\n    </Sidebar>\n    <SidebarInset>\n      <header class=\"sticky top-0 z-10 flex h-12 shrink-0 items-center gap-2 border-b bg-background px-3\">\n        <SidebarTrigger />\n        <div class=\"h-4 w-px bg-border\" aria-hidden=\"true\" />\n        <slot name=\"header\">\n          <h1 class=\"m-0 min-w-0 truncate text-sm font-medium\">{{ props.heading }}</h1>\n        </slot>\n        <div class=\"ms-auto flex items-center gap-1\">\n          <slot name=\"actions\" />\n        </div>\n      </header>\n      <div class=\"flex min-w-0 flex-1 flex-col p-4 md:p-6\">\n        <slot />\n      </div>\n    </SidebarInset>\n  </SidebarProvider>\n</template>\n"
    }
  ]
}
