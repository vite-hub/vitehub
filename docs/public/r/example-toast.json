{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "example-toast",
  "type": "registry:block",
  "title": "Toast example",
  "description": "A button that shows a toast with a description and an action.",
  "registryDependencies": [
    "@vitehub/button",
    "@vitehub/toast"
  ],
  "files": [
    {
      "path": "components/vitehub/example-toast/ToastExample.vue",
      "type": "registry:component",
      "content": "<script setup lang=\"ts\">\nimport { Toaster, toast } from \"../toast/index.ts\";\nimport { Button } from \"../button/index.ts\";\n\nfunction show() {\n  toast(\"Deployed\", { description: \"app.example.com is live.\", action: { label: \"Open\", onAction: () => {} } });\n}\n</script>\n\n<template>\n  <div data-slot=\"example-toast\" style=\"display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem\">\n    <Button label=\"Show a toast\" @click=\"show\" />\n    <Toaster />\n  </div>\n</template>\n"
    }
  ]
}
