{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "theme",
  "type": "registry:theme",
  "title": "ViteHub theme",
  "description": "The ViteHub tokens as Tailwind theme variables, light and dark, with the ViteHub radius scale, the blue focus ring, and the base styles the UI items expect.",
  "dependencies": [
    "tw-animate-css"
  ],
  "cssVars": {
    "theme": {
      "font-sans": "\"Geist Variable\", \"Geist\", ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif",
      "font-mono": "\"Geist Mono Variable\", \"Geist Mono\", ui-monospace, \"SF Mono\", Menlo, monospace",
      "radius-xs": "calc(var(--radius) * 0.5)",
      "radius-sm": "var(--radius)",
      "radius-md": "calc(var(--radius) * 1.5)",
      "radius-lg": "calc(var(--radius) * 2)",
      "radius-xl": "calc(var(--radius) * 3)",
      "radius-2xl": "calc(var(--radius) * 4)",
      "radius-3xl": "calc(var(--radius) * 6)",
      "radius-4xl": "calc(var(--radius) * 8)"
    },
    "light": {
      "radius": "0.25rem",
      "background": "oklch(1 0 0)",
      "foreground": "oklch(0.205 0 0)",
      "card": "oklch(1 0 0)",
      "card-foreground": "oklch(0.205 0 0)",
      "popover": "rgb(255 255 255 / 92%)",
      "popover-foreground": "oklch(0.205 0 0)",
      "primary": "oklch(0.205 0 0)",
      "primary-foreground": "oklch(0.985 0 0)",
      "secondary": "oklch(0.97 0 0)",
      "secondary-foreground": "oklch(0.205 0 0)",
      "muted": "oklch(0.97 0 0)",
      "muted-foreground": "oklch(0.5 0 0)",
      "accent": "oklch(0.97 0 0)",
      "accent-foreground": "oklch(0.205 0 0)",
      "destructive": "oklch(0.577 0.245 27.325)",
      "border": "oklch(0.922 0 0)",
      "input": "oklch(0.87 0 0)",
      "ring": "oklch(0.588 0.158 241.966)",
      "chart-1": "oklch(0.646 0.222 41.116)",
      "chart-2": "oklch(0.6 0.118 184.704)",
      "chart-3": "oklch(0.398 0.07 227.392)",
      "chart-4": "oklch(0.828 0.189 84.429)",
      "chart-5": "oklch(0.769 0.188 70.08)",
      "sidebar": "oklch(0.985 0 0)",
      "sidebar-foreground": "oklch(0.205 0 0)",
      "sidebar-primary": "oklch(0.205 0 0)",
      "sidebar-primary-foreground": "oklch(0.985 0 0)",
      "sidebar-accent": "oklch(0.97 0 0)",
      "sidebar-accent-foreground": "oklch(0.205 0 0)",
      "sidebar-border": "oklch(0.922 0 0)",
      "sidebar-ring": "oklch(0.588 0.158 241.966)",
      "ui-text": "oklch(0.371 0 0)",
      "ui-text-toned": "oklch(0.439 0 0)",
      "ui-text-dimmed": "oklch(0.52 0 0)",
      "ui-bg-muted": "oklch(0.985 0 0)",
      "ui-bg-accented": "oklch(0.94 0 0)",
      "ui-border-muted": "oklch(0.96 0 0)",
      "ui-border-accented": "oklch(0.87 0 0)",
      "ui-error": "oklch(0.637 0.237 25.331)",
      "ui-warning": "oklch(0.769 0.188 70.08)",
      "ui-success": "oklch(0.696 0.17 162.48)",
      "ui-info": "oklch(0.685 0.169 237.323)",
      "vh-text-error": "oklch(0.505 0.213 27.518)",
      "vh-text-warning": "oklch(0.473 0.137 46.201)",
      "vh-text-success": "oklch(0.508 0.118 165.612)",
      "vh-text-info": "oklch(0.5 0.134 242.749)",
      "shadow-popover": "0 0 0 1px var(--border), 0 4px 8px -4px rgb(0 0 0 / 4%), 0 16px 24px -8px rgb(0 0 0 / 6%)",
      "shadow-dialog": "0 0 0 1px var(--border), 0 8px 16px -4px rgb(0 0 0 / 4%), 0 24px 32px -8px rgb(0 0 0 / 6%)",
      "overlay": "oklch(0 0 0 / 25%)",
      "on-media": "oklch(1 0 0)",
      "media-edge": "oklch(0 0 0 / 40%)",
      "media-scrim": "rgb(0 0 0 / 50%)",
      "media-backdrop": "oklch(0.145 0 0)",
      "media-outline": "oklch(0 0 0 / 10%)"
    },
    "dark": {
      "background": "oklch(0.145 0 0)",
      "foreground": "oklch(0.985 0 0)",
      "card": "oklch(0.145 0 0)",
      "card-foreground": "oklch(0.985 0 0)",
      "popover": "rgb(23 23 23 / 92%)",
      "popover-foreground": "oklch(0.985 0 0)",
      "primary": "oklch(0.985 0 0)",
      "primary-foreground": "oklch(0.205 0 0)",
      "secondary": "oklch(1 0 0 / 8%)",
      "secondary-foreground": "oklch(0.985 0 0)",
      "muted": "rgb(255 255 255 / 5%)",
      "muted-foreground": "oklch(0.708 0 0)",
      "accent": "oklch(1 0 0 / 8%)",
      "accent-foreground": "oklch(0.985 0 0)",
      "destructive": "oklch(0.704 0.191 22.216)",
      "border": "rgb(255 255 255 / 10%)",
      "input": "oklch(1 0 0 / 16%)",
      "ring": "oklch(0.746 0.16 232.661)",
      "chart-1": "oklch(0.488 0.243 264.376)",
      "chart-2": "oklch(0.696 0.17 162.48)",
      "chart-3": "oklch(0.769 0.188 70.08)",
      "chart-4": "oklch(0.627 0.265 303.9)",
      "chart-5": "oklch(0.645 0.246 16.439)",
      "sidebar": "oklch(0.145 0 0)",
      "sidebar-foreground": "oklch(0.985 0 0)",
      "sidebar-primary": "oklch(0.985 0 0)",
      "sidebar-primary-foreground": "oklch(0.205 0 0)",
      "sidebar-accent": "oklch(1 0 0 / 8%)",
      "sidebar-accent-foreground": "oklch(0.985 0 0)",
      "sidebar-border": "oklch(1 0 0 / 10%)",
      "sidebar-ring": "oklch(0.746 0.16 232.661)",
      "ui-text": "oklch(0.87 0 0)",
      "ui-text-toned": "oklch(0.8 0 0)",
      "ui-text-dimmed": "oklch(0.62 0 0)",
      "ui-bg-muted": "oklch(0.178 0 0)",
      "ui-bg-accented": "rgb(255 255 255 / 8%)",
      "ui-border-muted": "rgb(255 255 255 / 5%)",
      "ui-border-accented": "rgb(255 255 255 / 16%)",
      "ui-error": "oklch(0.704 0.191 22.216)",
      "ui-warning": "oklch(0.828 0.189 84.429)",
      "ui-success": "oklch(0.765 0.177 163.223)",
      "ui-info": "oklch(0.746 0.16 232.661)",
      "vh-text-error": "oklch(0.704 0.191 22.216)",
      "vh-text-warning": "oklch(0.828 0.189 84.429)",
      "vh-text-success": "oklch(0.765 0.177 163.223)",
      "vh-text-info": "oklch(0.746 0.16 232.661)",
      "shadow-popover": "0 0 0 1px var(--border), 0 4px 8px -4px rgb(0 0 0 / 24%), 0 16px 24px -8px rgb(0 0 0 / 32%)",
      "shadow-dialog": "0 0 0 1px var(--border), 0 8px 16px -4px rgb(0 0 0 / 24%), 0 24px 32px -8px rgb(0 0 0 / 32%)",
      "overlay": "oklch(0 0 0 / 60%)",
      "media-outline": "oklch(1 0 0 / 10%)"
    }
  },
  "css": {
    "@layer base": {
      "body": {
        "font-family": "var(--font-sans)",
        "-webkit-font-smoothing": "antialiased",
        "-moz-osx-font-smoothing": "grayscale"
      },
      ":focus-visible": {
        "outline": "2px solid var(--ring)",
        "outline-offset": "2px"
      },
      ":where([role='menuitem'], [role='menuitemcheckbox'], [role='menuitemradio'], [role='option'], [role='tab'], tr, [data-focus-inset]):focus-visible": {
        "outline-offset": "-2px"
      },
      ":where(input, textarea, select, [tabindex='-1']):focus-visible": {
        "outline": "none"
      },
      "::selection": {
        "background-color": "color-mix(in oklab, var(--ring) 25%, transparent)"
      }
    }
  }
}
