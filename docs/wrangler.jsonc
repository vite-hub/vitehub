{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "vitehub-docs",
  "main": ".output/server/index.mjs",
  "compatibility_date": "2026-07-19",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": ".output/public"
  },
  "d1_databases": [
    {
      // Wrangler creates or reuses vitehub-docs-DB on the first deployment.
      "binding": "DB"
    }
  ],
  "routes": [
    {
      "pattern": "vitehub.dev",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  }
}
