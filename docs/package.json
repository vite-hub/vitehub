{
  "name": "vitehub-docs",
  "private": true,
  "description": "Server primitives for Vite.",
  "type": "module",
  "imports": {
    "#vitehub-docs-manifest": "./.generated/docs-manifest.mjs"
  },
  "scripts": {
    "clean": "rm -rf .nuxt .output node_modules/.cache .generated",
    "postinstall": "vp run -t @vite-hub/ui#build && nuxi prepare",
    "pretest": "nuxi prepare",
    "dev": "nuxi dev",
    "build": "NODE_OPTIONS='--max-old-space-size=8192' nuxi build",
    "deploy:cloudflare": "test -n \"$CLOUDFLARE_D1_DATABASE_ID\" && vp run test && vp run build && vp dlx \"wrangler@4.112.0\" deploy --config .output/server/wrangler.json",
    "test": "vp test",
    "typecheck": "nuxi prepare && node scripts/typecheck.mjs",
    "generate": "NODE_OPTIONS='--max-old-space-size=8192' nuxi generate",
    "preview": "nuxi preview",
    "preview:cloudflare": "vp run build && vp dlx \"wrangler@4.112.0\" dev --config .output/server/wrangler.json"
  },
  "dependencies": {
    "@nuxt/content": "catalog:nuxt",
    "@nuxt/ui": "catalog:nuxt",
    "@vite-hub/ui": "workspace:*",
    "@vueuse/core": "catalog:ui",
    "ai": "catalog:ai",
    "agents": "catalog:ai",
    "docus": "catalog:nuxt",
    "h3": "catalog:h3-v1-compat",
    "motion-v": "catalog:ui",
    "nuxt": "catalog:nuxt",
    "nuxt-schema-org": "catalog:nuxt"
  },
  "devDependencies": {
    "@iconify-json/lucide": "catalog:ui",
    "@iconify-json/ph": "catalog:ui",
    "@iconify-json/simple-icons": "catalog:ui",
    "@iconify-json/vscode-icons": "catalog:ui",
    "valibot": "catalog:runtime",
    "vite-plus": "catalog:tooling",
    "vitest": "catalog:tooling",
    "vue-tsc": "catalog:tooling"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
