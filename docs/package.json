{
  "name": "vitehub-docs",
  "private": true,
  "description": "Server primitives for Vite.",
  "type": "module",
  "scripts": {
    "clean": "rm -rf .nuxt .output node_modules/.cache",
    "postinstall": "node scripts/postinstall.mjs",
    "pretest": "vp run --cache -t vite-hub#build && nuxi prepare",
    "dev": "nuxi dev",
    "build": "NODE_OPTIONS=--max-old-space-size=8192 nuxi build",
    "deploy:cloudflare": "vp run test && vp run build && wrangler deploy --config .output/server/wrangler.json",
    "test": "vp run --cache -t vite-hub#build && vp test --exclude test/artifact.test.ts",
    "test:links": "vp run build",
    "test:snippets": "node scripts/check-snippets.mjs",
    "test:links:external": "node scripts/check-example-links.mjs",
    "test:artifact": "vp test --config vitest.artifact.config.ts",
    "eval:agent-docs": "node evals/agent-docs/run.mjs",
    "typecheck": "nuxi prepare && node scripts/typecheck.mjs",
    "generate": "NODE_OPTIONS='--max-old-space-size=8192' nuxi generate",
    "preview": "nuxi preview",
    "preview:cloudflare": "vp run build && wrangler dev --config .output/server/wrangler.json"
  },
  "dependencies": {
    "@comark/html": "catalog:markdown-ui",
    "@comark/vue": "0.9.0",
    "@nuxt/icon": "^2.5.1",
    "@nuxt/ui": "catalog:nuxt",
    "@vite-hub/agent": "workspace:*",
    "@vite-hub/auth": "workspace:*",
    "@vite-hub/comments": "workspace:*",
    "@vite-hub/database": "workspace:*",
    "@vite-hub/docs": "workspace:*",
    "@vite-hub/internal": "workspace:*",
    "@vite-hub/ui": "workspace:*",
    "@vite-hub/web-container": "workspace:*",
    "@vueuse/core": "catalog:ui",
    "agents": "catalog:ai",
    "ai": "catalog:ai",
    "better-auth": "catalog:auth",
    "comark": "catalog:markdown-ui",
    "comark-ui": "catalog:markdown-ui",
    "drizzle-orm": "catalog:database",
    "h3": "catalog:unjs",
    "nuxt": "catalog:nuxt",
    "nuxt-schema-org": "catalog:nuxt",
    "shiki": "^4.5.0",
    "vite-hub": "workspace:*",
    "yaml": "catalog:tooling"
  },
  "devDependencies": {
    "@better-auth/cimd": "catalog:auth",
    "@chat-adapter/slack": "catalog:chat",
    "@iconify-json/lucide": "catalog:ui",
    "@iconify-json/simple-icons": "catalog:ui",
    "@iconify-json/vscode-icons": "catalog:ui",
    "@takumi-rs/core": "catalog:nuxt",
    "@types/node": "catalog:tooling",
    "drizzle-kit": "catalog:database",
    "playwright-core": "catalog:browser",
    "typescript": "catalog:tooling",
    "valibot": "catalog:runtime",
    "vite-plus": "catalog:tooling",
    "vitest": "catalog:tooling",
    "vue-tsc": "catalog:tooling",
    "wrangler": "catalog:"
  },
  "engines": {
    "node": "^22.22.0 || ^24.11.0 || >=26.0.0"
  }
}
