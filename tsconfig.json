{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "resolveJsonModule": true,
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@vitehub/agent": ["packages/agent/src/index.ts"],
      "@vitehub/agent/*": ["packages/agent/src/*"],
      "@vitehub/blob": ["packages/blob/src/index.ts"],
      "@vitehub/blob/*": ["packages/blob/src/*"],
      "@vitehub/chat": ["packages/chat/src/index.ts"],
      "@vitehub/chat/*": ["packages/chat/src/*"],
      "@vitehub/db": ["packages/db/src/index.ts"],
      "@vitehub/db/*": ["packages/db/src/*"],
      "@vitehub/devtools": ["packages/devtools/src/index.ts"],
      "@vitehub/devtools/*": ["packages/devtools/src/*"],
      "@vitehub/env": ["packages/env/src/index.ts"],
      "@vitehub/env/*": ["packages/env/src/*"],
      "@vitehub/internal": ["packages/internal/src/index.ts"],
      "@vitehub/internal/*": ["packages/internal/src/*"],
      "@vitehub/kv": ["packages/kv/src/index.ts"],
      "@vitehub/kv/*": ["packages/kv/src/*"],
      "@vitehub/messages": ["packages/messages/src/index.ts"],
      "@vitehub/messages/*": ["packages/messages/src/*"],
      "@vitehub/queue": ["packages/queue/src/index.ts"],
      "@vitehub/queue/*": ["packages/queue/src/*"],
      "@vitehub/runtime": ["packages/runtime/src/index.ts"],
      "@vitehub/runtime/*": ["packages/runtime/src/*"],
      "@vitehub/sandbox": ["packages/sandbox/src/index.ts"],
      "@vitehub/sandbox/*": ["packages/sandbox/src/*"],
      "@vitehub/shell": ["packages/shell/src/index.ts"],
      "@vitehub/shell/*": ["packages/shell/src/*"],
      "@vitehub/unshell": ["packages/unshell/src/index.ts"],
      "@vitehub/unshell/*": ["packages/unshell/src/*"],
      "@vitehub/unsource": ["packages/unsource/src/index.ts"],
      "@vitehub/unsource/*": ["packages/unsource/src/*"],
      "@vitehub/workflow": ["packages/workflow/src/index.ts"],
      "@vitehub/workflow/*": ["packages/workflow/src/*"],
      "@vitehub/workspace": ["packages/workspace/src/index.ts"],
      "@vitehub/workspace/*": ["packages/workspace/src/*"]
    }
  },
  "files": [],
  "exclude": [
    "node_modules",
    "dist",
    "coverage",
    ".nuxt",
    ".output",
    ".data",
    "packages/*/dist",
    "docs/.nuxt",
    "docs/.output",
    "docs/.data"
  ]
}
